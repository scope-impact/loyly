-- First regeneration from a specification cut that has no accepted oracle.
-- It produces an ungraded candidate, never an independently measured result.

enum FirstRegenerationStatus { requested | running | candidate_produced | failed }
enum CandidateDisposition { ungraded }

entity SpecificationCutWithoutOracle {
    identity: String
    source_commit: String
    tree_digest: String
}

entity FirstRegeneration {
    identity: String
    cut: SpecificationCutWithoutOracle
    selection_identity: String
    selection_digest: String
    approved_items: List<String>
    workspace_scope: List<String>
    status: FirstRegenerationStatus
    failure_reason: String?
}

entity FirstRegenerationCandidate {
    regeneration: FirstRegeneration
    builder_session_identity: String
    subject_digest: String
    generated_paths: List<String>
    tool_calls: Integer
    disposition: CandidateDisposition
}

rule StartFirstRegeneration {
    when: ApprovedFirstRegenerationRequested(regeneration)
    requires: regeneration.status = requested
    requires: regeneration.cut.source_commit != ""
    requires: regeneration.cut.tree_digest != ""
    requires: regeneration.selection_identity != ""
    requires: regeneration.selection_digest != ""
    requires: regeneration.approved_items.count > 0
    requires: regeneration.workspace_scope.count > 0
    requires: selection_is_approved_and_matches_digest(regeneration)
    ensures: regeneration.status = running
}

rule RecordFirstRegenerationCandidate {
    when: FreshFirstBuilderCompleted(regeneration, session, subject_digest,
                                     generated_paths, tool_calls)
    requires: regeneration.status = running
    requires: session != ""
    requires: subject_digest != ""
    requires: generated_paths.count > 0
    requires: tool_calls > 0
    requires: all_paths_within_scope(generated_paths, regeneration.workspace_scope)
    ensures: FirstRegenerationCandidate.created(
        regeneration: regeneration,
        builder_session_identity: session,
        subject_digest: subject_digest,
        generated_paths: generated_paths,
        tool_calls: tool_calls,
        disposition: ungraded
    )
    ensures: regeneration.status = candidate_produced
}

rule FailEmptyFirstRegeneration {
    when: FirstBuilderFailed(regeneration, reason)
    requires: regeneration.status = running
    requires: reason != ""
    ensures: regeneration.status = failed
    ensures: regeneration.failure_reason = reason
}

rule RefuseFirstRegenerationPass {
    when: FirstRegenerationPassRequested(regeneration)
    requires: regeneration.status = candidate_produced
    ensures: FirstRegenerationPassRefused(regeneration)
}

invariant FirstCandidateHasNoIndependentVerdicts {
    for candidate in FirstRegenerationCandidates:
        candidate.disposition = ungraded and
        not exists IndependentItemVerdicts where regeneration = candidate.regeneration and
        not exists InstrumentConformanceEvaluation where regeneration = candidate.regeneration
}

invariant FirstCandidateRetainsProvenance {
    for candidate in FirstRegenerationCandidates:
        candidate.regeneration.cut.tree_digest != "" and
        candidate.regeneration.selection_digest != "" and
        candidate.builder_session_identity != "" and
        candidate.subject_digest != ""
}

invariant FailedFirstRegenerationHasNoCandidate {
    for regeneration in FirstRegenerations:
        regeneration.status = failed implies
            not exists FirstRegenerationCandidates where regeneration = regeneration
}

surface FirstRegenerationWorkflow {
    provides:
        ApprovedFirstRegenerationRequested(regeneration)
        FreshFirstBuilderCompleted(regeneration, session, subject_digest, generated_paths, tool_calls)
        FirstBuilderFailed(regeneration, reason)
        FirstRegenerationPassRequested(regeneration)

    @guarantee CandidateWithoutOracle
        -- An approved specification cut without product or instrument oracles can produce
        -- an explicitly ungraded candidate.

    @guarantee NoFalsePass
        -- Only a later oracle-backed measured cycle can record independent grading or pass.
}
