-- allium: 3
-- Fresh Slice Generation captures a complete independent first grade, proposes its normalized
-- evidence as the first product oracle, and waits for exact operator approval before promotion.

enum FreshSliceGenerationStatus {
    requested | running | awaiting_oracle_approval | oracle_promoted | failed
}

enum CandidateDisposition { baseline_measured | oracle_measured }
enum ApprovedSliceOperation { fresh_generation | measured_regeneration }
enum OracleProposalStatus { proposed | approved | published | rejected }

entity ApprovedSliceRoute {
    request_identity: String
    request_digest: String
    project_identity: String
    container_identity: String
    component_identity: String
    selection_identity: String
    operation: ApprovedSliceOperation
    parent_candidate_identity: String?
    parent_candidate_root: String?
    parent_candidate_digest: String?
}

entity SourceCut {
    identity: String
    source_commit: String
    tree_digest: String
}

entity HarnessSnapshot {
    identity: String
    harness_revision: String
    manifest_digest: String
    runtime_asset_digests: List<String>
    calibration_digest: String
    sealed: Boolean
    calibrated: Boolean
}

entity FreshSliceGeneration {
    identity: String
    project_identity: String
    container_identity: String
    component_identity: String
    operation: ApprovedSliceOperation
    source_cut: SourceCut
    harness_snapshot: HarnessSnapshot
    selection_identity: String
    selection_digest: String
    approved_items: List<String>
    workspace_scope: List<String>
    status: FreshSliceGenerationStatus
    failure_reason: String?
}

entity ItemVerdict {
    item_identity: String
    verdict: String
    evidence_digest: String
}

entity FreshCycleGrade {
    generation: FreshSliceGeneration
    cycle_oracle_binding_digest: String
    subject_digest: String
    judge_identity: String
    item_verdicts: List<ItemVerdict>
    normalized_evidence_digest: String
    instrument_conformance_passed: Boolean
    complete: Boolean
    passed: Boolean
}

entity SealedCycleOracle {
    generation: FreshSliceGeneration
    binding_digest: String
    harness_snapshot_digest: String
    author_session_identity: String
    selected_items: List<String>
    evaluator_kinds: List<String>
    candidate_blind: Boolean
    carried_calibration_passed: Boolean
    uncarried_calibration_passed: Boolean
}

rule BuildCalibrateAndSealCycleOracle {
    when: FreshSliceGenerationVerificationPassed(generation)
    requires: generation.status = running
    requires: generation.harness_snapshot.sealed
    requires: generation.harness_snapshot.calibrated
    requires: oracle_author_can_read_only_approved_cut_and_public_calibration_protocol(generation)
    requires: oracle_author_cannot_read_candidate_or_evaluation_material(generation)
    requires: cycle_oracle_contains_only_applicable_behavior_affordance_and_runtime_evaluators(generation)
    requires: cycle_oracle_passes_carried_and_uncarried_calibration(generation)
    ensures: SealedCycleOracle.created(
        generation: generation,
        binding_digest: digest_cycle_oracle_binding(generation),
        harness_snapshot_digest: generation.harness_snapshot.manifest_digest,
        author_session_identity: independent_oracle_author_session(generation),
        selected_items: generation.approved_items,
        evaluator_kinds: applicable_evaluator_kinds(generation),
        candidate_blind: true,
        carried_calibration_passed: true,
        uncarried_calibration_passed: true
    )
}

entity ProductOracleProposal {
    identity: String
    generation: FreshSliceGeneration
    selection_identity: String
    selection_digest: String
    scenario_digests: List<String>
    subject_digest: String
    judge_identity: String
    denominator: Integer
    normalized_evidence_digest: String
    proposal_digest: String
    status: OracleProposalStatus
}

entity AcceptedProductOracle {
    proposal: ProductOracleProposal
    descriptor_digest: String
    approved_by: String
    published_at: String
}

entity ComponentCandidate {
    identity: String
    output_root: String
    subject_digest: String
    project_identity: String
    container_identity: String
    component_identity: String
    operation: ApprovedSliceOperation
    parent_candidate_identity: String?
    disposition: CandidateDisposition
    oracle_descriptor_digest: String
}

entity GeneratedCandidate {
    generation: FreshSliceGeneration
    builder_session_identity: String
    subject_digest: String
    output_root: String
    disposition: CandidateDisposition
    oracle_descriptor_digest: String
}

rule RouteApprovedSliceToFreshSliceGeneration {
    when: ApprovedSliceSubmitted(request)
    requires: selection_is_approved_and_matches_digest(request)
    requires: request.operation = fresh_generation
    requires: request.parent_candidate_identity = null
    ensures: ApprovedSliceRoute.created(
        request_identity: request.identity,
        request_digest: request.digest,
        project_identity: request.project_identity,
        container_identity: request.container_identity,
        component_identity: request.component_identity,
        selection_identity: request.selection_identity,
        operation: fresh_generation,
        parent_candidate_identity: null,
        parent_candidate_root: null,
        parent_candidate_digest: null
    )
    ensures: FreshSliceGenerationRequested(request)
}

rule StartFreshSliceGeneration {
    when: ApprovedFreshSliceGenerationRequested(generation)
    requires: generation.status = requested
    requires: generation.operation = fresh_generation
    requires: generation.source_cut.source_commit != ""
    requires: generation.source_cut.tree_digest != ""
    requires: generation.selection_identity != ""
    requires: generation.selection_digest != ""
    requires: generation.approved_items.count > 0
    requires: generation.workspace_scope.count > 0
    requires: selection_is_approved_and_matches_digest(generation)
    requires: source_cut_excludes_prior_implementation_and_measurements(generation.source_cut)
    requires: generation.harness_snapshot.harness_revision != ""
    requires: generation.harness_snapshot.manifest_digest != ""
    requires: generation.harness_snapshot.sealed
    requires: generation.harness_snapshot.calibrated
    ensures: generation.status = running
}

rule ProposeOracleFromSuccessfulGrade {
    when: FreshSliceGenerationGradeCompleted(generation, grade, scenario_digests)
    requires: generation.status = running
    requires: grade.generation = generation
    requires: grade.cycle_oracle_binding_digest =
              sealed_cycle_oracle_for(generation).binding_digest
    requires: grade.subject_digest != ""
    requires: grade.judge_identity != ""
    requires: grade.complete
    requires: grade.passed
    requires: grade.instrument_conformance_passed
    requires: grade.item_verdicts.count = generation.approved_items.count
    requires: every_approved_item_has_one_pass_with_evidence(
        generation.approved_items, grade.item_verdicts)
    requires: grade.normalized_evidence_digest != ""
    ensures: ProductOracleProposal.created(
        identity: oracle_proposal_identity(generation, grade.normalized_evidence_digest),
        generation: generation,
        selection_identity: generation.selection_identity,
        selection_digest: generation.selection_digest,
        scenario_digests: scenario_digests,
        subject_digest: grade.subject_digest,
        judge_identity: grade.judge_identity,
        denominator: generation.approved_items.count,
        normalized_evidence_digest: grade.normalized_evidence_digest,
        proposal_digest: digest_oracle_proposal(generation, grade, scenario_digests),
        status: proposed
    )
    ensures: generation.status = awaiting_oracle_approval
}

rule ApproveExactOracleProposal {
    when: OperatorApprovesOracleProposal(operator, proposal, supplied_digest)
    requires: proposal.status = proposed
    requires: supplied_digest = proposal.proposal_digest
    requires: operator != ""
    ensures: proposal.status = approved
    ensures: PublishProductOracleRequested(proposal, operator)
}

rule RefuseStaleOracleProposalApproval {
    when: OperatorApprovesOracleProposal(operator, proposal, supplied_digest)
    requires: supplied_digest != proposal.proposal_digest
    ensures: OracleProposalApprovalRefused(proposal, supplied_digest)
    ensures: proposal.status = proposed
}

rule RecordPublishedOracleAndCandidate {
    when: ProductOraclePublished(proposal, descriptor_digest, approved_by, published_at,
                                 session, output_root)
    requires: proposal.status = approved
    requires: descriptor_digest != ""
    requires: approved_by != ""
    requires: published_at != ""
    requires: session != ""
    requires: output_root != ""
    ensures: AcceptedProductOracle.created(
        proposal: proposal,
        descriptor_digest: descriptor_digest,
        approved_by: approved_by,
        published_at: published_at
    )
    ensures: GeneratedCandidate.created(
        generation: proposal.generation,
        builder_session_identity: session,
        subject_digest: proposal.subject_digest,
        output_root: output_root,
        disposition: baseline_measured,
        oracle_descriptor_digest: descriptor_digest
    )
    ensures: ComponentCandidate.created(
        identity: proposal.generation.identity,
        output_root: output_root,
        subject_digest: proposal.subject_digest,
        project_identity: proposal.generation.project_identity,
        container_identity: proposal.generation.container_identity,
        component_identity: proposal.generation.component_identity,
        operation: fresh_generation,
        parent_candidate_identity: null,
        disposition: baseline_measured,
        oracle_descriptor_digest: descriptor_digest
    )
    ensures: proposal.status = published
    ensures: proposal.generation.status = oracle_promoted
}

rule RefuseFailedOrIncompleteGrade {
    when: FreshSliceGenerationGradeCompleted(generation, grade, scenario_digests)
    requires: generation.status = running
    requires: not grade.complete or not grade.passed or
              not grade.instrument_conformance_passed or
              not every_approved_item_has_one_pass_with_evidence(
                  generation.approved_items, grade.item_verdicts)
    ensures: generation.status = failed
    ensures: generation.failure_reason = "first black-box grade did not completely pass"
    ensures: not exists ProductOracleProposals where generation = generation
    ensures: not exists GeneratedCandidates where generation = generation
}

rule RepairFailedFreshSliceGenerationVerification {
    when: FreshSliceGenerationVerificationFailed(generation, candidate, evidence, attempts)
    requires: generation.status = running
    requires: evidence != null
    requires: attempts.count < 3
    ensures: FreshBuilderSessionRequested(
        generation: generation,
        initial_workspace: candidate.output_root,
        verifier_evidence: evidence,
        attempt: attempts.count + 1
    )
    ensures: no_baseline_grade_or_oracle_evidence_is_shared(generation)
}

rule FailEmptyFreshSliceGeneration {
    when: FirstBuilderFailed(generation, reason)
    requires: generation.status = running
    requires: reason != ""
    ensures: generation.status = failed
    ensures: generation.failure_reason = reason
    ensures: not exists ProductOracleProposals where generation = generation
}

rule RouteApprovedSliceToMeasuredRegeneration {
    when: ApprovedSliceSubmitted(request)
    requires: selection_is_approved_and_matches_digest(request)
    requires: request.operation = measured_regeneration
    requires: request.parent_candidate_identity != null
    requires: candidate_named(request.parent_candidate_identity).disposition = baseline_measured or
              candidate_named(request.parent_candidate_identity).disposition = oracle_measured
    requires: candidate_named(request.parent_candidate_identity).oracle_descriptor_digest != ""
    ensures: ApprovedSliceRoute.created(
        request_identity: request.identity,
        request_digest: request.digest,
        project_identity: request.project_identity,
        container_identity: request.container_identity,
        component_identity: request.component_identity,
        selection_identity: request.selection_identity,
        operation: measured_regeneration,
        parent_candidate_identity: request.parent_candidate_identity,
        parent_candidate_root: candidate_named(request.parent_candidate_identity).output_root,
        parent_candidate_digest: candidate_named(request.parent_candidate_identity).subject_digest
    )
    ensures: MeasuredRegenerationRequested(
        request,
        parent_candidate: candidate_named(request.parent_candidate_identity),
        product_oracle: accepted_oracle_named(
            candidate_named(request.parent_candidate_identity).oracle_descriptor_digest))
}

invariant FreshSliceGenerationCandidateRequiresApprovedOracle {
    for candidate in GeneratedCandidates:
        candidate.generation.operation = fresh_generation and
        candidate.disposition = baseline_measured and
        candidate.oracle_descriptor_digest != "" and
        exists AcceptedProductOracles where
            descriptor_digest = candidate.oracle_descriptor_digest and
            proposal.generation = candidate.generation
}

invariant OracleProposalRetainsCompleteProvenance {
    for proposal in ProductOracleProposals:
        proposal.selection_identity != "" and
        proposal.selection_digest != "" and
        proposal.scenario_digests.count = proposal.denominator and
        proposal.subject_digest != "" and
        proposal.judge_identity != "" and
        proposal.normalized_evidence_digest != "" and
        proposal.proposal_digest != ""
}

invariant FailedFreshSliceGenerationHasNoPromotedCandidate {
    for generation in FreshSliceGenerations:
        generation.status = failed implies
            not exists AcceptedProductOracles where proposal.generation = generation and
            not exists GeneratedCandidates where generation = generation
}

invariant FreshSliceGenerationHasNoParentCandidate {
    for generation in FreshSliceGenerations:
        not has_parent_candidate(generation)
}

surface FreshSliceGenerationWorkflow {
    provides:
        ApprovedFreshSliceGenerationRequested(generation)
        FreshSliceGenerationVerificationFailed(generation, candidate, evidence, attempts)
        FreshSliceGenerationGradeCompleted(generation, grade, scenario_digests)
        OperatorApprovesOracleProposal(operator, proposal, supplied_digest)
        ProductOraclePublished(proposal, descriptor_digest, approved_by, published_at,
                               session, output_root)
        FirstBuilderFailed(generation, reason)
        ApprovedSliceSubmitted(request)

    @guarantee GradeBeforePromotion
        -- Every approved item must independently pass before evidence can be proposed as an oracle.

    @guarantee FreshHarnessBeforeBuilder
        -- The cycle binds one calibrated, sealed harness snapshot built from a committed revision;
        -- no published instrument oracle or manually configured validator directory is required.

    @guarantee CandidateBlindCycleOracle
        -- Grade builds and calibrates one fresh cycle oracle from the approved cut without candidate access.

    @guarantee ExactManualApproval
        -- Only the exact operator-approved proposal digest can be published and bind the candidate.

    @guarantee NoCircularBuilderFeedback
        -- Grade and oracle evidence never enter the builder or verification-repair loop.
}
