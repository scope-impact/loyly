-- allium: 3
-- Löyly booking-core behavioral model.
-- The executable acceptance source is docs/plan/01-booking-core/spec.feature.

enum Weekday { monday | tuesday | wednesday | thursday | friday | saturday | sunday }

enum SlotRequestStatus { pending | confirmed | refused }

enum RefusalReason { closed_day | held | no_room | nothing_yet }

entity Household {
    apartment: String
    standing_slots: StandingSlot with household = this
}

entity Sauna {
    name: String
    dressing_rooms: DressingRoom with sauna = this
    standing_slots: StandingSlot with dressing_room.sauna = this
    configured_standing_slot_count: configured_standing_slot_count(dressing_rooms)
    free_standing_slot_count: configured_standing_slot_count - standing_slots.count
}

entity DressingRoom {
    name: String
    sauna: Sauna
    open_weekdays: Set<Weekday>
    slot_starts: List<String>
    standing_slots: StandingSlot with dressing_room = this
    is_held(weekday, start_time): standing_slots.any(s => s.weekday = weekday and s.start_time = start_time)
}

entity StandingSlot {
    identity: String
    household: Household
    dressing_room: DressingRoom
    weekday: Weekday
    start_time: String
}

entity SlotRequest {
    household: Household
    dressing_room: DressingRoom
    weekday: Weekday
    start_time: String
    status: SlotRequestStatus
    refusal_reason: RefusalReason?
}

entity BillingSignal {
    standing_slot_identity: String
    household: Household
}

entity HeaterPeriod {
    standing_slot_identity: String
    dressing_room: DressingRoom
    weekday: Weekday
    start_time: String
}

rule ConfigureDays {
    when: ConfigureDays(dressing_room, sauna, weekdays, slot_starts)
    requires: exists dressing_room
    requires: exists sauna
    ensures: dressing_room.sauna = sauna
    ensures: dressing_room.open_weekdays = weekdays
    ensures: dressing_room.slot_starts = slot_starts
}

rule RequestStandingSlot {
    when: RequestStandingSlot(household, dressing_room, weekday, start_time)
    requires: exists household
    requires: exists dressing_room
    requires: weekday in dressing_room.open_weekdays
    requires: start_time in dressing_room.slot_starts
    requires: not dressing_room.is_held(weekday, start_time)
    let slot_identity = standing_slot_identity(household, dressing_room, weekday, start_time)
    ensures: SlotRequest.created(household: household, dressing_room: dressing_room,
                                weekday: weekday, start_time: start_time, status: confirmed)
    ensures: StandingSlot.created(identity: slot_identity,
                                 household: household, dressing_room: dressing_room,
                                 weekday: weekday, start_time: start_time)
    ensures: BillingSignal.created(standing_slot_identity: slot_identity,
                                  household: household)
    ensures: HeaterPeriod.created(standing_slot_identity: slot_identity,
                                 dressing_room: dressing_room, weekday: weekday,
                                 start_time: start_time)
}

rule RefuseClosedDay {
    when: RequestStandingSlot(household, dressing_room, weekday, start_time)
    requires: exists household
    requires: exists dressing_room
    requires: weekday not in dressing_room.open_weekdays
    ensures: SlotRequest.created(household: household, dressing_room: dressing_room,
                                weekday: weekday, start_time: start_time,
                                status: refused, refusal_reason: closed_day)
}

rule RefuseHeldSlot {
    when: RequestStandingSlot(household, dressing_room, weekday, start_time)
    requires: exists household
    requires: exists dressing_room
    requires: weekday in dressing_room.open_weekdays
    requires: dressing_room.is_held(weekday, start_time)
    requires: household.standing_slots.count != 1 or dressing_room.sauna.free_standing_slot_count > 0
    ensures: SlotRequest.created(household: household, dressing_room: dressing_room,
                                weekday: weekday, start_time: start_time,
                                status: refused, refusal_reason: held)
}

rule RefuseNoRoomForSecondSlot {
    when: RequestStandingSlot(household, dressing_room, weekday, start_time)
    requires: exists household
    requires: exists dressing_room
    requires: household.standing_slots.count = 1
    requires: weekday in dressing_room.open_weekdays
    requires: start_time in dressing_room.slot_starts
    requires: dressing_room.sauna.free_standing_slot_count = 0
    requires: dressing_room.is_held(weekday, start_time)
    ensures: SlotRequest.created(household: household, dressing_room: dressing_room,
                                weekday: weekday, start_time: start_time,
                                status: refused, refusal_reason: no_room)
}

rule ReleaseStandingSlot {
    when: ReleaseStandingSlot(slot, household)
    requires: slot.household = household
    ensures: not exists slot
    ensures: not exists HeaterPeriods where dressing_room = slot.dressing_room and weekday = slot.weekday and start_time = slot.start_time
}

rule RefusalIsActionable {
    when: SlotRequest.created(request)
    requires: request.status = refused
    ensures: request.refusal_reason != null
}

invariant OneHolderPerSlot {
    for a in StandingSlots:
        for b in StandingSlots:
            a != b implies not (a.dressing_room = b.dressing_room and
                                a.weekday = b.weekday and
                                a.start_time = b.start_time)
}

invariant DerivedViewsAgree {
    for slot in StandingSlots:
        exists HeaterPeriods where standing_slot_identity = slot.identity and
            dressing_room = slot.dressing_room and weekday = slot.weekday and
            start_time = slot.start_time
        and exists BillingSignals where standing_slot_identity = slot.identity and
            household = slot.household
}

surface ManagerBooking {
    facing manager: Household

    exposes:
        manager.apartment
        DressingRoom.name
        DressingRoom.open_weekdays
        DressingRoom.slot_starts

    provides:
        ConfigureDays(dressing_room, sauna, weekdays, slot_starts)

    @guarantee DaysAreActionable
        -- Saved configuration names the dressing room, open weekdays and slot starts.
}

surface ResidentBooking {
    facing household: Household

    exposes:
        DressingRoom
        StandingSlot
        SlotRequest
        HeaterPeriod
        BillingSignal

    provides:
        RequestStandingSlot(household, dressing_room, weekday, start_time)
        ReleaseStandingSlot(slot, household)

    @guarantee OneHolderPerSlot
        -- A standing slot is held by at most one household.

    @guarantee DerivedViewsAgree
        -- Posted availability, heating and billing derive from the booking record.

    @guarantee RefusalIsActionable
        -- A refusal gives the resident enough information to act without asking again.

    @guarantee FullScheduleRefusesASecondSlotAsNoRoom
        -- When a household holds exactly one standing slot and no configured standing
        -- slot remains free, its request for a second configured slot is refused as
        -- no_room before the requested slot's held state is considered.
}
