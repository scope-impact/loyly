# The one file to edit per project. Make reads it: KEY=value, no quotes, no spaces in paths.
# Relative paths resolve against this file's directory. Any key can be set for one call on
# the command line, e.g. `make start COMMIT=abc123`.

# LOYLY_HOME: the Löyly checkout that holds harness/loyly-run and harness-impl/ (the runner).
LOYLY_HOME=../../loyly

# PROJECT: a short name, [A-Za-z0-9._-]. Run ids are PROJECT-<yyyymmdd-HHMMSS>.
PROJECT=myapp

# PROJECT_REPO: the git repository the run builds (the runner's LOYLY_PROJECT_REPO). At COMMIT
# it carries the project side of the harness: harness/config.sh, the self-check (run as
# `harness/check.sh --local`), the gate (harness/verify.sh and its probe) and a plan of stamped
# Gherkin. archive/legacy-harness/ in the Löyly checkout is the reference set of those files.
PROJECT_REPO=..

# COMMIT: the cut the run builds, any revision of PROJECT_REPO. Committed work only.
COMMIT=HEAD

# INSTRUCTION: the builder's instruction. Fill in the template's placeholders first.
INSTRUCTION=builder-instruction.md

# HARNESS_CONFIG: the harness config handed to the runner (APP_DIR, PORT, PLAN_DIR, APP_MARKER,
# APP_PROBE, FENCED_PATHS, optional APP_SEAM, PLAN_SLICES, BUILDER_IMAGE).
# Empty: harness/config.sh at COMMIT.
HARNESS_CONFIG=

# CUT_ID, SELECTION_ID: the labels the run records for its cut and its selection.
CUT_ID=myapp-cut
SELECTION_ID=myapp-plan-all

# BUDGET_FILE: the run's budget, JSON or EDN (.edn). Empty: run-03's (3 gate attempts, 1 outer
# cycle, stage timeouts fence 30 min, regenerate 4 h, gate 1 h, score 8 h).
BUDGET_FILE=

# GRADER_DIGEST: the approved grader's digest, named at start and with the verdicts.
# Empty: <run-id>-grading-subagent (the verdicts of a black-box grading agent).
GRADER_DIGEST=

# RUN_ID: empty gives each start a fresh PROJECT-<timestamp>; the other targets act on the last
# run started.
RUN_ID=

# STATE_ROOT: where run state goes, one directory per run.
# Empty: .pi/harness/.state/PROJECT in LOYLY_HOME (not committed).
STATE_ROOT=

# RUN_ENV: KEY=VALUE overrides of the runner's environment, space separated, e.g. a stand-in
# builder for a trial: LOYLY_BUILDER_CMD=/abs/path/stub-builder.sh. Empty: the real pi builder.
RUN_ENV=

# NO_WAIT: 1 makes `make start` return as soon as start-run is queued.
NO_WAIT=
