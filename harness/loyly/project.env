# Löyly's run config (harness/project-template/project.env explains each key).
# Relative paths resolve against this directory.

LOYLY_HOME=../..
PROJECT=loyly
# Empty: harness/loyly-run builds the cut itself, a scratch commit on COMMIT of this repository
# whose harness/ is archive/legacy-harness/ minus cycles/ (as cut 249a90b).
PROJECT_REPO=
COMMIT=HEAD
INSTRUCTION=builder-instruction.md
# Empty: the cut's harness/config.sh, with FENCED_PATHS="impl .pi archive/legacy-harness/cycles".
HARNESS_CONFIG=
CUT_ID=loyly-full-app-cut
SELECTION_ID=loyly-docs-plan-all
BUDGET_FILE=
# Supply a calibrated, sealed rubric and its approved digest for the ORC grader.
GRADER_RUBRIC=
GRADER_DIGEST=
# Supply a live OpenAI-compatible endpoint for ORC render and grade nodes.
MODEL_API_BASE=
RENDER_MODEL=
GRADER_MODEL=
# Empty: .pi/harness/.state/assets/builder-clojure.
GRADER_IMAGE=
RUN_ID=
STATE_ROOT=
RUN_ENV=
NO_WAIT=
