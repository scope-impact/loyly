# /etc/loyly/factory.env, mode 0600, owned by root. Read by the systemd unit.
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_CHANNEL=C0REPLACE
# Who may start, steer, approve and reject cycles: Slack member IDs, comma-separated.
SLACK_ALLOWED_USERS=U0REPLACE
LOYLY_WORKDIR=/srv/loyly-cycles
LOYLY_ISOLATION=user
LOYLY_BUILDER_USER=loyly-builder
