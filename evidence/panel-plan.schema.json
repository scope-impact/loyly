{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyly.example/schema/grading-panel-plan.v1.json",
  "title": "Löyly grading panel plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "feature", "checks"],
  "properties": {
    "schema": { "const": "loyly.grading-panel-plan.v1" },
    "project": { "type": "string", "minLength": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "role", "tool", "technique", "items", "criterion", "failure", "target_runtime"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "source": { "enum": ["raw-grader", "blind-review", "specialist"] },
          "role": { "enum": ["scored", "handoff", "corroborating", "diagnostic"] },
          "tool": { "type": "string", "minLength": 1 },
          "technique": { "type": "string", "minLength": 1 },
          "items": { "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{3}$" } },
          "criterion": { "type": "string", "minLength": 1 },
          "failure": { "type": "string", "minLength": 1 },
          "target_runtime": { "const": "gondolin-qemu-vm" }
        }
      }
    }
  }
}
