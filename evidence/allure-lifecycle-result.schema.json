{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Allure lifecycle evidence result",
  "description": "Project profile for one evaluated check per {uuid}-result.json. Use lifecycle for delivery phase and stage for Allure execution state. Represent operational checks with a bounded time window, explicit criterion and observed outcome. Record references to audit events, alerts, incidents and runbooks in links or attach evidence files alongside the result. Use a fresh uuid per execution and a stable historyId across comparable runs.",
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "minLength": 1
    },
    "historyId": {
      "type": "string"
    },
    "testCaseId": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "stage": {
      "enum": [
        "scheduled",
        "running",
        "finished",
        "pending",
        "interrupted"
      ]
    },
    "statusDetails": {
      "$ref": "#/$defs/statusDetails"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "stop": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "descriptionHtml": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "lifecycle"
              },
              "value": {
                "enum": [
                  "pre-production",
                  "deploy",
                  "release",
                  "post-release"
                ]
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "technique"
              },
              "value": {
                "$ref": "#/$defs/technique"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "name": {
                "const": "tool"
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "minContains": 1
        }
      ],
      "description": "For Kubernetes evidence, add cluster, namespace, workload and revision labels where applicable. Repeat tool for cooperating producers. Use parameters for pod UID, image digest, observation window and measured values. Attach filtered snapshots and link live views."
    }
  },
  "required": [
    "uuid",
    "name",
    "status",
    "labels"
  ],
  "$defs": {
    "status": {
      "enum": [
        "passed",
        "failed",
        "broken",
        "skipped",
        "unknown"
      ]
    },
    "statusDetails": {
      "type": "object",
      "properties": {
        "known": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "flaky": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "trace": {
          "type": "string"
        }
      }
    },
    "attachment": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-attachment\\.[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$",
          "description": "Canonical Allure filename in the results directory. Generate a fresh UUID for each file."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*/[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*(?:[ \\t]*;[ \\t]*[A-Za-z0-9_-]+=(?:[A-Za-z0-9!#$%&'*+.^_`|~-]+|\"[^\"\\r\\n]*\"))*$",
          "examples": [
            "application/json",
            "text/csv",
            "image/png",
            "video/webm",
            "text/plain",
            "application/vnd.allure.image.diff",
            "application/zip",
            "application/vnd.allure.playwright-trace"
          ]
        }
      },
      "required": [
        "name",
        "source",
        "type"
      ],
      "description": "Evidence on a result or nested step. Write the actual attachment bytes beside the result JSON. Use links for external URLs. Allure selects the preview using the media type; other formats remain downloadable.",
      "if": {
        "properties": {
          "type": {
            "const": "application/vnd.allure.playwright-trace"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "pattern": "\\.zip$"
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "excluded": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "default",
            "masked",
            "hidden"
          ]
        }
      },
      "required": [
        "name",
        "value"
      ]
    },
    "link": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "label": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "name": {
                "const": "lifecycle"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "enum": [
                  "pre-production",
                  "deploy",
                  "release",
                  "post-release"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "name": {
                "const": "technique"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "$ref": "#/$defs/technique"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "name": {
                "const": "tool"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "stage": {
          "enum": [
            "scheduled",
            "running",
            "finished",
            "pending",
            "interrupted"
          ]
        },
        "statusDetails": {
          "$ref": "#/$defs/statusDetails"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "stop": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        },
        "descriptionHtml": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "technique": {
      "type": "string",
      "enum": [
        "lint",
        "type-check",
        "unit",
        "functional",
        "component",
        "integration",
        "database-integration",
        "http-record-replay",
        "consumer-contract",
        "api-spec",
        "property-based",
        "fuzz",
        "mutation",
        "coverage",
        "formal-verification",
        "acceptance",
        "mobile-acceptance",
        "regression",
        "smoke",
        "usability",
        "ui-ux",
        "threat-modeling",
        "authorization",
        "penetration-test",
        "benchmark",
        "performance",
        "configuration",
        "load",
        "soak",
        "traffic-mirroring",
        "tap-compare",
        "canary",
        "traffic-shaping",
        "promotion-analysis",
        "feature-flag",
        "exception-tracking",
        "monitoring",
        "metrics",
        "logs",
        "tracing",
        "dynamic-exploration",
        "profiling",
        "real-user-monitoring",
        "ab-test",
        "chaos",
        "audit-trail",
        "alerting",
        "on-call",
        "incident-recovery",
        "recovery-verification",
        "cluster-policy",
        "workload-health",
        "network-connectivity",
        "network-isolation",
        "runtime-process-activity",
        "runtime-file-activity",
        "kernel-diagnostics",
        "service-latency",
        "continuous-profiling",
        "kubernetes-api-audit",
        "restore-verification"
      ]
    }
  },
