;; .pi/spec/grader-lifecycle/event-model/area.edn
;; Grader lifecycle, R1 part only: the instrument goldens. Graders (requested, authored,
;; calibrated, sealed, approved, reused, replaced) arrive in a later round and add blocks
;; here without renaming these.
;; Allium: ../allium/ (instrument-golden.allium: surface InstrumentGoldenDesk).
{:grader-lifecycle
 {:description "Grader lifecycle: the instrument's own material, on its own clock, outside every cycle. R1 holds the instrument goldens; the graders come later."
  :screens
  {:grader-lifecycle/instrument-goldens
   {:description "The instrument maintainer's view: each instrument golden, its digest and the recorded reason for every move."
    :grain/allium [{:spec ".pi/spec/grader-lifecycle/allium/instrument-golden.allium" :kind :surface :name "InstrumentGoldenDesk"}]
    :queries #{:grader-lifecycle/instrument-goldens}
    :commands #{:grader-lifecycle/write-instrument-golden :grader-lifecycle/move-instrument-golden}}}
  :flows
  {:grader-lifecycle/golden-written-then-moved
   {:description "A golden is written from its scenario; a move carries one of three reasons; the harness self-check reproduces the current goldens exactly."
    :grain/allium [{:spec ".pi/spec/grader-lifecycle/allium/instrument-golden.allium" :kind :rule :name "WriteInstrumentGolden"}
                   {:spec ".pi/spec/grader-lifecycle/allium/instrument-golden.allium" :kind :rule :name "MoveInstrumentGolden"}]
    :steps [{:from [:screen :grader-lifecycle/instrument-goldens] :to [:command :grader-lifecycle/write-instrument-golden]}
            {:from [:command :grader-lifecycle/write-instrument-golden] :to [:event :grader-lifecycle/instrument-golden-written]}
            {:from [:event :grader-lifecycle/instrument-golden-written] :to [:read-model :grader-lifecycle/instrument-goldens]}
            {:from [:read-model :grader-lifecycle/instrument-goldens] :to [:query :grader-lifecycle/instrument-goldens]}
            {:from [:query :grader-lifecycle/instrument-goldens] :to [:screen :grader-lifecycle/instrument-goldens]}
            {:from [:screen :grader-lifecycle/instrument-goldens] :to [:command :grader-lifecycle/move-instrument-golden]}
            {:from [:command :grader-lifecycle/move-instrument-golden] :to [:event :grader-lifecycle/instrument-golden-moved]}
            {:from [:event :grader-lifecycle/instrument-golden-moved] :to [:read-model :grader-lifecycle/instrument-goldens]}
            {:from [:event :grader-lifecycle/instrument-golden-moved] :to [:read-model :regeneration-cycle/instrument-goldens]}
            {:from [:read-model :regeneration-cycle/instrument-goldens] :to [:command :regeneration-cycle/record-harness-self-check]}]}}}}
