;; Big Picture EventStorming board for the Pi harness, as data.
;; Simulated workshop, 2026-11-06: operator, workflow, instrument, skeptic.
;; Not yet reviewed by the product owner. The human board is event-storm.md.
;; Extra keys beyond the agreed shape: :notes and :hot-spots on events, :kind on phases,
;; :handoffs on contexts, :raised-by on disagreements.
{:meta {:title "Pi harness: Big Picture EventStorming"
        :date "2026-11-06"
        :participants [:operator :workflow :instrument :skeptic]
        :status "simulated workshop; not yet reviewed by the product owner"}

 :phases
 [{:id :specify
   :name "Specify (upstream of every cycle)"
   :kind :upstream
   :events
   [{:id :scenario-stamped :name "Scenario stamped"
     :caused-by {:kind :actor :name "Operator (spec author), via the stamper"}
     :pivotal? false :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Scenarios stamped" "Scenario stamped with item identity"]
     :notes "Item identity is never derived from wording; rewording keeps the cycle-to-cycle join."
     :hot-spots []}
    {:id :unstamped-scenario-found :name "Unstamped scenario found"
     :caused-by {:kind :policy :name "Whenever a checklist is derived, then every selected scenario must carry an item identity"}
     :pivotal? false :unhappy-of :scenario-stamped :raised-by [:instrument :skeptic :operator]
     :merged-from ["Unstamped scenario found" "Selection found empty or unstamped (unstamped half)" "Unstamped ... stops here"]
     :notes "Stops the cycle instead of shrinking the denominator."
     :hot-spots []}]}

  {:id :prepare
   :name "Prepare and approve"
   :kind :main
   :events
   [{:id :source-cut-pinned :name "Source cut pinned"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? true :unhappy-of nil :raised-by [:operator]
     :merged-from ["Source cut pinned"]
     :notes "Everything later binds to the cut's commit and tree content."
     :hot-spots []}
    {:id :slice-proposed :name "Slice proposed"
     :caused-by {:kind :system :name "Operator session (LLM)"}
     :pivotal? false :unhappy-of nil :raised-by [:operator]
     :merged-from ["Slice proposed"]
     :notes "A suggestion only; cannot approve itself or invent items."
     :hot-spots [:hs-planned-slice-filter]}
    {:id :selection-contract-presented :name "Selection contract presented"
     :caused-by {:kind :system :name "Harness, resolving the proposal against the cut"}
     :pivotal? false :unhappy-of nil :raised-by [:operator]
     :merged-from ["Selection previewed"]
     :notes "The exact items, scenario digests and digest the operator accepts."
     :hot-spots []}
    {:id :selection-approved :name "Selection approved"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Selection approved"]
     :notes "One exact digest; fixes which scenarios the instrument may count."
     :hot-spots [:hs-whole-plan-submission]}
    {:id :approval-refused :name "Approval refused: digest not the one reviewed"
     :caused-by {:kind :policy :name "Whenever an approval names a digest other than the presented one, then refuse it"}
     :pivotal? false :unhappy-of :selection-approved :raised-by [:skeptic]
     :merged-from ["Approval refused: digest not the reviewed one"]
     :notes "" :hot-spots []}
    {:id :checklist-derived :name "Checklist derived"
     :caused-by {:kind :policy :name "Whenever a selection is approved, then derive its checklist"}
     :pivotal? false :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Checklist derived"]
     :notes "Sets the denominator; never hand-kept. Instrument marked it pivotal; facilitator kept it inside the phase (see disagreements)."
     :hot-spots []}
    {:id :empty-selection-refused :name "Empty selection refused"
     :caused-by {:kind :policy :name "Whenever a checklist would be empty, then refuse the selection"}
     :pivotal? false :unhappy-of :checklist-derived :raised-by [:instrument :skeptic :operator]
     :merged-from ["Empty selection refused" "Selection found empty or unstamped (empty half)"]
     :notes "Nothing that could fail is no measurement." :hot-spots []}
    {:id :cycle-preparation-approved :name "Cycle preparation approved"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :skeptic]
     :merged-from ["Cycle preparation approved" "preparation approved"]
     :notes "Binds approved selection, approved grader digests, scope, stack, execution profile, budget. The one immutable hand-off to ORC."
     :hot-spots [:hs-budget :hs-whole-plan-submission :hs-preparation-expiry]}]}

  {:id :grader
   :name "Grader preparation (parallel stream, own clock)"
   :kind :parallel
   :events
   [{:id :grader-requested :name "Grader requested"
     :caused-by {:kind :policy :name "Whenever a selection holds scenarios no approved grader covers, then request a grader"}
     :pivotal? false :unhappy-of nil :raised-by [:operator]
     :merged-from ["Grader requested"]
     :notes "Operator wrote 'Operator / policy'." :hot-spots []}
    {:id :instrument-golden-written :name "Instrument golden written"
     :caused-by {:kind :actor :name "Instrument maintainer"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Instrument golden written"]
     :notes "Written from the scenario, never recorded from a run." :hot-spots []}
    {:id :grader-authored :name "Grader authored"
     :caused-by {:kind :system :name "Grader author (builder session, blind)"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Grader authored"]
     :notes "Sees only the selected Gherkin and the public calibration protocol."
     :hot-spots [:hs-grader-author-blindness]}
    {:id :grader-calibrated :name "Grader calibrated"
     :caused-by {:kind :system :name "Calibration protocol"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument :operator]
     :merged-from ["Grader calibrated: carried passed, uncarried failed" "Grader sealed (calibrated)"]
     :notes "Carried behaviour passes, uncarried fails." :hot-spots []}
    {:id :grader-discarded :name "Grader discarded: calibration failed"
     :caused-by {:kind :system :name "Calibration protocol"}
     :pivotal? false :unhappy-of :grader-calibrated :raised-by [:skeptic]
     :merged-from ["Grader discarded: calibration failed"]
     :notes "" :hot-spots [:hs-calibration-failure-cause]}
    {:id :instrument-declared-unavailable :name "Instrument declared unavailable"
     :caused-by {:kind :policy :name "Whenever calibration fails three times, then declare the slice unscoreable"}
     :pivotal? false :unhappy-of :grader-calibrated :raised-by [:operator]
     :merged-from ["Instrument declared unavailable"]
     :notes "" :hot-spots [:hs-calibration-failure-cause]}
    {:id :grader-sealed :name "Grader sealed"
     :caused-by {:kind :system :name "Instrument"}
     :pivotal? false :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Grader sealed" "Grader sealed by digest"]
     :notes "Content becomes immutable and nameable by digest." :hot-spots []}
    {:id :grader-digest-approved :name "Grader digest approved"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Grader approved" "Grader digest approved"]
     :notes "Only this exact digest may file verdicts."
     :hot-spots [:hs-grader-review-bias]}
    {:id :grader-reused :name "Grader reused"
     :caused-by {:kind :policy :name "Whenever a cycle's scenarios are unchanged, then reuse the approved grader"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Grader reused"]
     :notes "Same ruler across cycles." :hot-spots []}
    {:id :grader-found-stale :name "Grader found stale for the selection"
     :caused-by {:kind :policy :name "Whenever a selected scenario digest differs from the grader's, then mark it stale"}
     :pivotal? false :unhappy-of :grader-reused :raised-by [:skeptic]
     :merged-from ["Grader found stale for the selection"]
     :notes "" :hot-spots [:hs-staleness-key]}
    {:id :grader-replaced :name "Grader replaced for a recorded reason"
     :caused-by {:kind :actor :name "Operator, with a reason record"}
     :pivotal? false :unhappy-of nil :raised-by [:operator :instrument]
     :merged-from ["Grader replaced" "Grader replaced for a recorded reason"]
     :notes "Reasons: instrument behaviour changed, wording replaced, spec grew (additions only). Approving the successor retires the old one."
     :hot-spots [:hs-replacement-reason-truth]}
    {:id :grader-replacement-refused :name "Grader replacement refused: no recorded reason"
     :caused-by {:kind :policy :name "Whenever a replacement has no recorded reason, then refuse it"}
     :pivotal? false :unhappy-of :grader-replaced :raised-by [:skeptic]
     :merged-from ["Grader replacement refused: no recorded reason"]
     :notes "Skeptic marked pivotal; facilitator kept it as an unhappy branch (no phase change)." :hot-spots []}
    {:id :instrument-golden-moved :name "Instrument golden moved, reason recorded"
     :caused-by {:kind :actor :name "Instrument maintainer"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Golden moved and its reason recorded"]
     :notes "Additions-only diff is the test for 'spec grew'." :hot-spots [:hs-replacement-reason-truth]}]}

  {:id :dispatch
   :name "Submit and dispatch"
   :kind :main
   :events
   [{:id :cycle-submitted :name "Cycle submitted"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :workflow :skeptic]
     :merged-from ["Cycle submitted" "Workflow task submitted" "task submitted"]
     :notes "Approval starts nothing; submission does."
     :hot-spots [:hs-cycle-number :hs-builder-host-absent]}
    {:id :receipt-issued :name "Receipt issued"
     :caused-by {:kind :system :name "Harness"}
     :pivotal? false :unhappy-of nil :raised-by [:operator]
     :merged-from ["Receipt issued"]
     :notes "" :hot-spots []}
    {:id :duplicate-submission-answered :name "Duplicate submission answered with the original receipt"
     :caused-by {:kind :policy :name "Whenever the same identity and payload is submitted again, then return the original receipt"}
     :pivotal? false :unhappy-of :receipt-issued :raised-by [:skeptic :operator]
     :merged-from ["Duplicate submission answered with original receipt" "Repeats return the same receipt"]
     :notes "" :hot-spots []}
    {:id :submission-refused :name "Submission refused: same identity, different payload"
     :caused-by {:kind :policy :name "Whenever one identity arrives with a different payload, then refuse it"}
     :pivotal? false :unhappy-of :receipt-issued :raised-by [:skeptic]
     :merged-from ["Submission refused: same identity, different payload"]
     :notes "Skeptic marked pivotal; facilitator kept it as an unhappy branch." :hot-spots []}
    {:id :cycle-started :name "Cycle started by ORC"
     :caused-by {:kind :system :name "ORC worker"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["ORC tick dispatched"]
     :notes "Turned from ORC machinery into the fact it hides: the cycle's task left not-started. The tick id becomes each builder's request identity."
     :hot-spots []}]}

  {:id :fence
   :name "Fence"
   :kind :main
   :events
   [{:id :self-check-passed :name "Harness self-check passed"
     :caused-by {:kind :system :name "Harness (ORC stage)"}
     :pivotal? true :unhappy-of nil :raised-by [:workflow :instrument :skeptic]
     :merged-from ["Harness self-check passed (or refused)" "Harness self-check passed (or failed, naming the check)"]
     :notes "No room is built over an unchecked instrument; reused only for an identical harness digest."
     :hot-spots [:hs-self-check-coverage]}
    {:id :self-check-failed :name "Harness self-check failed"
     :caused-by {:kind :system :name "Harness (ORC stage)"}
     :pivotal? false :unhappy-of :self-check-passed :raised-by [:workflow :instrument :skeptic]
     :merged-from ["Harness self-check failed"]
     :notes "Names the failing check; stops the cycle." :hot-spots []}
    {:id :clean-room-proved :name "Clean room proved"
     :caused-by {:kind :system :name "Fence"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :workflow]
     :merged-from ["Clean room proved" "Clean room fenced" "Clean room proved (fenced paths absent from tree and object graph)"]
     :notes "Physical: absent from working tree and object graph. 'Fenced' (ORC ran the stage) folded into 'proved' (the fact)."
     :hot-spots [:hs-scoring-tools-fenced]}
    {:id :fence-refused-empty-path :name "Fence refused: a fenced path matched nothing"
     :caused-by {:kind :system :name "Fence"}
     :pivotal? false :unhappy-of :clean-room-proved :raised-by [:skeptic :operator]
     :merged-from ["Fence refused: fenced path matched nothing" "Fence refused"]
     :notes "Stops before builders spend." :hot-spots []}
    {:id :prior-implementation-reachable :name "Fence refused: prior implementation reachable in the object graph"
     :caused-by {:kind :system :name "Fence probe"}
     :pivotal? false :unhappy-of :clean-room-proved :raised-by [:skeptic]
     :merged-from ["Prior implementation found reachable in object graph"]
     :notes "Skeptic marked pivotal; kept as an unhappy branch." :hot-spots []}]}

  {:id :regenerate
   :name "Regenerate"
   :kind :main
   :events
   [{:id :builder-room-started :name "Builder room started"
     :caused-by {:kind :system :name "ORC (chooses the room) on Gondolin"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Builder room started"]
     :notes "Stack image, cut read-only, candidate scope writable, offline. The builder host cannot widen it."
     :hot-spots []}
    {:id :builder-session-launched :name "Builder session launched"
     :caused-by {:kind :policy :name "Whenever a builder tick starts, then launch its builder session with the production prompt"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Builder session launched"]
     :notes "Production prompt digest recorded; tick is the request identity." :hot-spots []}
    {:id :tool-result-committed :name "Tool result committed"
     :caused-by {:kind :system :name "Builder host (pi-durable)"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Tool call committed" "Workspace generation bound"]
     :notes "A turn counts only once committed; it binds a workspace generation."
     :hot-spots [:hs-crash-between-effect-and-fact :hs-credential-leak]}
    {:id :out-of-scope-access-refused :name "Out-of-scope read or write refused"
     :caused-by {:kind :system :name "Builder room (Gondolin)"}
     :pivotal? false :unhappy-of :tool-result-committed :raised-by [:skeptic]
     :merged-from ["Out-of-scope read or write refused"]
     :notes "Graders, host environment, egress." :hot-spots []}
    {:id :builder-session-interrupted :name "Builder session interrupted"
     :caused-by {:kind :system :name "Builder host or OS (crash, restart)"}
     :pivotal? false :unhappy-of :tool-result-committed :raised-by [:workflow]
     :merged-from ["Builder process crashed / harness restarted"]
     :notes "" :hot-spots [:hs-relaunch-race]}
    {:id :builder-session-resumed :name "Builder session resumed"
     :caused-by {:kind :policy :name "Whenever the same tick is relaunched, then resume its session from committed turns"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow :skeptic]
     :merged-from ["Builder session resumed" "Builder session resumed for the same tick"]
     :notes "Never a second session. Workflow and skeptic marked it pivotal; facilitator demoted it (no phase change)."
     :hot-spots [:hs-room-on-resume :hs-relaunch-race]}
    {:id :resume-refused :name "Resume refused: transcript and workspace generation disagreed"
     :caused-by {:kind :system :name "ORC"}
     :pivotal? false :unhappy-of :builder-session-resumed :raised-by [:skeptic :workflow]
     :merged-from ["Resume refused: transcript and workspace generation disagreed"]
     :notes "Workflow asked which event says so; skeptic supplied it." :hot-spots [:hs-crash-between-effect-and-fact]}
    {:id :intervention-recorded :name "Builder-session intervention recorded"
     :caused-by {:kind :actor :name "Operator"}
     :pivotal? false :unhappy-of nil :raised-by [:operator :workflow :skeptic]
     :merged-from ["Builder intervened in" "Builder session observed / intervened (steer, fork)" "Intervention recorded; result marked assisted"]
     :notes "Marks the candidate assisted. Observation alone is not an event."
     :hot-spots [:hs-assisted-comparability]}
    {:id :builder-session-ended :name "Builder session ended"
     :caused-by {:kind :system :name "Builder host"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Builder session ended"]
     :notes "Session end is not done." :hot-spots []}
    {:id :builder-session-timed-out :name "Builder session timed out"
     :caused-by {:kind :time :name "Builder session time limit"}
     :pivotal? false :unhappy-of :builder-session-ended :raised-by [:skeptic]
     :merged-from ["Builder session timed out"]
     :notes "" :hot-spots [:hs-cancel-timeout-outcome :hs-budget]}
    {:id :slice-built :name "Slice built"
     :caused-by {:kind :system :name "ORC stage"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow :skeptic]
     :merged-from ["Slice build recorded (candidate digest, uncarried list)" "Builder session ended with its slice uncarried"]
     :notes "Carries candidate digest and the uncarried list, which is the builder's claim, not evidence."
     :hot-spots [:hs-uncarried-list-steers]}
    {:id :slice-builder-continued :name "Slice builder continued"
     :caused-by {:kind :policy :name "Whenever items stay uncarried and continuations < 3, then continue the same session"}
     :pivotal? false :unhappy-of :slice-built :raised-by [:workflow :skeptic]
     :merged-from ["Slice builder continued" "Builder session continued (max three)"]
     :notes "" :hot-spots [:hs-budget]}
    {:id :continuation-stalled :name "Continuation stalled: candidate unchanged"
     :caused-by {:kind :policy :name "Whenever a continuation leaves the candidate digest unchanged, then stop continuing"}
     :pivotal? false :unhappy-of :slice-builder-continued :raised-by [:workflow]
     :merged-from ["Continuation stalled (candidate unchanged)"]
     :notes "" :hot-spots [:hs-unchanged-candidate]}
    {:id :slice-left-candidate-unchanged :name "Slice left the candidate unchanged"
     :caused-by {:kind :policy :name "Whenever a slice build leaves the candidate digest unchanged, then flag it"}
     :pivotal? false :unhappy-of :slice-built :raised-by [:workflow]
     :merged-from ["Slice left candidate unchanged"]
     :notes "Legacy driver treats it as failure." :hot-spots [:hs-unchanged-candidate]}
    {:id :candidate-regenerated :name "Candidate regenerated"
     :caused-by {:kind :system :name "ORC stage"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :workflow]
     :merged-from ["Candidate regenerated" "Candidate assembled (all slices, plan order)"]
     :notes "Each slice extends the previous slice's candidate. A claim, not done." :hot-spots []}]}

  {:id :gate
   :name "Gate"
   :kind :main
   :events
   [{:id :candidate-installed-in-gate-room :name "Candidate installed in the gate room"
     :caused-by {:kind :system :name "ORC on Gondolin"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Candidate installed into gate room"]
     :notes "The claimant never controls the judge." :hot-spots []}
    {:id :gate-attempt-passed :name "Gate attempt passed"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :workflow]
     :merged-from ["Gate passed" "Gate attempt passed"]
     :notes "Booted fresh through the launch entrypoint, identity probed, suite green. Done is the gate's verdict."
     :hot-spots [:hs-no-op-gate]}
    {:id :gate-attempt-failed :name "Gate attempt failed"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:operator :workflow :skeptic]
     :merged-from ["Gate failed" "Gate attempt failed" "Gate attempt failed; repair builder started (failure half)"]
     :notes "" :hot-spots []}
    {:id :gate-refused-no-op-suite :name "Gate refused: tool missing or no-op suite"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:skeptic :operator]
     :merged-from ["Gate refused: tool missing, no-op suite" "gate that passed without exercising the product"]
     :notes "Legacy failure. Skeptic marked pivotal." :hot-spots [:hs-no-op-gate]}
    {:id :gate-refused-empty-suite :name "Gate refused: suite discovery empty"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:skeptic]
     :merged-from ["Gate refused: empty suite discovery"]
     :notes "" :hot-spots [:hs-no-op-gate]}
    {:id :gate-refused-answered-before-boot :name "Gate refused: seam answered before boot"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:skeptic]
     :merged-from ["Gate refused: something already answered before boot"]
     :notes "Grading an orphan (legacy). Skeptic marked pivotal." :hot-spots []}
    {:id :boot-budget-exhausted :name "Boot budget exhausted"
     :caused-by {:kind :time :name "Gate boot budget"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:skeptic]
     :merged-from ["Boot budget exhausted"]
     :notes "" :hot-spots []}
    {:id :identity-probe-failed :name "Identity probe failed"
     :caused-by {:kind :system :name "Gate room"}
     :pivotal? false :unhappy-of :gate-attempt-passed :raised-by [:skeptic]
     :merged-from ["Identity probe failed"]
     :notes "A static fake (regen-3)." :hot-spots []}
    {:id :repair-builder-launched :name "Repair builder launched"
     :caused-by {:kind :policy :name "Whenever a gate attempt fails and attempts < 3, then launch a fresh repair builder"}
     :pivotal? false :unhappy-of :gate-attempt-failed :raised-by [:workflow :skeptic]
     :merged-from ["Repair builder launched" "repair builder started"]
     :notes "Fresh session with only the previous candidate and gate evidence; re-enters the regenerate loop."
     :hot-spots [:hs-leak-line :hs-repair-regression]}
    {:id :gate-attempts-exhausted :name "Gate attempts exhausted"
     :caused-by {:kind :policy :name "Whenever the third gate attempt fails, then fail the cycle without a score"}
     :pivotal? true :unhappy-of :gate-attempt-passed :raised-by [:operator :workflow :skeptic]
     :merged-from ["Gate attempts exhausted" "Third gate attempt failed; cycle failed"]
     :notes "Pivotal: ends the build loop and skips the instrument." :hot-spots [:hs-cycle-number]}]}

  {:id :score
   :name "Score"
   :kind :main
   :events
   [{:id :validation-room-started :name "Validation room started"
     :caused-by {:kind :system :name "ORC on Gondolin, with the approved sealed graders"}
     :pivotal? false :unhappy-of nil :raised-by [:workflow]
     :merged-from ["Validation room started / grader run"]
     :notes "Nothing flows back to the loop from here." :hot-spots [:hs-subject-binding]}
    {:id :runtime-signals-collected :name "Runtime signals collected"
     :caused-by {:kind :system :name "Independent validator"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Runtime signals collected, with collection completeness"]
     :notes "Candidate-authored verdict fields are forbidden." :hot-spots [:hs-runtime-evidence-gap]}
    {:id :evidence-refused-wrong-subject :name "Evidence refused: wrong cycle or candidate"
     :caused-by {:kind :system :name "Harness"}
     :pivotal? false :unhappy-of :runtime-signals-collected :raised-by [:skeptic]
     :merged-from ["Evidence refused: wrong cycle or candidate"]
     :notes "" :hot-spots [:hs-subject-binding]}
    {:id :evidence-verdict-reached :name "Evidence verdict reached"
     :caused-by {:kind :system :name "Independent invariant evaluation"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Evidence verdict reached (pass / fail / inconclusive)"]
     :notes "" :hot-spots []}
    {:id :evidence-inconclusive :name "Evidence found inconclusive"
     :caused-by {:kind :system :name "Independent invariant evaluation"}
     :pivotal? false :unhappy-of :evidence-verdict-reached :raised-by [:skeptic :instrument]
     :merged-from ["Verdict found inconclusive"]
     :notes "Incomplete collection is inconclusive, never pass; files as fail." :hot-spots [:hs-inconclusive-vs-unreached]}
    {:id :item-verdicts-filed :name "Item verdicts filed"
     :caused-by {:kind :system :name "Approved sealed grader, via the public seam"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument]
     :merged-from ["Item verdicts filed, one per checklist item"]
     :notes "" :hot-spots [:hs-subject-binding]}
    {:id :unreached-item-failed :name "Unreached item recorded as fail"
     :caused-by {:kind :policy :name "Whenever a checklist item has no verdict, then record it as fail"}
     :pivotal? false :unhappy-of :item-verdicts-filed :raised-by [:instrument :skeptic :operator]
     :merged-from ["Unreached item recorded as fail" "Unreached items recorded as fail" "Unreached items fail, stay counted"]
     :notes "Denominator never shrinks. Skeptic marked pivotal." :hot-spots [:hs-inconclusive-vs-unreached :hs-coverage-gap]}
    {:id :duplicate-verdict-superseded :name "Duplicate verdict superseded"
     :caused-by {:kind :system :name "Instrument"}
     :pivotal? false :unhappy-of :item-verdicts-filed :raised-by [:skeptic :instrument]
     :merged-from ["Duplicate verdict superseded" "Duplicate verdicts, last wins silently"]
     :notes "Contested: supersede or refuse (see disagreements)." :hot-spots [:hs-duplicate-verdicts]}
    {:id :score-refused :name "Score refused"
     :caused-by {:kind :system :name "Instrument"}
     :pivotal? false :unhappy-of :measurement-filed :raised-by [:operator :instrument :skeptic]
     :merged-from ["Score refused" "Score refused: zero verdicts / unknown ids / bad verdict value" "Score refused: zero verdicts or unknown item"]
     :notes "Zero verdicts, unknown item, bad verdict value. Nothing filed; not scored is not all failed." :hot-spots []}
    {:id :score-stage-failed :name "Score stage failed, not retried"
     :caused-by {:kind :policy :name "Whenever a score is refused, then fail the score stage and never retry it in the cycle"}
     :pivotal? false :unhappy-of :measurement-filed :raised-by [:skeptic]
