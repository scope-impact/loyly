     :notes "" :hot-spots [:hs-optimisation-holdout]}]}]

 :hot-spots
 [;; blocking: answer before the event model
  {:id :hs-crash-between-effect-and-fact :blocking? true :phase :regenerate :raised-by [:workflow :skeptic]
   :question "When ORC or the builder host dies after an effect (a tool result, a gate run) but before its fact is recorded, which side is truth, and does replay spend another of the three gate attempts?"}
  {:id :hs-relaunch-race :blocking? true :phase :regenerate :raised-by [:workflow]
   :question "If a slow original builder host and a relaunch of the same tick are both alive, what fences the old writer?"}
  {:id :hs-room-on-resume :blocking? true :phase :regenerate :raised-by [:workflow]
   :question "On resume, is the builder room reattached or rebuilt, and if rebuilt, from which workspace generation?"}
  {:id :hs-cancel-timeout-outcome :blocking? true :phase :out-of-band :raised-by [:skeptic :workflow :operator]
   :question "Is a cancelled or timed-out cycle failed, unmeasured, or partly measured; who stops live rooms; and is a committed but unreported turn lost or replayed?"}
  {:id :hs-budget :blocking? true :phase :prepare :raised-by [:operator :skeptic]
   :question "What is the outer-cycle budget (time, attempts, money), how do continuations times repairs add up, which limits sit in the approved preparation, and what happens when it runs out mid-regenerate?"}
  {:id :hs-leak-line :blocking? true :phase :gate :raised-by [:workflow :instrument]
   :question "Where exactly is the line between gate evidence (may reach a repair builder) and score evidence (never), and which part enforces and proves it: room policy, fence, or something else?"}
  {:id :hs-inconclusive-vs-unreached :blocking? true :phase :score :raised-by [:instrument :skeptic :operator]
   :question "An item verdict is only pass or fail: where does the reason (unreached, inconclusive, outage) live so an outage reads differently from a regression?"}
  {:id :hs-cycle-number :blocking? true :phase :dispatch :raised-by [:workflow]
   :question "Is a cycle numbered at submission or when it is scored (legacy); is a cycle that failed the gate an unscored cycle or no cycle?"}
  {:id :hs-builder-host-absent :blocking? true :phase :dispatch :raised-by [:workflow]
   :question "If the builder host is absent or not built, is that a failed cycle or a refusal before any cycle exists?"}
  {:id :hs-whole-plan-submission :blocking? true :phase :prepare :raised-by [:operator]
   :question "Is a whole-plan submission its own approval, and does it skip the selection and grader-digest reviews?"}
  {:id :hs-unchanged-candidate :blocking? true :phase :regenerate :raised-by [:workflow]
   :question "Is a slice that leaves the candidate unchanged a failure (legacy) or a stall that just ends continuation?"}
  {:id :hs-staleness-key :blocking? true :phase :grader :raised-by [:skeptic :instrument]
   :question "Is grader staleness keyed per item scenario digest or per slice, so that growth does not stale a grader but a reword does?"}
  {:id :hs-subject-binding :blocking? true :phase :score :raised-by [:skeptic]
   :question "What proves the validation room scores the candidate the gate ratified, and is the grader digest re-checked at score time or only at preparation?"}
  ;; can wait
  {:id :hs-assisted-comparability :blocking? false :phase :scoreboard :raised-by [:operator :skeptic]
   :question "Is an assisted candidate's score in the same scoreboard series as unassisted ones, or a separate series?"}
  {:id :hs-no-op-gate :blocking? false :phase :gate :raised-by [:operator :skeptic]
   :question "Beyond the three legacy refusals, who catches a gate that passed without exercising the product?"}
  {:id :hs-false-scored-record :blocking? false :phase :score :raised-by [:operator :skeptic]
   :question "Can an outage leave a false 'scored' record, given a filed measurement cannot be taken back?"}
  {:id :hs-grader-review-bias :blocking? false :phase :grader :raised-by [:operator]
   :question "What does the operator review before approving a grader digest without biasing later spec edits toward its tests?"}
  {:id :hs-calibration-failure-cause :blocking? false :phase :grader :raised-by [:operator]
   :question "When calibration fails three times, is the fix in the spec wording or in the calibration protocol?"}
  {:id :hs-replacement-reason-truth :blocking? false :phase :grader :raised-by [:instrument :skeptic]
   :question "Who checks that a recorded replacement reason is true, and is the additions-only diff the only enforceable test?"}
  {:id :hs-grader-author-blindness :blocking? false :phase :grader :raised-by [:instrument]
   :question "How is grader-author blindness proven rather than asserted, and are the three sealed Python graders valid until they are ported to Elixir and re-approved?"}
  {:id :hs-coverage-gap :blocking? false :phase :scoreboard :raised-by [:instrument]
   :question "With approved graders for about 17 of ~94 items, should the scoreboard also report graded coverage so a low rate is not read as the candidate's quality alone?"}
  {:id :hs-runtime-evidence-gap :blocking? false :phase :score :raised-by [:instrument]
   :question "The runtime-evidence contract has no collection-completeness accounting or inconclusive outcome yet; when is that gap closed?"}
  {:id :hs-planned-slice-filter :blocking? false :phase :prepare :raised-by [:instrument]
   :question "Can demoting a slice in the plan shrink the denominator with only a stderr warning?"}
  {:id :hs-self-check-coverage :blocking? false :phase :fence :raised-by [:instrument]
   :question "Does self-check reuse keyed on the harness digest also cover grader digests and the capture policy?"}
  {:id :hs-scoring-tools-fenced :blocking? false :phase :fence :raised-by [:operator :instrument]
   :question "Should scoring tools be fenced from the clean room?"}
  {:id :hs-duplicate-verdicts :blocking? false :phase :score :raised-by [:instrument :skeptic]
   :question "Should a grader that emits duplicate verdicts be refused instead of the last one silently winning?"}
  {:id :hs-oracle-naming :blocking? false :phase :score :raised-by [:instrument]
   :question "Legacy files still say 'oracle' for three different things; when are they renamed to glossary terms?"}
  {:id :hs-evaluation-judges-misread :blocking? false :phase :scoreboard :raised-by [:instrument]
   :question "How do we stop ORC evaluation-judge scores (diagnostics only) being read as the measurement?"}
  {:id :hs-spec-learning-vs-tuning :blocking? false :phase :conclude :raised-by [:operator]
   :question "After reading scores and editing the spec, where does learning from the spec end and tuning to the grader begin?"}
  {:id :hs-optimisation-holdout :blocking? false :phase :prompt-optimisation :raised-by [:skeptic]
   :question "What does prompt optimisation measure on, and who keeps a set it has never seen?"}
  {:id :hs-worker-redispatch :blocking? false :phase :out-of-band :raised-by [:workflow :operator]
   :question "Does a replacement ORC worker re-dispatch the builder launch for an in-flight tick, and does the operator see one task or two?"}
  {:id :hs-credential-leak :blocking? false :phase :regenerate :raised-by [:workflow]
   :question "Can tool output (logs, environment) leak host state or credentials into the builder transcript?"}
  {:id :hs-uncarried-list-steers :blocking? false :phase :regenerate :raised-by [:workflow]
   :question "The uncarried list lives in the scope the builder writes and decides continuations: is the builder allowed to steer the loop's length?"}
  {:id :hs-repair-regression :blocking? false :phase :gate :raised-by [:workflow]
   :question "The repair budget counts across the whole candidate: what catches a repair that regresses an earlier slice?"}
  {:id :hs-preparation-expiry :blocking? false :phase :prepare :raised-by [:skeptic]
   :question "Does an unapproved or unsubmitted preparation expire if the operator walks away?"}]

 :contexts
 [{:id :specification :name "Specification"
   :owns [:scenario-stamped :unstamped-scenario-found]
   :upstream-of [:cycle-preparation :grader-lifecycle :measurement]
   :relationship "Open host with a published language (item identity, scenario digest, stamped item); every other context conforms."
   :handoffs [:scenario-stamped]}
  {:id :cycle-preparation :name "Cycle preparation (operator control)"
   :owns [:source-cut-pinned :slice-proposed :selection-contract-presented :selection-approved :approval-refused
          :cycle-preparation-approved :cycle-submitted :receipt-issued :duplicate-submission-answered :submission-refused
          :intervention-recorded :cycle-cancelled :operator-session-disconnected :continuation-decided :child-cycle-prepared]
   :upstream-of [:regeneration-cycle :measurement]
   :relationship "Customer-supplier to the regeneration cycle: the approved preparation is the only crossing, immutable. Downstream of the measurement only through a person reading the scoreboard."
   :handoffs [:cycle-submitted :selection-approved]}
  {:id :grader-lifecycle :name "Grader lifecycle"
   :owns [:grader-requested :instrument-golden-written :grader-authored :grader-calibrated :grader-discarded
          :instrument-declared-unavailable :grader-sealed :grader-digest-approved :grader-reused :grader-found-stale
          :grader-replaced :grader-replacement-refused :instrument-golden-moved]
   :upstream-of [:cycle-preparation :measurement]
   :relationship "Own clock, no cycle. Supplies approved grader digests the preparation binds and the measurement uses; conforms to the specification."
   :handoffs [:grader-digest-approved]}
  {:id :regeneration-cycle :name "Regeneration cycle (harness: fence and gate)"
   :owns [:cycle-started :self-check-passed :self-check-failed :clean-room-proved :fence-refused-empty-path
          :prior-implementation-reachable :builder-room-started :builder-session-launched :slice-built
          :slice-builder-continued :continuation-stalled :slice-left-candidate-unchanged :candidate-regenerated
          :candidate-installed-in-gate-room :gate-attempt-passed :gate-attempt-failed :gate-refused-no-op-suite
          :gate-refused-empty-suite :gate-refused-answered-before-boot :boot-budget-exhausted :identity-probe-failed
          :repair-builder-launched :gate-attempts-exhausted :cycle-passed :cycle-failed :cycle-timed-out
          :orc-worker-replaced :model-drift-found]
   :upstream-of [:builder-session :measurement]
   :relationship "Owns stage order, room choice and the repair policy. Translates ORC facts through an anticorruption layer; hands the gated candidate to the measurement one-way (nothing flows back)."
   :handoffs [:gate-attempt-passed :builder-session-launched :repair-builder-launched]}
  {:id :builder-session :name "Builder session (durable)"
   :owns [:tool-result-committed :out-of-scope-access-refused :builder-session-interrupted :builder-session-resumed
          :resume-refused :builder-session-ended :builder-session-timed-out]
   :upstream-of [:regeneration-cycle]
   :relationship "Joined to the regeneration cycle by the tick. Conforms to the cycle's production prompt and room; reports only committed turns and the session end back, never a verdict."
   :handoffs [:builder-session-ended]}
  {:id :measurement :name "Measurement (instrument: score and scoreboard)"
   :owns [:checklist-derived :empty-selection-refused :validation-room-started :runtime-signals-collected
          :evidence-refused-wrong-subject :evidence-verdict-reached :evidence-inconclusive :item-verdicts-filed
          :unreached-item-failed :duplicate-verdict-superseded :score-refused :score-stage-failed :measurement-filed
          :moved-item-set-restated :scoreboard-reported]
   :upstream-of [:prompt-optimisation]
   :relationship "Downstream of preparation (checklist), grader lifecycle (digest) and the cycle (gated candidate). Reports to a person only; never upstream of the build loop."
   :handoffs [:scoreboard-reported :measurement-filed]}
  {:id :prompt-optimisation :name "Prompt optimisation"
   :owns [:instruction-candidate-selected :instruction-candidate-rejected-overfit]
   :upstream-of [:regeneration-cycle]
   :relationship "Outside every cycle. Consumes independent measurements; supplies a selected builder instruction that a new approved preparation pins. Must stay away from the checklist it is judged on."
   :handoffs [:instruction-candidate-selected]}]

