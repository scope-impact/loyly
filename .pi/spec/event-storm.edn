     :notes "Newly passing and newly failing separately; new items are the untuned holdout; never a net."
     :hot-spots [:hs-assisted-comparability :hs-coverage-gap :hs-evaluation-judges-misread]}]}

  {:id :conclude
   :name "Conclude and after the cycle"
   :kind :main
   :events
   [{:id :cycle-passed :name "Cycle passed"
     :caused-by {:kind :policy :name "Whenever the scoreboard is reported, then conclude the cycle once"}
     :pivotal? true :unhappy-of nil :raised-by [:operator :workflow]
     :merged-from ["Cycle passed / failed" "Cycle concluded (passed / failed)"]
     :notes "Recorded once, when ORC completes the task." :hot-spots []}
    {:id :cycle-failed :name "Cycle failed"
