     :caused-by {:kind :actor :name "Operator"}
     :pivotal? false :unhappy-of nil :raised-by [:skeptic]
     :merged-from ["Operator session disconnected; cycle continued"]
     :notes "A cycle never dies with a laptop." :hot-spots []}
    {:id :orc-worker-replaced :name "ORC worker replaced; task answered from durable state"
     :caused-by {:kind :system :name "ORC"}
     :pivotal? false :unhappy-of nil :raised-by [:skeptic :workflow :operator]
     :merged-from ["ORC worker replaced; wait answered from durable state" "Process restart of the harness" "A replaced ORC worker"]
