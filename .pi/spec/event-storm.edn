  {:id :scoreboard
   :name "Scoreboard"
   :kind :main
   :events
   [{:id :moved-item-set-restated :name "Moved item set restated"
     :caused-by {:kind :policy :name "Whenever the denominator differs from the previous cycle, then restate it on shared items"}
     :pivotal? false :unhappy-of nil :raised-by [:instrument :operator]
