  {:id :prompt-optimisation
   :name "Prompt optimisation (parallel stream, outside the cycle)"
   :kind :parallel
   :events
   [{:id :instruction-candidate-selected :name "Instruction candidate selected"
     :caused-by {:kind :system :name "Prompt optimisation (GEPA, reflection model)"}
     :pivotal? false :unhappy-of nil :raised-by [:skeptic]
     :merged-from []
     :notes "Facilitator added the happy counterpart from the glossary so the rejection has something to diverge from."
     :hot-spots [:hs-optimisation-holdout]}
    {:id :instruction-candidate-rejected-overfit :name "Instruction candidate rejected as overfit"
     :caused-by {:kind :system :name "Prompt optimisation"}
     :pivotal? false :unhappy-of :instruction-candidate-selected :raised-by [:skeptic]
