;; .pi/spec/measurement/event-model/scoreboard.edn: aggregate Scoreboard, in the harness's
;; event store (one per measured cycle). Reports to a person: the rate, and against the
;; previous measured cycle only the shared items, newly passing and newly failing apart, new
;; items as the untuned holdout, never a net. Legacy: scoreboard.clj.
;;
;; Refusals of report-scoreboard (requires, ../allium/scoreboard.allium): no measurement
;; filed for the cycle; already reported. R2: the previous cycle is the last measured cycle
;; of the same selection (decisions.md g); rates have one decimal, half to even, "n/a" over
;; zero ("to add" 6).
{:measurement
 {:commands
  {:measurement/report-scoreboard
   {:description "Report the cycle's scoreboard against the last measured cycle of the same selection; restate it on the shared items when the item set moved. Issued by: the report-scoreboard-once policy."
    :grain/allium [{:spec ".pi/spec/measurement/allium/scoreboard.allium" :kind :rule :name "ReportScoreboard"}]
    :schema [:map [:cycle-id :string]]
    :reads #{:measurement/cycle-measurements :measurement/scoreboards}
    :produces #{:measurement/scoreboard-reported :measurement/moved-item-set-restated}}}
  :events
  {:measurement/scoreboard-reported
   {:description "The cycle's scoreboard was reported to a person: its rate, and against the last measured cycle of the same selection (decisions.md g: the same selected slices by name, across cuts; whole-plan with whole-plan) the shared items' rates, newly passing and newly failing items apart, new items as the untuned holdout and dropped items. No net is computed. A baseline cycle has no previous cycle. A rate has one decimal, rounded half to even, and is \"n/a\" over zero."
    :schema [:map
             [:cycle-id :string]
             [:selection-id :string]
             [:passes :int]
             [:total pos-int?]
             [:rate :string]
             [:previous-cycle-id [:maybe :string]]
             [:previous-selection-id [:maybe :string]]
             [:shared {:optional true} [:map
                                        [:items :int]
                                        [:previous-passes :int]
                                        [:passes :int]
                                        [:previous-rate :string]
                                        [:rate :string]
                                        [:newly-passing [:vector :string]]
                                        [:newly-failing [:vector :string]]]]
             [:new-items [:vector :string]]
             [:dropped-items [:vector :string]]
             [:reported-at inst?]]}
   :measurement/moved-item-set-restated
   {:description "The item set moved since the last measured cycle of the same selection, so the two headline rates count different things; the comparison is restated on the shared items only."
    :schema [:map
             [:cycle-id :string]
             [:previous-cycle-id :string]
             [:previous-total pos-int?]
             [:total pos-int?]
             [:added :int]
             [:dropped :int]
             [:restated-at inst?]]}}
  :read-models
  {:measurement/measurements-to-report
   {:description "The report-scoreboard-once policy's to-do list: filed measurements with no scoreboard yet."
    :consumes #{:measurement/measurement-filed :measurement/scoreboard-reported}}
   :measurement/scoreboards
   {:description "Each measured cycle's scoreboard, with its restatement when the item set moved."
    :grain/allium [{:spec ".pi/spec/measurement/allium/scoreboard.allium" :kind :entity :name "Scoreboard"}]
    :consumes #{:measurement/scoreboard-reported :measurement/moved-item-set-restated}}}
  :queries
  {:measurement/measurements-to-report
   {:description "The report-scoreboard-once policy's to-do list."
    :schema [:map]
    :reads #{:measurement/measurements-to-report}}
   :measurement/scoreboard
   {:description "One cycle's scoreboard."
    :schema [:map [:cycle-id :string]]
    :reads #{:measurement/scoreboards}}}
  :todo-processors
  {:measurement/report-scoreboard-once
   {:description "Whenever a measurement is filed, report its scoreboard, once."
    :grain/allium [{:spec ".pi/spec/measurement/allium/scoreboard.allium" :kind :rule :name "ReportScoreboardOnce"}]
    :subscribes #{:measurement/measurement-filed}
    :reads #{:measurement/measurements-to-report}
    :produces #{:measurement/report-scoreboard}}}}}
