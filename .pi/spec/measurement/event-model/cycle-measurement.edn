;; .pi/spec/measurement/event-model/cycle-measurement.edn: aggregate CycleMeasurement, in
;; the harness's event store (one per cycle). The approved sealed grader files item verdicts;
;; the instrument files the one measurement, with every checklist item: an unreached item
;; fails and stays counted. A false record cannot be untaken, so a doubtful one is refused.
;; Legacy: score.clj.
;;
;; The refusals are requires, not events (storm: "Score refused"; ../allium/cycle-measurement.allium).
;; Of file-item-verdicts: not the gated candidate (H13), no checklist, zero verdicts, a bad
;; verdict value (before an unknown item, decisions.md), an unknown item, already filed,
;; stage failed, a grader digest not approved (H13), a bad reason (H7). Of file-score: not
;; gated, zero verdicts filed, already filed, stage failed, a grader digest no longer
;; approved, a filing for another candidate (H13). The approved grader digests are an input
;; fact until the grader lifecycle's approval arrives. A verdict carries a reason beside a
;; fail (H7).
{:measurement
 {:commands
  {:measurement/file-item-verdicts
   {:description "File the verdicts one approved sealed grader returned for the gated candidate of a cycle, having driven it only over its public seam in a validation room. Issued by: the grader (its run reported by ORC runtime)."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :rule :name "FileItemVerdicts"}]
    :schema [:map
             [:cycle-id :string]
             [:candidate-digest :string]
             [:grader-digest :string]
             [:approved-grader-digests [:vector :string]]
             [:verdicts [:vector [:map
                                  [:item-id :string]
                                  [:verdict :string]
                                  [:reason {:optional true} :string]
                                  [:evidence {:optional true} :string]]]]]
    :reads #{:measurement/gated-cycles :measurement/checklists :measurement/cycle-measurements}
    :produces #{:measurement/item-verdicts-filed}}
   :measurement/file-score
   {:description "File the cycle's one measurement from the verdicts filed: every checklist item, the last verdict for an item superseding an earlier one, and an item with no verdict recorded as fail with reason unreached. Issued by: ORC runtime (the score node), once its grader runs are done."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :rule :name "FileScore"}]
    :schema [:map
             [:cycle-id :string]
             [:approved-grader-digests [:vector :string]]]
    :reads #{:measurement/gated-cycles :measurement/checklists :measurement/item-verdicts :measurement/cycle-measurements}
    :produces #{:measurement/measurement-filed}}
   :measurement/fail-score-stage
   {:description "Record that the cycle's score stage failed because its score was refused; it is never retried within the cycle. Issued by: ORC runtime (the score node)."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :rule :name "FailScoreStage"}]
    :schema [:map
             [:cycle-id :string]
             [:refusal [:enum "not-the-gated-candidate" "no-checklist" "zero-verdicts" "bad-verdict-value" "unknown-item"
                        "grader-not-approved" "bad-verdict-reason"]]
             [:detail :string]]
    :reads #{:measurement/gated-cycles :measurement/cycle-measurements}
    :produces #{:measurement/score-stage-failed}}}
  :events
  {:measurement/measurement-filed
   {:description "A cycle's one measurement was filed: a pass or fail verdict for every checklist item, the denominator of its checklist, unreached items failed with their reason, and any verdict superseded by a later one for the same item. It cannot be untaken."
    :schema [:map
             [:cycle-id :string]
             [:cut-id :string]
             [:selection-id :string]
             [:candidate-digest :string]
             [:checklist-digest :string]
             [:grader-digests [:vector {:min 1} :string]]
             [:total pos-int?]
             [:passes :int]
             [:unreached :int]
             [:items [:vector {:min 1} [:map
                                        [:item-id [:re "^[0-9]+-[0-9]{3,}$"]]
                                        [:verdict [:enum "pass" "fail"]]
                                        [:reason {:optional true} [:enum "unreached" "inconclusive" "outage"]]
                                        [:evidence :string]]]]
             [:superseded [:vector [:map [:item-id :string] [:grader-digest :string] [:verdict [:enum "pass" "fail"]]]]]
             [:filed-at inst?]]}
   :measurement/score-stage-failed
   {:description "The cycle's score was refused, so no measurement was filed and the score stage failed; it is not retried within the cycle. Not scored is not all failed."
    :schema [:map
             [:cycle-id :string]
             [:refusal [:enum "not-the-gated-candidate" "no-checklist" "zero-verdicts" "bad-verdict-value" "unknown-item"
                        "grader-not-approved" "bad-verdict-reason"]]
             [:detail :string]
             [:failed-at inst?]]}
   :measurement/item-verdicts-filed
   {:description "One grader's verdicts for a cycle's gated candidate were filed, as returned: pass or fail per item, duplicates included. A verdict offered without evidence is filed with empty evidence, \"\" (invariant EvidenceDefaultsEmpty)."
    :schema [:map
             [:cycle-id :string]
             [:candidate-digest :string]
             [:grader-digest :string]
             [:verdicts [:vector {:min 1} [:map
                                           [:item-id [:re "^[0-9]+-[0-9]{3,}$"]]
                                           [:verdict [:enum "pass" "fail"]]
                                           [:reason {:optional true} [:enum "inconclusive" "outage"]]
                                           [:evidence :string]]]]
             [:filed-at inst?]]}}
  :read-models
  {:measurement/gated-cycles
   {:description "Each cycle the gate ratified: its cut and the candidate digest the score must bind."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :entity :name "CycleMeasurement"}]
    :consumes #{:regeneration-cycle/gate-attempt-passed}}
   :measurement/item-verdicts
   {:description "Each cycle's filed verdicts, in filing order, per grader."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :entity :name "VerdictFiling"}]
    :consumes #{:measurement/item-verdicts-filed}}
   :measurement/cycle-measurements
   {:description "Each cycle's filed measurement, or its failed score stage: the durable measurement receipt an operator reads."
    :grain/allium [{:spec ".pi/spec/measurement/allium/cycle-measurement.allium" :kind :entity :name "CycleMeasurement"}]
    :consumes #{:measurement/measurement-filed :measurement/score-stage-failed}
    :schema [:map
             [:cycle-id :string]
             [:status [:enum "filed" "score-stage-failed"]]
             [:cut-id {:optional true} :string]
             [:candidate-digest {:optional true} :string]
             [:total {:optional true} pos-int?]
             [:passes {:optional true} :int]
             [:unreached {:optional true} :int]
             [:items {:optional true} [:vector [:map [:item-id :string] [:verdict [:enum "pass" "fail"]]
                                                [:reason {:optional true} [:enum "unreached" "inconclusive" "outage"]] [:evidence :string]]]]
             [:refusal {:optional true} :string]]}}
  :queries
  {:measurement/cycle-measurement
   {:description "One cycle's measurement receipt."
    :schema [:map [:cycle-id :string]]
    :reads #{:measurement/cycle-measurements}}}}}
