;; .pi/spec/cycle-preparation/event-model/handoffs.edn: the events Cycle preparation hands
;; to other contexts. source-cut-pinned goes to Measurement (pinned-cuts: a checklist is
;; derived from a pinned cut) and to the Regeneration cycle (pinned-cuts: a cycle fences a
;; pinned cut). Later rounds add selection-approved and cycle-submitted here.
{:cycle-preparation
 {:events
  {:cycle-preparation/source-cut-pinned
   {:description "A source cut was pinned: one commit and its tree content, immutable from now on."
    :schema [:map
             [:cut-id :string]
             [:commit [:re "^[0-9a-f]{40,64}$"]]
             [:tree-digest :string]
             [:pinned-at inst?]]}}}}
