-- allium: 3
-- .pi/spec/cycle-runner/allium/cycle-run.allium
--
-- Aggregate CycleRun, on the one store: one per run (event-model/cycle-run.edn). A run is one
-- tick of the tree cycle-runner/cycle.v1. It performs one cycle's effects in the real world
-- (a git repository read, a clean room built, a builder session run and waited for, a gate
-- run, each item graded by the judge) and records each effect's result into the context
-- that owns it, by that context's command on the one store. Its own facts are only that:
-- which effect was performed and what the context answered, and how the run ended. Drafted
-- in decisions.md "Slice 06 (draft)", accepted in "Spec round 7b", rewritten as cycle.v1 in
-- "Spec round 18".
--
-- Legacy: the operator's hands between the legacy tools (archive/legacy-harness/README.md,
-- "A cycle"): fence.sh, a builder session, verify.sh, a grading subagent's verdicts file,
-- score.clj, scoreboard.clj.

use "context.allium" as ctx

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The person who starts a run.
external entity OperatorAccount {}

-- ORC's workflow worker: runs the leaves of the tree cycle.v1 and of the workflows it
-- delegates to (seam.md, "The tree").
external entity OrcWorker {}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CycleRun {
    run_id: String
    cycle_id: String
    cut_id: String
    commit: String
    selection_id: String
    budget: ctx.RunBudget
    grader_digests: Set<String>
    status: running | run_passed | run_failed | halted
    -- Effects recorded so far; the next is recorded at position effects + 1.
    effects: Integer
    -- Candidates regenerated so far.
    attempts: Integer
    candidate_digest: String?
    gate_passed: Boolean
    -- The judge's scores were offered to Measurement: the score stage began.
    scoring_begun: Boolean
    -- Measurement recorded the score.
    scored: Boolean
    -- The cycle's conclusion as the Regeneration cycle shows it.
    cycle_status: String?
    halt_reason: ctx.HaltReason when status = halted

    in_progress: status = running

    -- The cycle concluded in the Regeneration cycle, and the run has not yet.
    awaits_conclusion: in_progress and cycle_status_of(cycle_id) != "running"

    transitions status {
        running -> run_passed
        running -> run_failed
        running -> halted
        terminal: run_passed, run_failed, halted
    }
}

-- One effect a leaf performed, and what the context answered: recorded once, at its
-- position in the run.
entity EffectResult {
    run: CycleRun
    position: Integer
    effect: ctx.Effect
    attempt: Integer
    context: String
    method: String
    outcome: ctx.EffectOutcome
    refusal: String?
    detail: String
    -- Whether the score stage had begun when the effect was performed.
    after_scoring: Boolean
    performed_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Start a run of one cycle: the cut's commit, the selection, the budget and the approved
-- grader digests. The run is one tick of cycle.v1 on the one store. Issued by the operator.
rule StartRun {
    when: StartRun(operator, run_id, cycle_id, cut_id, commit, selection_id, budget, grader_digests)
    -- 1. the run identity is taken: a second start records nothing
    requires: not exists CycleRun{run_id: run_id}
    -- 2. another run is in progress: one run at a time (one port, one builder)
    requires: not exists CycleRun{status: running}
    -- 3. the cycle was run before: a cycle is numbered once (decisions.md H8)
    requires: not exists CycleRun{cycle_id: cycle_id}
    -- 4. not a commit of the project repository
    requires: is_commit(commit)
    -- 5. the configuration names a builder image the builder images directory does not
    --    hold (decisions.md, "Spec round 9" D2)
    requires: builder_image_present(run_id)
    ensures:
        CycleRun.created(run_id: run_id, cycle_id: cycle_id, cut_id: cut_id, commit: commit, selection_id: selection_id, budget: budget, grader_digests: grader_digests, status: running, effects: 0, attempts: 0, candidate_digest: null, gate_passed: false, scoring_begun: false, scored: false, cycle_status: null)
        RunStarted(run_id: run_id, cycle_id: cycle_id, cut_id: cut_id, commit: commit, selection_id: selection_id)
}

-- Record one effect's result: the context command it was recorded through and what the
-- context answered. Issued by the leaf named for the effect, after it performed the effect.
-- Filing the judge's scores begins the score stage: no builder runs after it.
rule RecordEffect {
    when: RecordEffect(runner, run_id, effect, attempt, context, method, outcome, refusal?, detail)
    let run = CycleRun{run_id: run_id}
    -- 1. the run is not running: one that concluded or halted performs no effect
    requires: run.status = running
    ensures:
        EffectResult.created(run: run, position: run.effects + 1, effect: effect, attempt: attempt, context: context, method: method, outcome: outcome, refusal: refusal, detail: detail, after_scoring: run.scoring_begun, performed_at: now)
        run.effects = run.effects + 1
        if outcome = recorded and (effect = regenerate or effect = repair):
            run.attempts = attempt
        if outcome = recorded and effect = gate and gate_attempt_passed(run.cycle_id, attempt):
            run.gate_passed = true
        if effect = file_verdicts:
            run.scoring_begun = true
        if outcome = recorded and effect = file_score:
            run.scored = true
        EffectRecorded(run_id: run_id, position: run.effects, effect: effect, attempt: attempt, context: context, method: method, outcome: outcome, refusal: refusal, detail: detail)
}

-- The cycle concluded in the Regeneration cycle (its own policy, its stage clock, or the
-- runner's fail-cycle effect): a conclude leaf concludes the run as the cycle did. The
-- leaves read the cycle's progress after each recording that may conclude it (seam.md, "The
-- tree").
rule ConcludeWithTheCycle {
    when: run: CycleRun.awaits_conclusion
    requires: run.status = running
    ensures: ConcludeRun(run_id: run.run_id, cycle_status: cycle_status_of(run.cycle_id))
}

-- The cycle passed, after its score was filed: the run passes.
rule ConcludeRunPassed {
    when: ConcludeRun(run_id, cycle_status)
    let run = CycleRun{run_id: run_id}
    -- 1. the run is not running
    requires: run.status = running
    -- 2. the cycle did not pass
    requires: cycle_status = "passed"
    ensures:
        run.cycle_status = cycle_status
        run.status = run_passed
        RunConcluded(run_id: run_id, cycle_id: run.cycle_id, cycle_status: cycle_status)
}

-- The cycle failed, at whichever stage: the run fails with it. The cycle's stage, reason
-- and detail are the Regeneration cycle's, shown as it shows them.
rule ConcludeRunFailed {
    when: ConcludeRun(run_id, cycle_status)
    let run = CycleRun{run_id: run_id}
    -- 1. the run is concluded or halted
    requires: run.status = running
    -- 2. the cycle did not fail
    requires: cycle_status = "failed"
    ensures:
        run.cycle_status = cycle_status
        run.status = run_failed
        RunConcluded(run_id: run_id, cycle_id: run.cycle_id, cycle_status: cycle_status)
}

-- An effect could not be performed at all (a handed-in command could not be started, a gate
-- command said the gate could not be performed, a node that calls the model failed), so
-- nothing is recorded for it; or a gate the context refused for a reason that leaves no next
-- step (seam.md, "The tree", what a leaf writes; decisions.md, "Spec round 12" D2, D3); or
-- the stamp, the pin or the checklist was refused before the cycle opened, the stamp handed
-- out identities that are not the plan's own (decisions.md, "Spec round 7b" 2), or the
-- sealed grader is not approved, so there is no cycle to fail. The run halts, loudly. A
-- halt is the runner's fact, never the cycle's conclusion.
rule HaltRun {
    when: HaltRun(runner, run_id, effect, reason, detail)
    let run = CycleRun{run_id: run_id}
    -- 1. the run is concluded or halted
    requires: run.status = running
    ensures:
        run.status = halted
        run.halt_reason = reason
        RunHalted(run_id: run_id, effect: effect, reason: reason, detail: detail)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneRunPerIdentity {
    for a in CycleRuns:
        for b in CycleRuns:
            a != b implies a.run_id != b.run_id
}

-- A cycle is run once: its number is not reused by a later run (decisions.md H8).
invariant OneRunPerCycle {
    for a in CycleRuns:
        for b in CycleRuns:
            a != b implies a.cycle_id != b.cycle_id
}

-- One run at a time.
invariant OneRunInProgress {
    for a in CycleRuns:
        for b in CycleRuns:
            a != b and a.in_progress implies not b.in_progress
}

-- An effect result is recorded once, at its own position: a replayed effect, a resumed one
-- among them, records nothing.
invariant OneResultPerPosition {
    for a in EffectResults:
        for b in EffectResults:
            a != b and a.run = b.run implies a.position != b.position
}

-- Score evidence never reaches a builder: no builder runs once the score stage began.
invariant NoBuilderAfterTheScoring {
    for e in EffectResults:
        (e.effect = regenerate or e.effect = repair) implies not e.after_scoring
}

-- A run passes only as its cycle passed, which needs the score filed.
invariant PassedOnlyWithAScore {
    for r in CycleRuns:
        r.status = run_passed implies (r.scored and r.cycle_status = "passed")
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor Operator {
    identified_by: OperatorAccount where true
}

actor CycleRunner {
    identified_by: OrcWorker where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The operator's run desk (screen run-desk): start a run, observe its effects, its tick,
-- its items' scores and how it ended.
surface RunDesk {
    facing operator: Operator
    context run: CycleRun

    exposes:
        run.run_id
        run.cycle_id
        run.cut_id
        run.status
        run.effects
        run.attempts
        run.candidate_digest
        run.cycle_status
        run.halt_reason when run.status = halted

    provides:
        StartRun(operator, run_id, cycle_id, cut_id, commit, selection_id, budget, grader_digests)

    contracts:
        fulfils ProjectRepository

    @guarantee TheRunnerJudgesNoItem
        -- Every item verdict filed is the judge's score of that item, filed as scored; an
        -- item the judge did not score is Measurement's to file as an unreached fail,
        -- never the runner's to judge.

    @guarantee ObservingChangesNothing
        -- Reading a run's progress records nothing and performs no effect.

    @guarantee CarriesItsOwnEventModel
        -- The runner carries a copy of the one event model it registers (every context's
        -- event-model/*.edn), byte for byte as its room gave them, in its own folder, and
        -- reads no file outside its folder to run: a copy of it started anywhere, with no
        -- spec around it, runs a cycle (seam.md, "The build"; decisions.md, "Spec round
        -- 16" D6).

    @guarantee TheCandidateHoldsOnlyItsBuild
        -- The candidate's folder holds its entrypoints, build file, sources, tests and their
        -- fixtures, its copy of the event models and its notes: no copy of ORC's or Grain's
        -- sources and no builder scratch (seam.md, "The build"; decisions.md, "Spec round
        -- 16" D7). Verified by: gate candidate-contents (planned; checked by the final judge
        -- at acceptance until then).
}

-- The leaves of cycle.v1 and of the workflows it delegates to, one per effect or command:
-- perform an effect, record its result into a context, grade an item, conclude or halt the
-- run (seam.md, "The tree"; decisions.md, "Spec round 14" and "Spec round 18").
surface EffectNodes {
    facing runner: CycleRunner
    context run: CycleRun

    exposes:
        run.status

    provides:
        RecordEffect(runner, run_id, effect, attempt, context, method, outcome, refusal?, detail)
        HaltRun(runner, run_id, effect, reason, detail)

    contracts:
        fulfils OneStore
        fulfils BuilderSession
        fulfils GateOnTheHost
        fulfils TheJudge

    @guarantee OwnsNoContextRule
        -- The runner performs effects and records; it owns no rule the five contexts own.
        -- What a context refused is shown as that context's refusal, and the run ends as
        -- its cycle ends in the Regeneration cycle.

    @guarantee EachEffectInItsOwnLeaf
        -- The flow is one ORC tree, cycle.v1, and each effect or command it performs is a
        -- leaf of its own, named for it (seam.md, "The tree"; event-model/area.edn, :leaf).
        -- Every event the runner records lies between the start and the completion of the
        -- leaf its step names, in the run's tick of cycle.v1 or a child tick that tick
        -- delegated, in the one store: an effect result inside the leaf named for its
        -- effect. A flow run as one leaf around the runner's own orchestration does not
        -- hold it. The gate's store check reads it, and so does @item-06-059.

    @guarantee EachGateAttemptOneDelegatedTick
        -- A gate attempt (its install, its self-check, its gates and gate refusals, and the
        -- repair that follows a failed attempt the cycle allows) is one subtree, the
        -- versioned workflow cycle-runner/gate-attempt.v1, delegated from cycle.v1 once per
        -- attempt, so each attempt runs as one child tick of the run's tick. No attempt is
        -- written out in cycle.v1 itself (seam.md, "The tree"; decisions.md, "Spec round
        -- 16" D3).

    @guarantee EachItemGradedInItsOwnTick
        -- Each checklist item is graded by the sealed grader, the versioned workflow
        -- cycle-runner/grade.v1, delegated once per item over the checklist, so each item
        -- runs as one child tick of the run's tick: its evidence cleared, the researcher
        -- driving the seam, the judge scoring it.

    @guarantee AStoppedRunResumes
        -- When the runner starts on the one store, every run in progress there resumes
        -- where it stopped, in its own tick (ORC's resume-in-progress!): what the run
        -- recorded before it stopped stands, and no effect is recorded twice. A run is
        -- never started again to recover it.

    @guarantee TheBlackboardIsTheRunsState
        -- The run's state is its tree's blackboard: each leaf is a function of its own,
        -- computes from the keys it reads and the world, and hands on only the keys it
        -- writes, as seam.md's table of leaves declares them. Only live handles (a builder
        -- session, a gate's program, the grading VM) are kept outside it (seam.md, "The
        -- tree"; decisions.md, "Spec round 16" D1, D2). Verified by: gate leaf-contract
        -- (planned; ORC records each node's reads, writes and function in the store).

    @guarantee EveryWaitHasABound
        -- A leaf holds the bound of what it waits for (a program within its stage's
        -- timeout, a model's reply), each delegate is bounded by the stages its subtree
        -- spends, and each tick by the run's budget and tick_margin_seconds; a tick that
        -- does not end with success halts the run (seam.md, "The tree"; decisions.md, "Spec
        -- round 16" D5). Verified by: gate leaf-contract (planned).

    @guarantee TheGateRoomIsNotTheBuilders
        -- The gate room is the runner's, never the builder's. Verified by: gate
        -- room-policy (planned; regeneration-cycle/domain-design.md, "Checks").
}
