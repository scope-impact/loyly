-- allium: 3
-- .pi/spec/cycle-runner/allium/context.allium
--
-- Scope: the shared language of the Cycle runner (slice 06; drafted in spec round 7a,
--        accepted in spec round 7b, rewritten as the one tree cycle-runner/cycle.v1 in spec
--        round 18, decisions.md "Spec round 18"): the ORC workflow that performs a
--        cycle's effects in the real world and records each effect's result into the
--        context that owns it, by that context's command on the one store. It owns no rule
--        of the five contexts: every refusal it shows is a context's, as heard, and a run
--        ends as its cycle ends.
--
-- One run, one tick of cycle.v1, in the legacy shape (archive/legacy-harness/README.md):
--     stamp, pin, checklist, the sealed grader -> self-check -> fence -> the builder
--     instruction -> regenerate -> install, self-check, gate (repair, at most three
--     attempts) -> grade each item -> file the verdicts, file the score -> the cycle
--     concludes
-- The six contexts are one candidate on one store; there is no relay, hand-in method or
-- handoff contract.
--
-- Aggregates (one file; .pi/spec/cycle-runner/event-model/):
--   CycleRun  cycle-run.allium  one per run; its effect results

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The budget a run carries, handed to the Regeneration cycle with its first self-check,
-- unchanged (regeneration-cycle Budget; decisions.md H5).
value RunBudget {
    gate_attempt_limit: Integer
    max_outer_cycles: Integer
    max_continuations: Integer
    fence_timeout: Duration
    regenerate_timeout: Duration
    gate_timeout: Duration
    score_timeout: Duration
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The five contexts, in the one candidate, on the one store: the runner's leaves issue their
-- commands and read their queries there (decisions.md, "Spec round 18").
contract OneStore {
    cycle_status_of: (cycle_id: String) -> String
    gate_attempt_passed: (cycle_id: String, attempt: Integer) -> Boolean

    @invariant OnlyThroughTheCommands
        -- The runner records into a context only by issuing a command of that context, and
        -- reads a context only through its queries. It never appends another context's
        -- event itself, and no event is copied from one context to another: each is
        -- appended once, by its producer's command, and every context that folds it reads
        -- it from the one store.

    @invariant RefusalsAreTheContexts
        -- Every refusal of a recording is the context's reply, recorded as heard: the
        -- refusal code of its rule, never re-derived. The runner does not decide what a
        -- context would refuse, and does not skip a recording because it expects one.

    @invariant MeasurementKeepsItsHistory
        -- The one store is kept across runs, so Measurement keeps every measured cycle and
        -- a scoreboard compares a cycle with the last measured cycle of the same selection
        -- across runs (AGENTS.md, the scoreboard; measurement contract Comparison,
        -- LastMeasuredCycleOfTheSameSelection; decisions.md, "Spec round 9" D6). A run on a
        -- fresh store has no history, and its scoreboard is a baseline.
}

-- The project repository of the benchmark: the cut's commit and its tree.
contract ProjectRepository {
    is_commit: (commit: String) -> Boolean
    tree_of: (commit: String) -> String

    @invariant ASliceLinkIsReadAtItsTarget
        -- A slice of the plan that is a symbolic link in the tree at the cut is read at its
        -- target, resolved from the plan's folder within the same tree, and keeps the
        -- link's name: its number, its stamped copy's folder and its checklist source are
        -- the link's. Spec v2's plan is such links (.pi/plan/NN-<context> ->
        -- ../spec/<context>; decisions.md, "Spec round 8").

    @invariant ThePlanSlicesAreTheSelection
        -- When the configuration names plan_slices, only those slices are stamped and
        -- checklisted; when it names none, every slice of the plan is. A selection naming
        -- no slice of the plan leaves the checklist empty, which Measurement refuses, and
        -- the run halts before the cycle (decisions.md, "Spec round 8").
}

-- The builder: one pi-durable session, its tools in a Gondolin VM, run by a code leaf of the
-- tree through the provided builder host, which the leaf waits for (decisions.md, "Spec round
-- 18").
contract BuilderSession {
    builder_image_present: (run_id: String) -> Boolean

    @invariant OneFreshBuilderPerRegenerate
        -- Each regenerate and each repair runs one fresh builder session and waits for it;
        -- no builder session continues another, and one run has one builder at a time.

    @invariant ASessionResumesAsItself
        -- A builder session's identity is derived from the run's tick and the attempt, never
        -- drawn at random: the leaf that runs again in the same tick, after a stopped runner
        -- resumed the run, runs the same session again, and the builder host reopens it
        -- where it stopped. A new attempt is a new session.

    @invariant TheInstructionIsRendered
        -- The builder instruction is the text the render node wrote for this run, from the
        -- instruction version the run names (the one GEPA improves between cycles,
        -- never during a run). The repair instruction is that text and a closing paragraph naming the
        -- previous candidate and the gate evidence, read-only. Nothing else is appended.

    @invariant TheBuilderSeesOnlyItsMounts
        -- A fresh builder is handed the clean room and an empty candidate scope; a repair
        -- builder also the previous candidate and this cycle's gate evidence, read-only.
        -- Neither is handed an item's evidence, a judge's score, a filed verdict, a score
        -- or a scoreboard (decisions.md H6). The repair effect's detail names the gate
        -- evidence it mounted (spec round 16b).

    @invariant TheBuilderExitIsNoVerdict
        -- How a builder session ends is not evidence: the runner records the candidate
        -- the builder left in its candidate scope, and the gate decides whether it is
        -- done. A builder that leaves nothing in its candidate scope regenerated nothing.

    @invariant TheBuilderRunsInTheConfiguredImage
        -- When the configuration names a builder image, every builder of the run, fresh
        -- and repair, runs in that image: the folder of its name in the builder images
        -- directory handed in, as the builder host's third argument. Each regenerate and
        -- repair effect names the image and its digest in its detail. A configuration that
        -- names none runs the builder host with two arguments (decisions.md, "Spec round 9"
        -- D1).

    -- The builder image named for a stack carries that stack's toolchain, the same tools
    -- the gate runs the candidate with (for Clojure: a JDK, the Clojure CLI, git and bb), so
    -- a builder never brings its own. Proving that is the provided image build's
    -- (harness/Makefile), never the runner's: the runner checks only that the named image is
    -- there, and records which one each builder ran in (decisions.md, "Spec round 9" D2, D4).
}

-- The gate, run on the host for stage 1. For the http seam (the default) in the order of
-- legacy verify.sh: the contract's two entry points, the identity probe, the port free, the
-- suite, the boot within its budget, the marker, the identity probe's reply, each with legacy
-- verify.sh's arguments. For the stdio seam in the order of harness/v2/gate.sh: the
-- contract's two entry points, the identity probe, the suite, the identity probe over stdin
-- and stdout within its budget, then the event-store check of the store the probe's
-- candidate wrote (decisions.md, "Spec round 8"). When a gate command is handed in
-- (LOYLY_GATE_CMD), the runner gates neither way: it hands the attempt to that provided
-- command and records the command's result (decisions.md, "Spec round 12" D2).
contract GateOnTheHost {
    @invariant TheGateGradesACopy
        -- The gate grades a copy of the candidate taken when its builder session ended, in
        -- a gate room the builder never had: what the builder does after it ends does not
        -- reach what the gate grades. The gate room is the gate's, out of the builder's
        -- reach, and writable by the candidate's own test.sh and start.sh, as legacy
        -- verify.sh runs the candidate in a writable tree. The candidate digest recorded
        -- at install is the copy's as taken, before the gate runs: what the candidate's
        -- own run writes does not change it (decisions.md, "Spec round 7d").

    @invariant TheLegacyGateOrder
        -- For the http seam (config app_seam absent or http), as before spec round 8:
        -- the first guard that does not hold is the gate's reply, in legacy verify.sh's
        -- order; the port already answering is a refusal to grade, not a failed attempt
        -- (decisions.md b). Each step runs in the writable gate room and takes legacy
        -- verify.sh's arguments (seam.md, E5):
        -- test.sh none; start.sh the port; the identity probe the served URL,
        -- "http://127.0.0.1:" followed by the port, never the bare port (decisions.md,
        -- "Spec round 7c"). After a refusal to grade is recorded, the runner gates the
        -- same attempt again on the attempt's self-check, which stands: it does not
        -- self-check again, as the Regeneration cycle records one self-check per attempt
        -- (decisions.md, "Spec round 8b"). The same holds for the stdio seam and for a gate
        -- command. A gate stopped by a refusal guard is still recorded, as a failed outcome
        -- with the reason of the step the guard stands before, so the context refuses it with
        -- the guard's own code; only the three codes record-gate-refusal takes are followed
        -- by a gate refusal, and any other refusal of the gate halts the run (decisions.md,
        -- "Spec round 12" D3, carried from round 10's draft D2).

    @invariant TheStdioGateOrder
        -- For the stdio seam, the first guard that does not hold is the gate's reply, in
        -- harness/v2/gate.sh's order (harness/verify.sh, then the event-store check), each
        -- step in the writable gate room with gate.sh's arguments (seam.md, E5): test.sh
        -- and start.sh executable, else contract_missing; the identity probe present and
        -- executable at the cut, else the refusal identity_probe_missing; no port, so the
        -- seam never answered before boot; test.sh with no argument, else suite_red; the
        -- probe with two, the gate room's start.sh and the boot budget in seconds, else
        -- identity_probe_failed; the store check, else identity_probe_failed with its
        -- output as the detail. A pass is one poll of a stdio_boot_budget_seconds budget,
        -- answered on that poll. A store check that cannot be started is an effect that
        -- could not run: the run halts, and the gate records nothing.

    @invariant TheStoreCheckReadsTheProbesStore
        -- The suite is handed no store: no variable of the runner's own whose name starts
        -- LOYLY_ reaches test.sh, the probe or the store check, and neither does a
        -- GATE_STORE the runner itself inherited (decisions.md, "Spec round 8b"). The
        -- probe alone is handed the attempt's gate store, a fresh file outside the gate
        -- room, as GATE_STORE, and hands it to the candidate it launches; the store check
        -- is handed that same path, so it reads only what the probe caused, as
        -- harness/v2/gate.sh's does.

    @invariant TheGateRoomHoldsTheCleanRoom
        -- For either seam the gate room is a copy of the gated tree: the clean room's
        -- files plus the candidate's copy at its scope, so the candidate reads the spec
        -- beside it as in its builder room (harness/v2/gate.sh gates a candidate inside
        -- its room). For the http seam the gate room is legacy verify.sh's ROOT (line 23):
        -- the probe is checked -x "$ROOT/$APP_PROBE" (line 36) and run as
        -- "$ROOT/$APP_PROBE" "$URL" (line 154), with no change of directory and nothing
        -- else added (decisions.md, "Spec round 11"). The candidate digest is still its
        -- scope's alone.

    @invariant TheHarnessDigestCoversTheStoreCheck
        -- For the stdio seam the harness digest covers the store-check command too, after
        -- the configuration file, the self-check command and the identity probe, so a
        -- store check changed between the self-check and the gate is another harness.

    @invariant TheGateCommandJudges
        -- When a gate command is handed in (seam.md, E5 gate (command); decisions.md,
        -- "Spec round 12" D2), it is the gate, for either seam: the runner checks the
        -- identity probe at the cut, then launches the command once per gate, with three
        -- arguments: the gate room, which is then the cut's tree with nothing at the
        -- candidate's scope, the candidate's copy beside it, and the attempt's empty gate
        -- evidence directory, which is the attempt's evidence root; and it starts no
        -- program of the candidate itself. Absent, the gate is the http or the stdio gate,
        -- exactly as before.

    @invariant TheGateCommandsResultIsRead
        -- The gate command's exit status and its last line are its result (seam.md, "The
        -- gate command's result"): exit 0 a pass, with the budget of its BOOT line, the
        -- poll of its ANSWERED line and its last line as the identity probe's result; any
        -- other exit a failed attempt with the reason its last line names, or a refusal to
        -- grade when it names seam_answered_before_boot or identity_probe_missing; any
        -- other last line a gate that could not be performed, which halts the run and
        -- records nothing for the gate. A command that outlives the gate stage's timeout is
        -- stopped and the cycle fails at the gate for budget.

    @invariant TheHarnessDigestCoversTheGateCommand
        -- When a gate command is handed in, the harness digest covers it, after the
        -- configuration file, the self-check command and the identity probe, so a gate
        -- command changed between the self-check and the gate is another harness. With
        -- none handed in, the digest is as before.
}

-- The judge: for each checklist item a researcher drives the gated candidate over its public
-- seam, and the judge scores the item pass or fail on what the researcher recorded. The sealed grader is a published, versioned judge workflow, cycle-runner/grade.v1,
-- with its rubric; its digest is approved by the operator.
contract TheJudge {
    @invariant OnlyAnApprovedGrader
        -- A run grades only with the sealed grader whose digest is one of the run's approved
        -- grader digests; another digest halts the run before the cycle opens, before any
        -- clean room or builder (AGENTS.md, The instrument).

    @invariant EachItemStartsClear
        -- Each item's grading starts with its evidence cleared: no item's researcher sees
        -- the evidence another item's researcher recorded.

    @invariant TheResearcherDrivesTheSeamOnly
        -- The researcher is given the item's scenario, the candidate's seam and the event
        -- model it names, and one tool, a shell in a Gondolin VM whose only mount is the
        -- grading room (the clean room's files with the gated candidate's copy at its
        -- scope), fresh for each item. It records what it set up, sent and observed.

    @invariant ReasonBeforeScore
        -- The judge writes its reason before its score, on one binary scale, pass or fail;
        -- a reply with a score and no reason scores nothing, a level with no reasoning among
        -- them (ORC's banded-output check reads the level only). Each score is recorded as ORC's
        -- judge score event, its judge name carrying the item identity, so each item keeps
        -- its own score.

    @invariant AModelOtherThanTheBuildersOwn
        -- The researcher and the judge run on another model than the one the builder
        -- session runs on. Verified by: gate model-independence (planned).
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- The effect a leaf of the run performed, each recorded into one context's command
-- (seam.md, "The effects").
enum Effect {
    stamp | pin | checklist | self_check | fence | fail_cycle | regenerate | install
    | gate | gate_refusal | repair | file_verdicts | file_score | fail_score_stage
}

enum EffectOutcome { recorded | refused }

-- The gate's contract with the candidate, from the handed-in configuration's APP_SEAM:
-- http, legacy verify.sh's HTTP seam (the default, the Löyly benchmark); stdio, the JSON-RPC
-- over stdio seam of the harness's own contexts, gated as harness/v2/gate.sh gates them
-- (decisions.md, "Spec round 8").
enum AppSeam { http | stdio }

-- Why a run halted: an effect that could not be performed at all, so nothing was recorded
-- for it (a handed-in command that could not start, a gate command whose result says the gate
-- could not be performed, a node that calls the model and failed, a gate recording the
-- context refused with no next step; decisions.md, "Spec round 12" D2, D3); or a refusal
-- before the cycle opened (the stamp, the pin or the checklist refused, the stamp's
-- identities not the plan's own, or the sealed grader not approved), where there is no cycle
-- to fail (AGENTS.md: an unstamped scenario or an empty selection stops the cycle;
-- decisions.md, "Spec round 7b" 2, Q1).
enum HaltReason { effect_could_not_run | refused_before_the_cycle }

------------------------------------------------------------
-- Config
------------------------------------------------------------

-- The project's harness configuration, legacy config.sh as-is (seam.md, "Handed in").
config {
    app_dir: String
    port: Integer
    plan_dir: String
    app_marker: String
    app_probe: String
    fenced_paths: Set<String>
    -- The gate's contract (spec round 8): absent, http.
    app_seam: AppSeam = http
    -- The selected slice numbers (spec round 8): empty, every slice of the plan.
    plan_slices: Set<String>
    -- The builder image for the stack (spec round 9): a folder of the builder images
    -- directory handed in. Empty, none: the builder host gets two arguments.
    builder_image: String = ""
    -- Legacy verify.sh: ten seconds, twenty polls at half a second, a poll first and then the
    -- wait: poll 1 at once after start.sh is launched, poll n at (n - 1) * 0.5 seconds, poll 20
    -- at 9.5; answered_on_poll is the first poll that answered (spec round 15), counted
    -- in polls, never in seconds (spec round 16b).
    boot_budget_seconds: Integer = 10
    boot_polls: Integer = 20
    -- harness/verify.sh, the stdio seam: thirty seconds, held by the probe, one poll.
    stdio_boot_budget_seconds: Integer = 30
    stdio_boot_polls: Integer = 1
    -- How long a node that calls the model waits for one reply (spec round 18): ORC bounds
    -- no node, so the node's provider holds it.
    model_reply_seconds: Integer = 600
    -- Added to a tick's bound, the run's budget, for what no stage clock times: the start,
    -- the stamps, the pin, the checklist, the first self-check, the render, the grading
    -- (spec rounds 16 and 18).
    tick_margin_seconds: Integer = 3600
}

------------------------------------------------------------
-- Decided questions (spec round 7b; decisions.md, "Spec round 7b")
------------------------------------------------------------
--
-- Q1: the stamped plan against Specification's ledger: the runner restamps a copy of each
--     plan spec file with its item tags removed; the restamped identities must equal the
--     file's own tags, else the run halts (HaltReason above). A slice the one store's
--     ledger already holds is not stamped again; its identities are read from the ledger,
--     and must equal the file's own tags in the same way (spec round 18). Specification
--     is unchanged.
-- Q2, Q5: the benchmark's configuration is its own, handed in: the archived Löyly
--     configuration with the fence "impl harness-impl .pi archive/legacy-harness/cycles".
-- Q3: the harness digest is the SHA-256 of the configuration file, the self-check command
--     and the identity probe, in that order; for the stdio seam the store-check command
--     follows (spec round 8, TheHarnessDigestCoversTheStoreCheck).
-- Q4: the method is synchronous (StartRun responds once the run concluded or halted, the
--     grading and the score included since spec round 18).
-- Q6: the scenario digest is the runner's reading (seam.md); Specification names none.
