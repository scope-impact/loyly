-- allium: 3
-- harness-bootstrap.allium
--
-- Scope: the local build contract for the repository-root Pi harness Makefile target.
-- This workflow is distinct from candidate regeneration and requires no grader.
-- Includes: installing dependencies, building and verifying runtimes, completion and failure.
-- Excludes: regeneration, grading, and the build tools' own behaviour.

enum HarnessBootstrapStatus { requested | installing_dependencies | building_runtimes | verifying_runtimes | completed | failed }

entity HarnessRuntimeBootstrap {
    identity: String
    makefile: String
    output_directory: String
    runtime_assets: List<String>
    harness_revision: String
    snapshot_manifest_digest: String?
    calibration_digest: String?
    status: HarnessBootstrapStatus
    failure_reason: String?
}

rule InstallHarnessDependencies {
    when: HarnessBootstrapStarted(bootstrap)
    requires: bootstrap.status = requested
    requires: bootstrap.makefile = "harness/Makefile"
    requires: bootstrap.output_directory = ".pi/harness/.state/assets"
    ensures: bootstrap.status = installing_dependencies
}

rule BuildHarnessRuntimes {
    when: HarnessDependenciesInstalled(bootstrap)
    requires: bootstrap.status = installing_dependencies
    ensures: bootstrap.status = building_runtimes
    ensures: docker_build_all_configured_images(bootstrap.makefile)
    ensures: build_all_gondolin_runtimes(bootstrap.makefile,
                                        bootstrap.output_directory,
                                        bootstrap.runtime_assets)
}

rule VerifyHarnessRuntimes {
    when: HarnessRuntimeAssetsBuilt(bootstrap)
    requires: bootstrap.status = building_runtimes
    ensures: bootstrap.status = verifying_runtimes
    ensures: verify_all_gondolin_assets(bootstrap.output_directory,
                                        bootstrap.runtime_assets)
}

rule CompleteHarnessBootstrap {
    when: HarnessRuntimeAssetsVerified(bootstrap)
    requires: bootstrap.status = verifying_runtimes
    requires: bootstrap.harness_revision != ""
    requires: all_runtime_assets_and_conformance_machinery_are_manifest_bound(bootstrap)
    requires: carried_and_uncarried_harness_calibration_passes(bootstrap)
    ensures: bootstrap.snapshot_manifest_digest = digest_harness_snapshot_manifest(bootstrap)
    ensures: bootstrap.calibration_digest = digest_harness_calibration(bootstrap)
    ensures: bootstrap.status = completed
}

rule FailHarnessBootstrap {
    when: HarnessBootstrapCommandFailed(bootstrap, reason)
    requires: reason != ""
    ensures: bootstrap.status = failed
    ensures: bootstrap.failure_reason = reason
}

invariant HarnessBootstrapDoesNotRequireOracle {
    for bootstrap in HarnessRuntimeBootstraps:
        bootstrap.status in {requested, installing_dependencies, building_runtimes,
                             verifying_runtimes, completed} implies
            not requires_product_oracle(bootstrap) and
            not requires_instrument_oracle(bootstrap)
}

invariant HarnessBootstrapDoesNotRegenerateProduct {
    for bootstrap in HarnessRuntimeBootstraps:
        bootstrap.status = completed implies
            not modifies_product_implementation(bootstrap) and
            not submits_regeneration_cycle(bootstrap) and
            not publishes_oracle(bootstrap)
}

surface PiHarnessRuntimeBootstrap {
    provides:
        HarnessBootstrapStarted(bootstrap)
        HarnessDependenciesInstalled(bootstrap)
        HarnessRuntimeAssetsBuilt(bootstrap)
        HarnessRuntimeAssetsVerified(bootstrap)
        HarnessBootstrapCommandFailed(bootstrap, reason)

    @guarantee OracleIndependentRuntimeSetup
        -- A fresh sealed harness snapshot can be built and calibrated before any product oracle exists.

    @guarantee HarnessOnlyEffect
        -- The Makefile target builds harness and supported-stack runtime assets only; it does not build,
        -- grade, or regenerate the product.
}
