-- allium: 3
-- runtime-evidence.allium
--
-- Scope: a generic runtime-signal and independent-invariant evidence contract.
-- Project models define what must be true; this model defines who may observe, evaluate,
-- persist, and project claims about one regenerated candidate.
-- Includes: runtime signals and their producers, independent invariant evaluations,
-- capture policy, validation rooms and their cycle evidence volumes, baseline trace
-- artifacts, and evidence projection.
-- Excludes: what any one project must prove, telemetry transport details, and the
-- technology that records signals and traces (.pi/architecture.md, "Technology bindings").
--
-- This spec is the one owner of EvidenceVerdict (an invariant evaluation may legitimately
-- be inconclusive; a filed checklist verdict, instrument.allium ItemVerdict, may not),
-- ProducerAuthority, EvidencePurpose, the EvidenceProjectionCreated fact, and the invariant
-- EvidenceProjectionIsNotAuthority. Other specs import them with use.

use "./regeneration-cycle.allium" as cycle

enum EvidenceVerdict { pass | fail | inconclusive }

enum ProducerAuthority {
    candidate |
    harness_observer |
    independent_validator
}

enum EvidencePurpose { assertion | diagnostic | calibration }

enum RuntimeSignalKind {
    browser_exchange |
    trace_span |
    domain_event |
    projection_state |
    invariant_result |
    runtime_diagnostic |
    profile_sample |
    collection_status
}

-- Where a validation room mounts its inputs, and where a baseline grade's trace artifact
-- lives in the cycle evidence volume. .pi/architecture.md binds them to their technology.
config {
    capture_policy_mount: String = "/observability"
    evidence_volume_mount: String = "/evidence"
    baseline_trace_path: String = "playwright/baseline/trace.zip"
}

-- The pinned, read-only declaration of what a validation room collects, supplied by the
-- self-checked harness.
value CapturePolicy {
    policy_digest: String
    mount_path: String
    read_only: Boolean
}

-- The one writable directory of one cycle's independent grading.
value CycleEvidenceVolume {
    identity: String
    cycle_identity: String
    mount_path: String
    writable: Boolean
}

-- The complete trace an independent validator recorded of a baseline grade.
value TraceArtifact {
    cycle_identity: String
    path: String
    content_digest: String
    complete: Boolean
    authority: ProducerAuthority
}

entity RuntimeSignal {
    identity: String
    cycle_identity: String
    item_identity: String?
    operation_identity: String?
    trace_identity: String?
    event_identity: String?
    kind: RuntimeSignalKind
    producer: String
    authority: ProducerAuthority
    purpose: EvidencePurpose
    subject_digest: String
    content_digest: String
    complete: Boolean
    sampled: Boolean
    dropped_count: Integer
    collection_reason: String?
}

entity IndependentInvariantEvaluation {
    identity: String
    cycle_identity: String
    item_identity: String
    invariant_identity: String
    producer: String
    authority: ProducerAuthority
    input_signals: List<RuntimeSignal>
    subject_digest: String
    verdict: EvidenceVerdict
    evidence_digest: String
}

entity ValidationRoom {
    cycle_identity: String
    capture_policy: CapturePolicy
    evidence_volume: CycleEvidenceVolume
}

entity BaselineTraceBinding {
    cycle_identity: String
    evidence_digest: String
    trace: TraceArtifact
}

------------------------------------------------------------
-- Contracts: identities and projections the rules read
------------------------------------------------------------

contract EvidenceIdentity {
    -- One evaluation per cycle, item, and invariant.
    invariant_evaluation_identity: (cycle_identity: String, item_identity: String, invariant_identity: String) -> String
    -- The recorded reason a collection was incomplete: the affected signal kind and why.
    incomplete_collection_reason: (signals: List<RuntimeSignal>) -> String
    -- The verdict a report projection shows for an evaluation.
    projected_verdict: (evaluation_identity: String) -> EvidenceVerdict
    -- The subject digest of the candidate the cycle's gate passed.
    gated_subject_digest_for: (cycle_identity: String) -> String
    -- The one evidence volume a cycle's validation writes.
    cycle_evidence_volume_identity: (cycle_identity: String) -> String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule RecordRuntimeSignal {
    when: RuntimeSignalCaptured(orc, signal)
    requires: signal.identity != ""
    requires: signal.cycle_identity != ""
    requires: signal.producer != ""
    requires: signal.dropped_count >= 0
    ensures: RuntimeSignal.created(
        identity: signal.identity,
        cycle_identity: signal.cycle_identity,
        item_identity: signal.item_identity,
        operation_identity: signal.operation_identity,
        trace_identity: signal.trace_identity,
        event_identity: signal.event_identity,
        kind: signal.kind,
        producer: signal.producer,
        authority: signal.authority,
        purpose: signal.purpose,
        subject_digest: signal.subject_digest,
        content_digest: signal.content_digest,
        complete: signal.complete,
        sampled: signal.sampled,
        dropped_count: signal.dropped_count,
        collection_reason: signal.collection_reason
    )
}

rule EvaluateCompleteInvariant {
    when: IndependentInvariantChecked(orc, cycle_identity, item_identity, invariant_identity,
                                      producer, subject_digest, signals, verdict, evidence_digest)
    requires: signals.count > 0
    requires: signals.all(signal => signal.cycle_identity = cycle_identity)
    requires: signals.all(signal => signal.subject_digest = subject_digest)
    requires: signals.all(signal => signal.complete)
    requires: signals.all(signal => not signal.sampled)
    requires: signals.all(signal => signal.dropped_count = 0)
    requires: verdict = pass or verdict = fail
    ensures: IndependentInvariantEvaluation.created(
        identity: invariant_evaluation_identity(cycle_identity, item_identity, invariant_identity),
        cycle_identity: cycle_identity,
        item_identity: item_identity,
        invariant_identity: invariant_identity,
        producer: producer,
        authority: independent_validator,
        input_signals: signals,
        subject_digest: subject_digest,
        verdict: verdict,
        evidence_digest: evidence_digest
    )
}

rule MarkIncompleteInvariantInconclusive {
    when: IndependentInvariantInputsIncomplete(orc, cycle_identity, item_identity, invariant_identity,
                                               producer, subject_digest, signals, evidence_digest)
    requires: signals.count = 0 or
        exists signals where not complete or sampled or dropped_count > 0
    requires: incomplete_collection_reason(signals) != ""
    ensures: IndependentInvariantEvaluation.created(
        identity: invariant_evaluation_identity(cycle_identity, item_identity, invariant_identity),
        cycle_identity: cycle_identity,
        item_identity: item_identity,
        invariant_identity: invariant_identity,
        producer: producer,
        authority: independent_validator,
        input_signals: signals,
        subject_digest: subject_digest,
        verdict: inconclusive,
        evidence_digest: evidence_digest
    )
}

rule ProjectRuntimeEvidence {
    when: RuntimeEvidenceReportRequested(orc, evaluation)
    ensures: EvidenceProjectionCreated(
        evaluation_identity: evaluation.identity,
        verdict: evaluation.verdict,
        evidence_digest: evaluation.evidence_digest
    )
}

rule OpenValidationRoom {
    when: ValidationRoomStarted(orc, cycle_identity, capture_policy, evidence_volume)
    requires: capture_policy.read_only
    requires: capture_policy.mount_path = config.capture_policy_mount
    requires: evidence_volume.cycle_identity = cycle_identity
    requires: evidence_volume.mount_path = config.evidence_volume_mount
    requires: evidence_volume.writable
    ensures: ValidationRoom.created(
        cycle_identity: cycle_identity,
        capture_policy: capture_policy,
        evidence_volume: evidence_volume
    )
}

rule BindSuccessfulBaselineTrace {
    when: BaselineGradeCompleted(orc, cycle_identity, evaluation, trace)
    requires: evaluation.verdict = pass
    requires: trace.cycle_identity = cycle_identity
    requires: trace.path = config.baseline_trace_path
    requires: trace.complete
    requires: trace.authority = independent_validator
    ensures: BaselineTraceBinding.created(
        cycle_identity: cycle_identity,
        evidence_digest: evaluation.evidence_digest,
        trace: trace
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant CandidateCannotAuthorIndependentVerdict {
    for evaluation in IndependentInvariantEvaluations:
        evaluation.authority = independent_validator
}

invariant PassingEvaluationRequiresCompleteCollection {
    for evaluation in IndependentInvariantEvaluations:
        evaluation.verdict = pass implies
            evaluation.input_signals.count > 0 and
            evaluation.input_signals.all(signal =>
                signal.complete and not signal.sampled and signal.dropped_count = 0)
}

-- ORC evaluation judge scores on builder or other nodes are diagnostic signals.
invariant DiagnosticSignalCannotDetermineVerdict {
    for signal in RuntimeSignals:
        signal.purpose = diagnostic implies
            not exists IndependentInvariantEvaluations where evidence_digest = signal.content_digest
}

invariant EvidenceProjectionIsNotAuthority {
    for evaluation in IndependentInvariantEvaluations:
        projected_verdict(evaluation.identity) = evaluation.verdict
}

-- Independent rooms see the subject the gate passed, never a later or earlier candidate.
invariant IndependentRoomsPreserveSubject {
    for evaluation in IndependentInvariantEvaluations:
        evaluation.subject_digest = gated_subject_digest_for(evaluation.cycle_identity)
}

invariant ValidationEvidenceIsCycleIsolated {
    for room in ValidationRooms:
        room.evidence_volume.identity = cycle_evidence_volume_identity(room.cycle_identity)
}

invariant CapturePolicyIsPinnedReadOnlyInput {
    for room in ValidationRooms:
        room.capture_policy.read_only and
        room.capture_policy.mount_path = config.capture_policy_mount and
        room.capture_policy.policy_digest != ""
}

-- A bound trace artifact is complete, recorded by the independent validator for the same
-- cycle, and digest-bound.
invariant BoundTraceIsCompleteAndIndependent {
    for binding in BaselineTraceBindings:
        binding.trace.complete and
        binding.trace.authority = independent_validator and
        binding.trace.cycle_identity = binding.cycle_identity and
        binding.trace.content_digest != ""
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The runtime facts ORC reports from the rooms it runs: captured signals, independent
-- invariant checks, validation rooms, and baseline grades. Only ORC's runtime reports them.
surface RuntimeEvidenceReporting {
    facing orc: cycle/OrcRuntime

    provides:
        RuntimeSignalCaptured(orc, signal)
        IndependentInvariantChecked(orc, cycle_identity, item_identity, invariant_identity,
                                    producer, subject_digest, signals, verdict, evidence_digest)
        IndependentInvariantInputsIncomplete(orc, cycle_identity, item_identity, invariant_identity,
                                             producer, subject_digest, signals, evidence_digest)
        RuntimeEvidenceReportRequested(orc, evaluation)
        ValidationRoomStarted(orc, cycle_identity, capture_policy, evidence_volume)
        BaselineGradeCompleted(orc, cycle_identity, evaluation, trace)

    contracts:
        demands EvidenceIdentity

    @guarantee IndependentVerdictAuthority
        -- Telemetry the candidate emits may supply correlated facts but cannot author the
        -- independent invariant verdict used by the cycle measurement.

    @guarantee IncompleteMeansInconclusive
        -- Missing, incomplete, sampled, or dropped required signals record their affected
        -- kind and reason and cannot silently pass or fail.

    @guarantee DurableBeforeProjection
        -- Reports reproduce a persisted evidence digest and never become verdict authority.

    @guarantee IsolatedCycleEvidence
        -- Independent validation writes only to one cycle-owned evidence volume; the
        -- candidate and the harness-supplied capture policy remain read-only.

    @guarantee ScoreTraceIsBound
        -- A score is complete only when its trace artifact exists, is complete, and its
        -- digest is bound into the measurement.
}
