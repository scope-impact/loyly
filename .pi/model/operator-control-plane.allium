-- allium: 3
-- operator-control-plane.allium
--
-- Scope: observable, session-agnostic control-plane behaviour: how an operator submits,
-- waits for, and observes regeneration work. ORC owns task execution events.
-- Includes: workflow tasks and receipts, dispatch to ORC, task lifecycle, cycle progress
-- projected from ORC facts, builder session observation and intervention, child cycles, and
-- reads of the durable measurement.
-- Excludes: cuts, selections, preparations, cycles and submission idempotence
-- (regeneration-cycle.allium, imported as cycle), ORC's own execution semantics (ORC
-- specs/orc-service.allium), the cycle's stages and builder sessions
-- (execution-pipeline.allium, imported as execution), the measurement (instrument.allium,
-- imported as instrument), and the seam (affordances.yaml).
--
-- A WorkflowTask is not a cycle: a task may prepare a cut. Builder session views and
-- measurement receipts are read-side projections (the Grain read models builder-sessions and
-- cycle-measurements) of BuilderSession and CycleMeasurement, never authorities, so they are
-- not declared here.

use "./regeneration-cycle.allium" as cycle
use "./execution-pipeline.allium" as execution
use "./instrument.allium" as instrument

enum WorkflowTaskKind { cut_preparation | regeneration_cycle }
enum WorkflowTaskStatus { submitted | running | completed | failed }

entity WorkflowTask {
    identity: String
    kind: WorkflowTaskKind
    request_identity: String
    request_digest: String
    status: WorkflowTaskStatus
    trace_identity: String?
    outcome: String?
    preparation_identity: String?
    parent_cycle_identity: String?

    transitions status {
        submitted -> running
        running -> completed
        running -> failed
        terminal: completed, failed
    }
}

-- One projected position of a cycle's progress: the stage and builder session ORC's facts
-- give at a durable cursor of its trace. It never advances ORC.
entity CycleProgressView {
    cycle_identity: String
    trace_identity: String
    stage: cycle/CycleStage
    status: WorkflowTaskStatus
    builder_session_identity: String?
    durable_cursor: String?
}

------------------------------------------------------------
-- Contracts: what the control plane reads of ORC and Grain
------------------------------------------------------------

-- The startup check of the harness's Grain service area inside ORC's runtime.
contract ServiceAreaBoot {
    orc_grain_runtime: () -> String
    registered_service_area_loaded: (area: String) -> Boolean
    -- Every registered command, event, read model, query, and processor of the area matches
    -- a live registry entry, and none is missing or extra.
    strict_event_model_matches_live_registries: (runtime: String, area: String) -> Boolean
    every_required_allium_trace_link_resolves: (area: String) -> Boolean
}

-- How tasks reach ORC and how ORC's facts are read back.
contract OrcDispatch {
    full_source_commit: (source_commit: String) -> Boolean
    supported_backend: (backend: cycle/ExecutionBackend) -> Boolean
    next_task_identity: () -> String
    orc_tick_dispatched_for: (task_identity: String) -> Boolean
    -- The same task always yields the same ORC command identity, so a redelivered dispatch
    -- starts no second tick.
    deterministic_orc_command_identity: (task: WorkflowTask) -> String
    terminal_failure: (stage: cycle/CycleStage, reason: String) -> String
    -- The task status ORC's facts give at a durable cursor of a trace.
    projected_orc_task_status: (trace_identity: String, durable_cursor: String?) -> WorkflowTaskStatus
}

-- What an operator may do to a builder session and a terminal cycle.
contract SessionControl {
    latest_workspace_generation: (builder_session: execution/BuilderSession) -> String
    -- A pause, steer, or fork lands only between committed tool results.
    safe_intervention_boundary: (builder_session: execution/BuilderSession, intervention_kind: execution/InterventionKind) -> Boolean
    within_outer_cycle_budget: (parent_task: WorkflowTask, child_preparation: cycle/CyclePreparation) -> Boolean
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule ValidatePiHarnessServiceArea {
    when: PiHarnessServiceAreaLoaded(orc, runtime)
    requires: runtime = orc_grain_runtime()
    requires: registered_service_area_loaded(":loyly.pi-harness")
    requires: strict_event_model_matches_live_registries(runtime, ":loyly.pi-harness")
    requires: every_required_allium_trace_link_resolves(":loyly.pi-harness")
    ensures: PiHarnessServiceAreaValidated(runtime: runtime)
}

-- Approval alone starts nothing: ORC is dispatched once for each submitted task.
rule DispatchSubmittedTaskToOrc {
    when: task: WorkflowTask.created
    requires: not orc_tick_dispatched_for(task.identity)
    ensures: OrcGrainCommandDispatched(
        task_identity: task.identity,
        command_identity: deterministic_orc_command_identity(task),
        preparation_identity: task.preparation_identity
    )
}

rule PrepareCutTask {
    when: SubmitCutPreparationTask(operator_session, request_identity, request_digest, source_commit, backend)
    requires: full_source_commit(source_commit)
    requires: supported_backend(backend)
    requires: not exists WorkflowTask{request_identity: request_identity, kind: cut_preparation}
    ensures: WorkflowTask.created(
        identity: next_task_identity(),
        kind: cut_preparation,
        request_identity: request_identity,
        request_digest: request_digest,
        status: submitted,
        trace_identity: null,
        outcome: null,
        preparation_identity: null,
        parent_cycle_identity: null
    )
}

-- Every submitted cycle, from an approved preparation (regeneration-cycle.allium SubmitCycle)
-- or the whole plan (ApproveWholePlanBySubmission), gets exactly one task. Submission
-- idempotence lives in those rules, not here: a cycle is created once per request identity.
rule OpenCycleTask {
    when: submitted_cycle: cycle/RegenerationCycle.created
    ensures: WorkflowTask.created(
        identity: next_task_identity(),
        kind: regeneration_cycle,
        request_identity: submitted_cycle.identity,
        request_digest: submitted_cycle.request_digest,
        status: submitted,
        trace_identity: null,
        outcome: null,
        preparation_identity: submitted_cycle.preparation.identity,
        parent_cycle_identity: submitted_cycle.parent_cycle_identity
    )
}

rule RepeatIdenticalSubmission {
    when: RepeatRegenerationSubmission(operator_session, task, supplied_digest)
    requires: task.kind = regeneration_cycle
    requires: supplied_digest = task.request_digest
    ensures: ExistingTaskReceiptReturned(task: task)
}

rule RefuseConflictingSubmission {
    when: RepeatRegenerationSubmission(operator_session, task, different_digest)
    requires: different_digest != task.request_digest
    ensures: SubmissionRefused(reason: "request identity conflict")
}

rule StartWorkflowTask {
    when: OrcTaskStarted(orc, task, trace_identity)
    requires: task.status = submitted
    ensures: task.status = running
    ensures: task.trace_identity = trace_identity
}

rule CompleteWorkflowTask {
    when: OrcTaskCompleted(orc, task, outcome)
    requires: task.status = running
    ensures: task.status = completed
    ensures: task.outcome = outcome
}

rule FailWorkflowTask {
    when: OrcTaskFailed(orc, task, stage, reason)
    requires: task.status = running
    ensures: task.status = failed
    ensures: task.outcome = terminal_failure(stage, reason)
}

rule WaitForWorkflowTask {
    when: WaitForTaskOutcome(operator_session, task)
    requires: task.status = completed or task.status = failed
    ensures: TerminalTaskOutcomeReturned(task: task)
}

-- The receipt returned is a projection of the one measurement (instrument.allium
-- CycleMeasurement); reading it never files or amends a score.
rule ReadDurableMeasurement {
    when: ReadCycleMeasurement(operator_session, measured_cycle)
    requires: exists instrument/CycleMeasurement{cycle: measured_cycle}
    ensures: DurableMeasurementReturned(cycle_identity: measured_cycle.identity)
}

-- ORC reports progress already translated into the harness's terms: a cycle stage
-- (regeneration-cycle.allium CycleStage) and the builder session, never a raw ORC node id.
-- The translation is the Grain read model node-stages, the harness's anti-corruption layer
-- over ORC's :sheet facts (ADR 0004). Each projected position is a view; none is a harness
-- event.
rule ProjectCycleProgress {
    when: OrcExecutionEventProjected(orc, task, stage, status, builder_session_identity, durable_cursor)
    requires: task.kind = regeneration_cycle
    requires: task.trace_identity != null
    ensures: CycleProgressView.created(
        cycle_identity: task.request_identity,
        trace_identity: task.trace_identity,
        stage: stage,
        status: status,
        builder_session_identity: builder_session_identity,
        durable_cursor: durable_cursor
    )
}

rule ReadCycleProgress {
    when: QueryCycleProgress(operator_session, cycle_identity)
    requires: exists CycleProgressView{cycle_identity: cycle_identity}
    ensures: ReconciledCycleProgressReturned(cycle_identity: cycle_identity)
}

-- Observing a builder session (execution-pipeline.allium BuilderSession) reads its view and
-- changes nothing.
rule ObserveBuilderSession {
    when: OpenBuilderSession(operator_session, builder_session)
    ensures: ReadOnlyBuilderSessionViewReturned(
        builder_session_identity: builder_session.session_identity,
        tick_identity: builder_session.tick_identity,
        workspace_generation: latest_workspace_generation(builder_session)
    )
}

rule InterveneInBuilderSession {
    when: InterveneBuilderSession(operator_session, builder_session, intervention_kind)
    requires: safe_intervention_boundary(builder_session, intervention_kind)
    ensures: BuilderInterventionRecorded(
        builder_session_identity: builder_session.session_identity,
        kind: intervention_kind
    )
    ensures: builder_session.last_intervention = intervention_kind
    ensures: builder_session.assisted = true
}

rule ContinueWithChildCycle {
    when: PrepareChildCycle(operator_session, parent_task, child_preparation, reason)
    requires: parent_task.status = completed or parent_task.status = failed
    requires: child_preparation.status = approved
    requires: within_outer_cycle_budget(parent_task, child_preparation)
    ensures: ChildCycleLineageRecorded(
        parent_cycle_identity: parent_task.request_identity,
        preparation_identity: child_preparation.identity,
        reason: reason
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneRequestNamesOneTask {
    for task in WorkflowTasks:
        count(WorkflowTasks where request_identity = task.request_identity and kind = task.kind) = 1
}

invariant TerminalOutcomeIsStable {
    for task in WorkflowTasks:
        task.status = completed or task.status = failed implies task.outcome != null
}

-- A progress view states what ORC's facts give at its cursor, and nothing ORC did not report.
invariant ProgressViewMirrorsOrc {
    for progress in CycleProgressViews:
        progress.status = projected_orc_task_status(progress.trace_identity, progress.durable_cursor)
}

-- Only an intervention marks a builder session assisted; observing one never does.
invariant BuilderObservationDoesNotAssist {
    for builder_session in execution/BuilderSessions:
        builder_session.assisted implies builder_session.last_intervention != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface RegenerationControlPlane {
    facing operator_session: cycle/Operator

    provides:
        SubmitCutPreparationTask(operator_session, request_identity, request_digest, source_commit, backend)
        RepeatRegenerationSubmission(operator_session, task, supplied_digest)
        WaitForTaskOutcome(operator_session, task)
        QueryCycleProgress(operator_session, cycle_identity)
        ReadCycleMeasurement(operator_session, measured_cycle)
        OpenBuilderSession(operator_session, builder_session)
        InterveneBuilderSession(operator_session, builder_session, intervention_kind)
        PrepareChildCycle(operator_session, parent_task, child_preparation, reason)

    contracts:
        demands SessionControl

    @guarantee DurableTaskObservation
        -- A replacement ORC worker reconstructs a known task outcome from ORC state and never
        -- reruns the task to respond to a wait.

    @guarantee RefusalBeforeExecution
        -- Invalid identities, selections, scopes, and backends are refused before builder work begins.

    @guarantee SessionAgnosticControl
        -- ORC cycle state outlives the Codex, Pi, or other operator session that requested it.

    @guarantee ExploratorySessionOwnership
        -- Skills, dynamic tools, branching, and human direction remain in the operator session.

    @guarantee ImmutableHandoff
        -- Only the approved preparation crosses into ORC; the exploratory transcript never becomes builder input.

    @guarantee FixedContractOwnership
        -- ORC owns bounded production prompt execution, constrained tools, retries,
        -- termination, grading, and measurement.

    @guarantee ObservableNotAuthoritative
        -- Live notifications and builder-session views aid operators but never advance ORC state.
}

-- The task facts ORC reports. Only ORC's runtime reports them; an operator can submit and
-- wait for a task but never start, complete, or fail one.
surface OrcTaskReporting {
    facing orc: cycle/OrcRuntime

    provides:
        PiHarnessServiceAreaLoaded(orc, runtime)
        OrcTaskStarted(orc, task, trace_identity)
        OrcTaskCompleted(orc, task, outcome)
        OrcTaskFailed(orc, task, stage, reason)
        OrcExecutionEventProjected(orc, task, stage, status, builder_session_identity, durable_cursor)

    contracts:
        demands ServiceAreaBoot
        demands OrcDispatch

    @guarantee TaskFactsAreOrcs
        -- A task's start, completion, failure, and progress come only from ORC's durable
        -- tick facts; the harness projects them and never duplicates them.

    @guarantee ProgressIsNeverMirrored
        -- No harness event mirrors a tick or node starting or completing. The cycle's stage
        -- facts (a clean room proved, a gate attempt, a filed score) are domain facts the
        -- harness records, not progress (ADR 0004).
}
