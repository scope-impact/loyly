-- allium: 3
-- execution-pipeline.allium
--
-- Scope: the regeneration cycle in the legacy shape: fence, regenerate, gate, score,
-- scoreboard. The fence and the gate are the harness and feed the build loop. The score and
-- the scoreboard are the instrument (instrument.allium) and never feed the loop. The file is
-- named for its slice, 02-execution-pipeline; the concept is the regeneration cycle.
-- Includes: the rules that move the one cycle aggregate (regeneration-cycle.allium
-- RegenerationCycle) through its stages to a terminal status, the harness self-check, the
-- clean room, one builder per slice, the one builder session aggregate (BuilderSession),
-- launched by ORC in builder rooms it chooses, gate attempts and repair, and the candidate
-- subject.
-- Excludes: the cycle aggregate itself and operator approval (regeneration-cycle.allium),
-- grader authoring, score filing, and the scoreboard (instrument.allium, which owns the
-- measurement), runtime evidence (runtime-evidence.allium), and Grain command/event plumbing.

use "./regeneration-cycle.allium" as cycle
use "./instrument.allium" as instrument

entity HarnessSelfCheck {
    harness_digest: String
    golden_digests: List<String>
    passed: Boolean
    failing_checks: List<String>
}

entity CleanRoom {
    cycle: cycle/RegenerationCycle
    cut_digest: String
    fenced_paths: List<String>
    single_root_commit: Boolean
    fenced_paths_unreachable: Boolean
}

-- The first regenerate attempt runs one fresh slice builder per selected slice, in plan order.
entity SliceBuild {
    cycle: cycle/RegenerationCycle
    slice: String
    position: Integer
    builder_session: BuilderSession
    generated_paths: List<String>
}

entity CandidateSubject {
    cycle: cycle/RegenerationCycle
    attempt: Integer
    digest: String
    generated_paths: List<String>
    tool_calls: Integer
}

-- The three roles a builder session plays. Each gets its own builder room and its own
-- production prompt.
enum BuilderSessionRole { slice_builder | repair_builder | grader_author }

enum BuilderSessionStatus { running | completed | failed }

-- How an operator may intervene in a builder session (operator-control-plane.allium).
enum InterventionKind { pause | steer | fork }

-- The builder room ORC chooses for one builder session. The builder host only forwards tool
-- calls into it and can never widen it.
value BuilderRoomPolicy {
    target_stack: String
    cut_read_only: Boolean
    writable_scope: Set<String>
    evidence_root: String?
    egress_allowed: Boolean
    inherits_host_environment: Boolean
}

-- The one builder session aggregate: one durable Pi session, launched by ORC for one tick and
-- identified by it, in the builder room ORC chose. A slice or repair builder belongs to one
-- cycle and regenerate attempt; a grader author belongs to no cycle. A relaunch after a crash
-- resumes this session from its committed turns. It ends completed or failed, as the builder
-- host reports. An operator's intervention marks its work assisted.
entity BuilderSession {
    tick_identity: String
    role: BuilderSessionRole
    session_identity: String
    cycle: cycle/RegenerationCycle?
    attempt: Integer?
    room: BuilderRoomPolicy
    production_prompt_digest: String
    status: BuilderSessionStatus
    launches: Integer
    assisted: Boolean
    last_intervention: InterventionKind?

    transitions status {
        running -> completed
        running -> failed
        terminal: completed, failed
    }
}

-- The candidate scope as it stood when one tool result was committed. A restored transcript
-- is only ever paired with the generation bound to its last committed result.
entity WorkspaceGeneration {
    session: BuilderSession
    committed_result: String
    generation: String
}

entity GateAttempt {
    cycle: cycle/RegenerationCycle
    attempt: Integer
    subject_digest: String
    target_stack: String
    passed: Boolean
    evidence_root: String
    suites_run: Integer
    fresh_state_root: Boolean
    answered_by_booted_candidate: Boolean
    failure_reason: String?
}

------------------------------------------------------------
-- Contracts: what the stage rules read
------------------------------------------------------------

-- The fence's checks against the cut. Both are read from the clean room ORC built, never
-- asserted by it.
contract FenceChecks {
    -- Every fenced path matched at least one path of the cut; a fenced path that matches
    -- nothing stops the fence.
    every_fenced_path_matches: (cut_digest: String, fenced_paths: List<String>) -> Boolean
    -- An approved sealed grader with this digest covers every selected item.
    approved_grader_covers: (grader_digest: String, items: List<cycle/StampedItem>) -> Boolean
}

-- What a builder room holds, and how a session is keyed. ORC decides each; the builder host
-- decides none.
contract BuilderRoomInputs {
    -- A slice builder's room holds the clean room and this cycle's candidate as the earlier
    -- slice builder left it: no earlier transcript, no earlier cycle's candidate, and no gate
    -- or score evidence.
    slice_builder_inputs_are_clean_room_and_cycle_candidate: (regeneration_cycle: cycle/RegenerationCycle, slice: String) -> Boolean
    -- A repair builder's room holds the clean room, the previous attempt's candidate, and that
    -- attempt's gate evidence read-only, and nothing else.
    builder_inputs_are_previous_candidate_and_gate_evidence: (regeneration_cycle: cycle/RegenerationCycle, attempt: Integer) -> Boolean
    -- A grader author's room mounts only the selected Gherkin and the public calibration
    -- protocol: no candidate, transcript, prior verdict, or host credential.
    room_mounts_only_selected_gherkin_and_calibration_protocol: (room: BuilderRoomPolicy) -> Boolean
    -- The room ORC chose for a builder tick.
    orc_room_policy: (tick_identity: String) -> BuilderRoomPolicy
    -- The durable session a builder tick names; the same tick always names the same session.
    durable_session_for: (tick_identity: String) -> String
    -- The workspace generation the builder host committed with one tool result.
    committed_workspace_generation: (session_identity: String, committed_result: String) -> String
}

-- Derivations over the cycle's own stage facts.
contract StageDerivations {
    completed_slice_builds: (regeneration_cycle: cycle/RegenerationCycle) -> Integer
    selected_slice_count: (regeneration_cycle: cycle/RegenerationCycle) -> Integer
    selected_slice_position: (regeneration_cycle: cycle/RegenerationCycle, slice: String) -> Integer
    -- The candidate digest recomputed after the gate ran: the gate never changes the
    -- candidate it gates.
    digest_after_gate: (regeneration_cycle: cycle/RegenerationCycle, attempt: Integer) -> String
    -- The subject digest of the cycle's passing gate attempt.
    gated_subject_digest: (regeneration_cycle: cycle/RegenerationCycle) -> String
    -- The refusal reason of a returned score, naming the refused items.
    refused_score_reason: (named_items: List<String>) -> String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- The self-check runs the harness's own calibration fixtures and reproduces every instrument
-- golden (instrument.allium) exactly; any golden not reproduced is a named failing check.
rule RunHarnessSelfCheck {
    when: HarnessSelfCheckRan(orc, harness_digest, golden_digests, failing_checks)
    requires: golden_digests.count > 0
    ensures: HarnessSelfCheck.created(
        harness_digest: harness_digest,
        golden_digests: golden_digests,
        passed: failing_checks.count = 0,
        failing_checks: failing_checks
    )
}

-- Fence: no clean room is built for an instrument nobody checked, and the room is proved,
-- not asserted. A passing harness self-check is reused only for an identical harness digest.
-- The cycle reaches the fence when ORC starts it (regeneration-cycle.allium StartCycle).
rule FenceCleanRoom {
    when: CleanRoomProved(orc, cycle, cut_digest, fenced_paths, harness_digest)
    requires: cycle.status = running
    requires: cycle.stage = fence
    requires: exists HarnessSelfCheck{harness_digest: harness_digest, passed: true}
    requires: approved_grader_covers(cycle.preparation.grader_digest, cycle.preparation.selection.items)
    requires: fenced_paths.count > 0
    requires: every_fenced_path_matches(cut_digest, fenced_paths)
    ensures: CleanRoom.created(
        cycle: cycle,
        cut_digest: cut_digest,
        fenced_paths: fenced_paths,
        single_root_commit: true,
        fenced_paths_unreachable: true
    )
    ensures: cycle.stage = regenerate
}

-- Regenerate: a fresh builder session rebuilds the selection from the clean room only.
rule RegenerateCandidate {
    when: BuilderCompleted(orc, cycle, attempt, builder_session, subject_digest,
                           generated_paths, tool_calls)
    requires: cycle.status = running
    requires: cycle.stage = regenerate
    requires: attempt >= 1
    requires: attempt <= 3
    requires: builder_session.cycle = cycle
    requires: builder_session.attempt = attempt
    requires: builder_session.role != grader_author
    requires: generated_paths.count > 0
    requires: tool_calls > 0
    requires: attempt > 1 implies builder_inputs_are_previous_candidate_and_gate_evidence(cycle, attempt)
    requires: attempt = 1 implies completed_slice_builds(cycle) = selected_slice_count(cycle)
    ensures: CandidateSubject.created(
        cycle: cycle,
        attempt: attempt,
        digest: subject_digest,
        generated_paths: generated_paths,
        tool_calls: tool_calls
    )
    ensures: cycle.stage = gate
}

-- Regenerate, first attempt: one fresh slice builder per selected slice, in plan order. A
-- slice builder reads the clean room and this cycle's candidate as the earlier slice builder
-- left it; no earlier transcript, earlier cycle's candidate, or gate or score evidence
-- crosses in.
rule BuildSlice {
    when: SliceBuilderCompleted(orc, cycle, slice, position, builder_session, generated_paths)
    requires: cycle.status = running
    requires: cycle.stage = regenerate
    requires: builder_session.cycle = cycle
    requires: builder_session.role = slice_builder
    requires: position = selected_slice_position(cycle, slice)
    requires: completed_slice_builds(cycle) = position - 1
    requires: slice_builder_inputs_are_clean_room_and_cycle_candidate(cycle, slice)
    requires: generated_paths.count > 0
    ensures: SliceBuild.created(
        cycle: cycle,
        slice: slice,
        position: position,
        builder_session: builder_session,
        generated_paths: generated_paths
    )
}

-- Gate: done is ratified by a gate room the builder does not control, never by its claim.
rule RecordGateAttempt {
    when: GateReturned(orc, cycle, attempt, subject_digest, target_stack, passed, evidence_root,
                       suites_run, fresh_state_root, answered_by_booted_candidate, failure_reason)
    requires: cycle.status = running
    requires: cycle.stage = gate
    requires: exists CandidateSubject{cycle: cycle, attempt: attempt, digest: subject_digest}
    requires: digest_after_gate(cycle, attempt) = subject_digest
    ensures: GateAttempt.created(
        cycle: cycle,
        attempt: attempt,
        subject_digest: subject_digest,
        target_stack: target_stack,
        passed: passed,
        evidence_root: evidence_root,
        suites_run: suites_run,
        fresh_state_root: fresh_state_root,
        answered_by_booted_candidate: answered_by_booted_candidate,
        failure_reason: failure_reason
    )
}

rule PassGate {
    when: gate_attempt: GateAttempt.created
    requires: gate_attempt.cycle.stage = gate
    requires: gate_attempt.passed
    ensures: gate_attempt.cycle.stage = score
}

rule RepairAfterFailedGate {
    when: gate_attempt: GateAttempt.created
    requires: gate_attempt.cycle.stage = gate
    requires: not gate_attempt.passed
    requires: gate_attempt.attempt < 3
    ensures: gate_attempt.cycle.stage = regenerate
}

rule FailAfterThreeGateAttempts {
    when: gate_attempt: GateAttempt.created
    requires: gate_attempt.cycle.stage = gate
    requires: not gate_attempt.passed
    requires: gate_attempt.attempt = 3
    ensures: CycleStageDidNotSucceed(cycle: gate_attempt.cycle, stage: gate, failure_kind: refused,
                                     reason: "gate failed after three regenerate attempts")
}

-- ORC launches every builder (slice, repair, grader author) as a durable Pi session keyed by
-- its tick, in a builder room ORC chose. The model credentials stay with the builder host,
-- never in the room.
rule LaunchDurableBuilderSession {
    when: BuilderTickStarted(orc, tick_identity, cycle, attempt, role, room, production_prompt_digest)
    requires: not exists BuilderSession{tick_identity: tick_identity}
    requires: room.cut_read_only
    requires: not room.egress_allowed
    requires: not room.inherits_host_environment
    requires: room.writable_scope.count > 0 or role = grader_author
    requires: role = repair_builder implies room.evidence_root != null
    requires: role != repair_builder implies room.evidence_root = null
    requires: role = grader_author implies cycle = null
    requires: role != grader_author implies cycle != null and attempt != null
    ensures: BuilderSession.created(
        tick_identity: tick_identity,
        role: role,
        session_identity: durable_session_for(tick_identity),
        cycle: cycle,
        attempt: attempt,
        room: room,
        production_prompt_digest: production_prompt_digest,
        status: running,
        launches: 1,
        assisted: false,
        last_intervention: null
    )
}

-- A relaunch of the same tick resumes the same session with the same room and the same
-- production prompt. It never starts a second session, and never resumes an ended one.
rule ResumeDurableBuilderSession {
    when: BuilderTickRelaunched(orc, builder_session, room, production_prompt_digest)
    requires: room = builder_session.room
    requires: production_prompt_digest = builder_session.production_prompt_digest
    requires: builder_session.status = running
    ensures: builder_session.launches = builder_session.launches + 1
}

-- The builder host reports the session's end: completed when its loop finished, failed when
-- it stopped without finishing. The outcome is the host's report, never a verdict.
rule EndBuilderSession {
    when: BuilderSessionEnded(orc, builder_session, finished)
    requires: builder_session.status = running
    ensures:
        if finished:
            builder_session.status = completed
        else:
            builder_session.status = failed
}

-- The builder host commits each tool result; the workspace generation is bound to it, so a
-- restart restores a transcript only with the workspace generation it produced.
rule BindWorkspaceGeneration {
    when: BuilderToolResultCommitted(orc, builder_session, committed_result, generation)
    requires: not exists WorkspaceGeneration{session: builder_session, committed_result: committed_result}
    ensures: WorkspaceGeneration.created(
        session: builder_session,
        committed_result: committed_result,
        generation: generation
    )
}

-- Score: the approved sealed grader files one verdict per checklist item
-- (instrument.allium FileScore). Filing the measurement moves the cycle to the scoreboard.
rule AdvanceToScoreboard {
    when: measurement: instrument/CycleMeasurement.created
    requires: measurement.cycle.status = running
    requires: measurement.cycle.stage = score
    ensures: measurement.cycle.stage = scoreboard
}

-- A refused score (an unknown item, a verdict that is neither pass nor fail, or no verdicts
-- at all) files nothing and fails the score stage explicitly; the cycle is never stranded.
rule FailRefusedScore {
    when: ScoreRefused(cycle, named_items)
    requires: cycle.status = running
    requires: cycle.stage = score
    ensures: CycleStageDidNotSucceed(cycle: cycle, stage: score, failure_kind: refused,
                                     reason: refused_score_reason(named_items))
}

-- Scoreboard: report to a person; never back into the loop (instrument.allium).
rule RecordScoreboard {
    when: board: instrument/Scoreboard.created
    requires: board.cycle.status = running
    requires: board.cycle.stage = scoreboard
    ensures: board.cycle.stage = result
}

-- Result: the cycle is terminal, and names the candidate its gate passed.
rule PassCycle {
    when: finished: cycle/RegenerationCycle.stage becomes result
    requires: finished.status = running
    requires: exists instrument/CycleMeasurement{cycle: finished, complete: true, failed: 0}
    ensures: finished.status = passed
    ensures: finished.candidate_digest = gated_subject_digest(finished)
}

rule FailCycle {
    when: finished: cycle/RegenerationCycle.stage becomes result
    requires: finished.status = running
    requires: not exists instrument/CycleMeasurement{cycle: finished, complete: true, failed: 0}
    ensures: finished.status = failed
    ensures: finished.candidate_digest = gated_subject_digest(finished)
}

rule FailCycleStage {
    when: CycleStageDidNotSucceed(cycle, stage, failure_kind, reason)
    requires: cycle.status = running
    requires: cycle.stage = stage
    ensures: cycle.status = failed
    ensures: cycle.failure_stage = stage
    ensures: cycle.failure_kind = failure_kind
    ensures: cycle.failure_reason = reason
    ensures: FailedDenominatorPreserved(cycle: cycle, item_identities: cycle.preparation.selection.items)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A gate passes only on a suite it saw run, against the candidate it booted from fresh state.
-- A missing test tool, an empty discovery, or a launch entrypoint that exits before it
-- responds fails the gate with its reason; an exit code of zero is not enough.
invariant GatePassRequiresObservedRun {
    for attempt in GateAttempts:
        attempt.passed implies
            attempt.suites_run > 0 and
            attempt.fresh_state_root and
            attempt.answered_by_booted_candidate
}

invariant FailedGateNamesItsReason {
    for attempt in GateAttempts:
        not attempt.passed implies attempt.failure_reason != null
}

invariant CleanRoomBeforeBuilder {
    for subject in CandidateSubjects:
        exists CleanRoom{cycle: subject.cycle}
}

invariant ScoreOnlyAfterPassingGate {
    for measurement in instrument/CycleMeasurements:
        exists GateAttempt{cycle: measurement.cycle, passed: true}
}

-- The only evidence a builder room holds is the gate evidence of the attempt before the
-- repair: no score, measurement, or scoreboard evidence ever reaches a builder.
invariant ScoreNeverFeedsTheLoop {
    for builder_session in BuilderSessions:
        builder_session.room.evidence_root = null or
            exists GateAttempt{cycle: builder_session.cycle,
                               attempt: builder_session.attempt - 1,
                               evidence_root: builder_session.room.evidence_root}
}

invariant BuilderSessionIsSeparateFromOperatorSession {
    for builder_session in BuilderSessions:
        not exists cycle/OperatorSession{identity: builder_session.session_identity}
}

invariant WorkspaceGenerationMatchesCommittedResult {
    for generation in WorkspaceGenerations:
        generation.generation = committed_workspace_generation(
            generation.session.session_identity, generation.committed_result)
}

invariant DurableSessionIsKeyedByTick {
    for builder_session in BuilderSessions:
        builder_session.session_identity = durable_session_for(builder_session.tick_identity)
}

invariant OrcAloneChoosesTheRoom {
    for builder_session in BuilderSessions:
        builder_session.room = orc_room_policy(builder_session.tick_identity)
}

invariant GraderAuthorRoomHoldsOnlySpecAndProtocol {
    for builder_session in BuilderSessions:
        builder_session.role = grader_author implies
            room_mounts_only_selected_gherkin_and_calibration_protocol(builder_session.room)
}

-- Every grader was written by a grader author session, in its own builder room.
invariant GraderIsAuthoredByAGraderAuthorSession {
    for grader in instrument/Graders:
        exists BuilderSession{session_identity: grader.author_session_identity, role: grader_author}
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The facts ORC reports while it runs a cycle. Only ORC's runtime reports them; the rules
-- above, chained by state, advance the stages. Nothing here lets an operator or a builder
-- report a gate, a score, or a result.
surface RegenerationCycleExecution {
    facing orc: cycle/OrcRuntime

    provides:
        HarnessSelfCheckRan(orc, harness_digest, golden_digests, failing_checks)
        CleanRoomProved(orc, cycle, cut_digest, fenced_paths, harness_digest)
        BuilderTickStarted(orc, tick_identity, cycle, attempt, role, room, production_prompt_digest)
        BuilderTickRelaunched(orc, builder_session, room, production_prompt_digest)
        BuilderToolResultCommitted(orc, builder_session, committed_result, generation)
        BuilderSessionEnded(orc, builder_session, finished)
        SliceBuilderCompleted(orc, cycle, slice, position, builder_session, generated_paths)
        BuilderCompleted(orc, cycle, attempt, builder_session, subject_digest,
                         generated_paths, tool_calls)
        GateReturned(orc, cycle, attempt, subject_digest, target_stack, passed, evidence_root,
                     suites_run, fresh_state_root, answered_by_booted_candidate, failure_reason)
        CycleStageDidNotSucceed(cycle, stage, failure_kind, reason)

    contracts:
        demands FenceChecks
        demands BuilderRoomInputs
        demands StageDerivations

    @guarantee ExactStageOrder
        -- The stages advance only in the declared order, on facts ORC reports and on the
        -- states those facts produce. Builder host completion cannot reorder or skip a stage.

    @guarantee HarnessAndInstrumentStaySeparate
        -- The fence and the gate feed the build loop. The score and the scoreboard report to a
        -- person and never reach a builder session.

    @guarantee OneFreshBuilderPerSlice
        -- The first regenerate attempt runs one fresh slice builder per selected slice in plan
        -- order; each sees the clean room and this cycle's candidate so far, and nothing else.

    @guarantee BoundedSliceContinuation
        -- A slice builder whose turn ends while its own uncarried list names items of its
        -- slice is continued in the same session, naming only those items, at most three
        -- times; a continuation that leaves the candidate unchanged ends it. The list is the
        -- builder's claim, never a verdict.

    @guarantee PhysicalFence
        -- The clean room is a repository of the cut's one commit in which every fenced path
        -- is absent from the working tree and the object graph, proved before any builder
        -- starts.

    @guarantee ExplicitNonSuccess
        -- Refusal, skip, timeout, and error identify their stage and preserve every approved denominator item.
}
