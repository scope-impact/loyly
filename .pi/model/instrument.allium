-- allium: 3
-- instrument.allium
--
-- Scope: the instrument: a checklist derived from the spec, a grader written once,
-- calibrated, sealed, and approved by digest, a score with an honest denominator, and a
-- scoreboard that compares cycles on shared items in both directions. It reports to a
-- person and never feeds the build loop.
-- Includes: stamping, checklist derivation, grader calibration, sealing, approval, reuse
-- and replacement, score filing into the one measurement aggregate (CycleMeasurement), its
-- refusals, and scoreboard comparison.
-- Excludes: the grader's own test logic, building candidates, the gate, and ORC's
-- evaluation judges (ORC specs/evaluation.allium): their scores are diagnostic runtime
-- evidence (runtime-evidence.allium), never a verdict. ORC runs the sealed grader as a
-- bounded step of the score stage; the rules below, not ORC, file its verdicts.

use "./regeneration-cycle.allium" as cycle

enum GraderStatus { calibrating | sealed | approved | discarded }
enum GraderReplacementReason { instrument_behavior_changed | wording_replaced | spec_grew }
-- A filed verdict has two values. Inconclusive evidence, like no evidence, files as fail with
-- the reason, so the item stays in the denominator.
enum ItemVerdict { pass | fail }

entity Grader {
    digest: String
    scenario_digests: List<String>
    author_session_identity: String
    attempt: Integer
    status: GraderStatus
    replaces: Grader?
    replacement_reason: GraderReplacementReason?

    transitions status {
        calibrating -> sealed
        calibrating -> discarded
        sealed -> approved
        terminal: approved, discarded
    }
}

-- One checklist item's filed verdict. An unreached item is filed as fail.
value ItemScore {
    item_identity: String
    verdict: ItemVerdict
    reached: Boolean
    evidence: String
}

-- The one measurement aggregate: the score of one cycle, filed once by FileScore from the
-- approved sealed grader's verdicts, one per checklist item. Its denominator is the cycle's
-- approved selection. Durable measurement receipts and evidence reports are projections of
-- it, never authorities.
entity CycleMeasurement {
    cycle: cycle/RegenerationCycle
    grader_digest: String
    total: Integer
    passed: Integer
    failed: Integer
    complete: Boolean
    items: List<ItemScore>
}

-- A checklist item names where it came from: its Rule (or none), the file and line of its
-- Scenario line, and its title with surrounding whitespace stripped.
value ChecklistItem {
    item_identity: String
    scenario_digest: String
    rule_name: String?
    source: String
    name: String
}

entity Checklist {
    selection_identity: String
    items: List<ChecklistItem>
}

-- An item identity, once stamped on a scenario, never moves: it is not renumbered, not
-- re-derived from wording, and a deleted scenario's number is never handed out again.
entity StampedIdentity {
    slice_file: String
    identity: String
    sequence: Integer
}

-- A golden is written from one scenario's stated inputs and exact output, never recorded
-- from an implementation. It is instrument material and never enters a clean room.
entity InstrumentGolden {
    identity: String
    scenario_identity: String
    digest: String
    replaces: InstrumentGolden?
    replacement_reason: GraderReplacementReason?
}

entity Scoreboard {
    cycle: cycle/RegenerationCycle
    previous_cycle_identity: String?
    pass_rate: Decimal
    denominator: Integer
    shared_items: List<String>
    newly_passing: List<String>
    newly_failing: List<String>
    new_items: List<String>
    dropped_items: List<String>
}

-- The next free sequence is one past the highest item tag ever present in the file, so a
-- deleted scenario's number is never reused. A tag that is not an item tag does not stamp.
rule StampScenario {
    when: ScenarioFoundUnstamped(slice_file, scenario)
    requires: not scenario_has_item_tag(scenario)
    let sequence = highest_item_sequence_in_file(slice_file) + 1
    ensures: StampedIdentity.created(
        slice_file: slice_file,
        identity: item_identity(slice_file, sequence),
        sequence: sequence
    )
    ensures: ItemTagWritten(scenario: scenario, indentation: scenario_indentation(scenario))
}

rule WriteInstrumentGolden {
    when: InstrumentGoldenWritten(identity, scenario_identity, digest, replaces, replacement_reason)
    requires: scenario_fixes_exact_instrument_behaviour(scenario_identity)
    requires: written_from_scenario_not_captured(identity)
    requires: replaces = null or replacement_reason != null
    requires: replacement_reason = spec_grew implies only_adds_cases(replaces, identity)
    ensures: InstrumentGolden.created(
        identity: identity,
        scenario_identity: scenario_identity,
        digest: digest,
        replaces: replaces,
        replacement_reason: replacement_reason
    )
}

rule LeaveStampedSliceUnwritten {
    when: SliceStampRequested(slice_file)
    requires: every_scenario_has_stamped_identity(scenarios_in(slice_file))
    ensures: SliceLeftUnwritten(slice_file: slice_file)
}

-- The checklist is never written; a scenario nobody stamped stops the run.
rule DeriveChecklist {
    when: ChecklistRequested(selection_identity, scenarios)
    requires: scenarios.count > 0
    requires: every_scenario_has_stamped_identity(scenarios)
    ensures: Checklist.created(
        selection_identity: selection_identity,
        items: ordered_by_file_then_position(one_item_per_titled_scenario(scenarios))
    )
}

-- A grader is authored from the selected Gherkin and the public calibration protocol only.
rule SealCalibratedGrader {
    when: GraderCalibrated(orc, grader, carried_passed, uncarried_failed)
    requires: grader.status = calibrating
    requires: grader_author_read_only_spec_and_protocol(grader)
    requires: carried_passed
    requires: uncarried_failed
    ensures: grader.status = sealed
}

rule ReauthorUncalibratedGrader {
    when: GraderCalibrationFailed(orc, grader, failed_cases)
    requires: grader.status = calibrating
    requires: grader.attempt < 3
    requires: failed_cases_come_only_from_public_protocol(failed_cases)
    ensures: grader.status = discarded
    ensures: GraderAuthoringRequested(
        scenario_digests: grader.scenario_digests,
        attempt: grader.attempt + 1,
        failed_cases: failed_cases
    )
}

rule StopAfterThreeUncalibratedGraders {
    when: GraderCalibrationFailed(orc, grader, failed_cases)
    requires: grader.status = calibrating
    requires: grader.attempt = 3
    ensures: grader.status = discarded
    ensures: InstrumentUnavailable(scenario_digests: grader.scenario_digests)
}

-- Only an operator approves a grader, and only its exact digest.
rule ApproveExactGrader {
    when: ApproveGrader(operator, grader, supplied_digest)
    requires: grader.status = sealed
    requires: supplied_digest = grader.digest
    requires: grader.replaces = null or grader.replacement_reason != null
    requires: grader.replacement_reason = spec_grew implies
              only_adds_items(grader.replaces, grader)
    ensures: grader.status = approved
}

-- An approved grader is reused, re-calibrated before every score, and replaced only for
-- the items whose scenario digest changed.
rule ReuseApprovedGrader {
    when: GraderRequested(selection_identity, checklist)
    requires: exists approved_grader_covering(checklist)
    ensures: GraderRecalibrationRequested(grader: approved_grader_covering(checklist))
}

-- Score: the one rule that files a measurement. ORC runs the approved sealed grader as a
-- bounded step of the score stage and returns its verdicts; this rule, not ORC, files them.
rule FileScore {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: cycle.status = running
    requires: cycle.stage = score
    requires: grader.status = approved
    requires: grader.digest = cycle.preparation.grader_digest.value
    requires: verdicts.count > 0
    requires: every_verdict_names_a_checklist_item(verdicts, checklist)
    requires: every_verdict_is_pass_or_fail(verdicts)
    let items = one_score_per_checklist_item(checklist, verdicts)
    ensures: CycleMeasurement.created(
        cycle: cycle,
        grader_digest: grader.digest,
        total: checklist.items.count,
        passed: items.count(item => item.verdict = pass),
        failed: items.count(item => item.verdict = fail),
        complete: items.all(item => item.reached),
        items: items
    )
}

-- Zero verdicts mean no score was filed.
rule RefuseEmptyScore {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count = 0
    ensures: ScoreRefused(cycle: cycle, named_items: [])
}

-- Unknown items are checked first, so a return with both faults names only the unknown items.
rule RefuseUnknownVerdicts {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count > 0
    requires: not every_verdict_names_a_checklist_item(verdicts, checklist)
    ensures: ScoreRefused(
        cycle: cycle,
        named_items: unknown_items_in_return_order(verdicts, checklist)
    )
}

rule RefuseInvalidVerdicts {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count > 0
    requires: every_verdict_names_a_checklist_item(verdicts, checklist)
    requires: not every_verdict_is_pass_or_fail(verdicts)
    ensures: ScoreRefused(
        cycle: cycle,
        named_items: items_without_pass_or_fail(verdicts)
    )
}

-- Scoreboard: reported once a cycle reaches it, to a person; never back into the loop.
rule ReportFirstScoreboard {
    when: scored: cycle/RegenerationCycle.stage becomes scoreboard
    requires: not exists previous_measurement(scored)
    ensures: Scoreboard.created(
        cycle: scored,
        previous_cycle_identity: null,
        pass_rate: pass_rate(scored),
        denominator: denominator(scored),
        shared_items: [],
        newly_passing: [],
        newly_failing: [],
        new_items: [],
        dropped_items: []
    )
}

rule ReportComparedScoreboard {
    when: scored: cycle/RegenerationCycle.stage becomes scoreboard
    requires: exists previous_measurement(scored)
    ensures: Scoreboard.created(
        cycle: scored,
        previous_cycle_identity: previous_measurement(scored),
        pass_rate: pass_rate(scored),
        denominator: denominator(scored),
        shared_items: shared_items(scored),
        newly_passing: newly_passing(scored),
        newly_failing: newly_failing(scored),
        new_items: new_items(scored),
        dropped_items: dropped_items(scored)
    )
}

invariant ScoreUsesOnlyApprovedGraders {
    for measurement in CycleMeasurements:
        grader_status(measurement.grader_digest) = approved
}

invariant UnreachedItemsFail {
    for measurement in CycleMeasurements:
        measurement.items.all(item => item.reached or item.verdict = fail)
}

invariant OneMeasurementPerCycle {
    for measurement in CycleMeasurements:
        count(CycleMeasurements where cycle = measurement.cycle) = 1
}

invariant MeasurementDenominatorNeverShrinks {
    for measurement in CycleMeasurements:
        measurement.total = measurement.cycle.preparation.selection.items.count and
        measurement.passed + measurement.failed = measurement.total
}

invariant ScoreboardNeverNets {
    for board in Scoreboards:
        board.newly_passing and board.newly_failing are reported separately
}

invariant GraderAuthorIsCandidateBlind {
    for grader in Graders:
        grader_author_read_only_spec_and_protocol(grader)
}

surface Instrument {
    facing operator: cycle/Operator

    provides:
        ChecklistRequested(selection_identity, scenarios)
        ApproveGrader(operator, grader, supplied_digest)
        GraderRequested(selection_identity, checklist)
        SliceStampRequested(slice_file)
        InstrumentGoldenWritten(identity, scenario_identity, digest, replaces, replacement_reason)
        ScenarioFoundUnstamped(slice_file, scenario)

    @guarantee DerivedChecklist
        -- The denominator is one item per stamped scenario of the approved selection and never
        -- drifts for any reason other than the spec moving.

    @guarantee StableCalibratedGrader
        -- A grader is calibrated against carried and uncarried behavior, sealed by digest, and
        -- used only after an operator approves that exact digest. It changes only for a recorded
        -- reason, never to turn a failing score green.

    @guarantee StableItemIdentity
        -- An item identity is stamped once, on a tag line with the scenario's indentation, and
        -- never renumbered, re-derived, or reused. Stamping a stamped slice rewrites nothing.

    @guarantee HonestScore
        -- Zero verdicts mean no score was filed; an unreached item fails and stays counted. A
        -- verdict for an item not on the checklist, or one that is neither pass nor fail,
        -- stops the score and records nothing. A repeated verdict keeps the last; evidence
        -- is optional and empty when absent.

    @guarantee HonestScoreboard
        -- Cycles are compared on shared items, newly passing and newly failing separately,
        -- with new items counted as the untuned holdout. A net is never computed. A moved item
        -- set (added or dropped items) is stated only when it moved; a previous cycle sharing
        -- no item is still compared, over zero shared items.

    @guarantee SealedGraderIsTheOnlyJudge
        -- A checklist verdict comes only from an approved sealed grader. An ORC evaluation
        -- judge score, an LLM opinion, or a composite of scores is never a verdict, never part
        -- of a measurement, and never shown to a builder.

    @guarantee GoldensFromTheSpec
        -- The instrument's exact behaviour is held by goldens written from its scenarios, never
        -- recorded from an implementation, replaced only for a recorded reason, and fenced from
        -- every clean room.

    @guarantee FixedArithmetic
        -- A rate exactly on a half rounds to the even digit (1 of 16 is 6.2); a zero
        -- denominator reports no percentage.
}

-- The facts ORC reports from the grader runs it bounds: calibration outcomes and a score's
-- returned verdicts. Only ORC's runtime reports them; an operator approves a grader but can
-- never return a score.
surface GraderRuns {
    facing orc: cycle/OrcRuntime

    provides:
        GraderCalibrated(orc, grader, carried_passed, uncarried_failed)
        GraderCalibrationFailed(orc, grader, failed_cases)
        ScoreReturned(orc, cycle, grader, checklist, verdicts)

    @guarantee VerdictsComeOnlyFromTheSealedGrader
        -- A returned score is the approved sealed grader's output for the cycle's gated
        -- candidate; the builder and the operator cannot supply or amend it.
}
