-- allium: 3
-- instrument.allium
--
-- Scope: the instrument: a checklist derived from the spec, a grader written once by a grader
-- author, calibrated, sealed, and approved by digest, a score with an honest denominator, and
-- a scoreboard that compares cycles on shared items in both directions. It reports to a
-- person and never feeds the build loop.
-- Includes: stamping, checklist derivation, grader authoring, calibration, sealing, approval,
-- reuse and replacement, score filing into the one measurement aggregate (CycleMeasurement),
-- its refusals, and scoreboard comparison.
-- Excludes: the grader's own test logic, building candidates, the gate, the grader author's
-- builder session (execution-pipeline.allium BuilderSession), and ORC's evaluation judges
-- (ORC specs/evaluation.allium): their scores are diagnostic runtime evidence
-- (runtime-evidence.allium), never a verdict. ORC runs the sealed grader as a bounded step of
-- the score stage; the rules below, not ORC, file its verdicts.

use "./regeneration-cycle.allium" as cycle

-- A grader is calibrating once authored, sealed once calibrated, approved once an operator
-- approves its exact digest, and replaced when an approved successor names it. An
-- uncalibrated grader is discarded.
enum GraderStatus { calibrating | sealed | approved | replaced | discarded }
enum GraderReplacementReason { instrument_behavior_changed | wording_replaced | spec_grew }
-- A filed verdict has two values. Inconclusive evidence, like no evidence, files as fail with
-- the reason, so the item stays in the denominator.
enum ItemVerdict { pass | fail }

entity Grader {
    digest: String
    scenario_digests: List<String>
    author_session_identity: String
    attempt: Integer
    status: GraderStatus
    replaces: Grader?
    replacement_reason: GraderReplacementReason?

    transitions status {
        calibrating -> sealed
        calibrating -> discarded
        sealed -> approved
        approved -> replaced
        terminal: replaced, discarded
    }
}

-- One checklist item's filed verdict. An unreached item is filed as fail.
value ItemScore {
    item_identity: String
    verdict: ItemVerdict
    reached: Boolean
    evidence: String
}

-- The one measurement aggregate: the score of one cycle, filed once by FileScore from the
-- approved sealed grader's verdicts, one per checklist item. Its denominator is the cycle's
-- approved selection. Durable measurement receipts and evidence reports are projections of
-- it, never authorities.
entity CycleMeasurement {
    cycle: cycle/RegenerationCycle
    grader_digest: String
    total: Integer
    passed: Integer
    failed: Integer
    complete: Boolean
    items: List<ItemScore>
}

-- The checklist of an approved selection: one stamped item per stamped scenario, ordered by
-- file then position.
entity Checklist {
    selection: cycle/SliceSelection
    items: List<cycle/StampedItem>
}

-- An item identity, once stamped on a scenario, never moves: it is not renumbered, not
-- re-derived from wording, and a deleted scenario's number is never handed out again.
entity StampedIdentity {
    slice_file: String
    identity: String
    sequence: Integer
}

-- A golden is written from one scenario's stated inputs and exact output, never recorded
-- from a run. It is instrument material and never enters a clean room.
entity InstrumentGolden {
    identity: String
    scenario_identity: String
    digest: String
    replaces: InstrumentGolden?
    replacement_reason: GraderReplacementReason?
}

entity Scoreboard {
    cycle: cycle/RegenerationCycle
    previous_cycle_identity: String?
    pass_rate: Decimal
    denominator: Integer
    shared_items: List<String>
    newly_passing: List<String>
    newly_failing: List<String>
    new_items: List<String>
    dropped_items: List<String>
}

------------------------------------------------------------
-- Contracts: what the instrument's rules read
------------------------------------------------------------

-- The stamper's reading of a slice file.
contract ItemStamping {
    scenario_has_item_tag: (scenario: String) -> Boolean
    -- One past the highest item tag ever present in the file, so a deleted scenario's
    -- number is never reused.
    highest_item_sequence_in_file: (slice_file: String) -> Integer
    item_identity: (slice_file: String, sequence: Integer) -> String
    scenario_indentation: (scenario: String) -> String
    scenarios_in: (slice_file: String) -> List<String>
    every_scenario_has_stamped_identity: (scenarios: List<String>) -> Boolean
}

-- How a checklist is derived and a golden is written.
contract ChecklistDerivation {
    -- One stamped item per scenario with a title; a scenario whose title is empty is no item.
    one_item_per_titled_scenario: (scenarios: List<String>) -> List<cycle/StampedItem>
    ordered_by_file_then_position: (items: List<cycle/StampedItem>) -> List<cycle/StampedItem>
    -- The scenario states exact inputs and an exact output, refusal reasons included.
    scenario_fixes_exact_instrument_behaviour: (scenario_identity: String) -> Boolean
    -- The golden's output was written from the scenario, not captured from a run.
    written_from_scenario_not_captured: (identity: String) -> Boolean
    -- A spec-grew replacement only adds cases (goldens) or items (graders).
    only_adds_cases: (previous: InstrumentGolden, identity: String) -> Boolean
    only_adds_items: (previous: Grader, successor: Grader) -> Boolean
}

-- How a grader is authored, calibrated, and reused.
contract GraderAuthoring {
    -- The grader author's session read only the selected Gherkin and the public calibration
    -- protocol.
    grader_author_read_only_spec_and_protocol: (author_session_identity: String) -> Boolean
    failed_cases_come_only_from_public_protocol: (failed_cases: List<String>) -> Boolean
    -- The approved grader whose scenario digests cover every item of the checklist, if any.
    approved_grader_covering: (checklist: Checklist) -> Grader?
    checklist_scenario_digests: (checklist: Checklist) -> List<String>

    @invariant CandidateBlindAuthor
        -- A grader author reads no candidate, transcript, prior verdict, or host credential;
        -- its grader is a function of the selected Gherkin and the public calibration
        -- protocol alone.
}

-- How returned verdicts are checked and filed.
contract ScoreFiling {
    every_verdict_names_a_checklist_item: (verdicts: List<String>, checklist: Checklist) -> Boolean
    every_verdict_is_pass_or_fail: (verdicts: List<String>) -> Boolean
    -- One item score per checklist item, in checklist order: a repeated verdict keeps the
    -- last, evidence is empty when absent, and an item with no verdict is unreached and fails.
    one_score_per_checklist_item: (checklist: Checklist, verdicts: List<String>) -> List<ItemScore>
    unknown_items_in_return_order: (verdicts: List<String>, checklist: Checklist) -> List<String>
    items_without_pass_or_fail: (verdicts: List<String>) -> List<String>
}

-- The scoreboard's arithmetic over the cycle's measurement and the previous measurement of
-- the same selection. A rate exactly on a half rounds to the even digit; a zero denominator
-- reports no percentage.
contract ScoreboardArithmetic {
    previous_measurement: (scored: cycle/RegenerationCycle) -> String?
    pass_rate: (scored: cycle/RegenerationCycle) -> Decimal
    denominator: (scored: cycle/RegenerationCycle) -> Integer
    shared_items: (scored: cycle/RegenerationCycle) -> List<String>
    newly_passing: (scored: cycle/RegenerationCycle) -> List<String>
    newly_failing: (scored: cycle/RegenerationCycle) -> List<String>
    new_items: (scored: cycle/RegenerationCycle) -> List<String>
    dropped_items: (scored: cycle/RegenerationCycle) -> List<String>
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- The next free sequence is one past the highest item tag ever present in the file, so a
-- deleted scenario's number is never reused. A tag that is not an item tag does not stamp.
rule StampScenario {
    when: StampSliceScenario(operator, slice_file, scenario)
    requires: not scenario_has_item_tag(scenario)
    let sequence = highest_item_sequence_in_file(slice_file) + 1
    ensures: StampedIdentity.created(
        slice_file: slice_file,
        identity: item_identity(slice_file, sequence),
        sequence: sequence
    )
    ensures: ItemTagWritten(scenario: scenario, indentation: scenario_indentation(scenario))
}

rule WriteInstrumentGolden {
    when: RecordInstrumentGolden(operator, identity, scenario_identity, digest, replaces, replacement_reason)
    requires: scenario_fixes_exact_instrument_behaviour(scenario_identity)
    requires: written_from_scenario_not_captured(identity)
    requires: replaces = null or replacement_reason != null
    requires: replacement_reason = spec_grew implies only_adds_cases(replaces, identity)
    ensures: InstrumentGolden.created(
        identity: identity,
        scenario_identity: scenario_identity,
        digest: digest,
        replaces: replaces,
        replacement_reason: replacement_reason
    )
}

rule LeaveStampedSliceUnwritten {
    when: StampSlice(operator, slice_file)
    requires: every_scenario_has_stamped_identity(scenarios_in(slice_file))
    ensures: SliceLeftUnwritten(slice_file: slice_file)
}

-- The checklist is never written; a scenario nobody stamped stops the run.
rule DeriveChecklist {
    when: DeriveSelectionChecklist(operator, selection, scenarios)
    requires: scenarios.count > 0
    requires: every_scenario_has_stamped_identity(scenarios)
    requires: selection.status = approved
    ensures: Checklist.created(
        selection: selection,
        items: ordered_by_file_then_position(one_item_per_titled_scenario(scenarios))
    )
}

-- A checklist no approved grader covers asks ORC for a grader author: a fresh builder
-- session in a grader-author room (execution-pipeline.allium).
rule RequestGraderAuthoring {
    when: RequestGrader(operator, checklist)
    requires: not exists approved_grader_covering(checklist)
    ensures: GraderAuthoringRequested(
        scenario_digests: checklist_scenario_digests(checklist),
        attempt: 1,
        failed_cases: []
    )
}

-- An approved grader is reused, re-calibrated before every score, and replaced only for
-- the items whose scenario digest changed.
rule ReuseApprovedGrader {
    when: RequestGrader(operator, checklist)
    requires: exists approved_grader_covering(checklist)
    ensures: GraderRecalibrationRequested(grader: approved_grader_covering(checklist))
}

-- A grader author's session produced a grader. It is calibrating until its calibration is
-- reported. A replacement names the grader it replaces and its recorded reason.
rule AuthorGrader {
    when: GraderAuthored(orc, grader_digest, scenario_digests, author_session_identity, attempt, replaces, replacement_reason)
    requires: not exists Grader{digest: grader_digest}
    requires: attempt >= 1
    requires: attempt <= 3
    requires: replaces = null or replacement_reason != null
    ensures: Grader.created(
        digest: grader_digest,
        scenario_digests: scenario_digests,
        author_session_identity: author_session_identity,
        attempt: attempt,
        status: calibrating,
        replaces: replaces,
        replacement_reason: replacement_reason
    )
}

-- A grader is sealed only when carried behavior passed and uncarried behavior failed, and
-- only when its author read the selected Gherkin and the public calibration protocol alone.
rule SealCalibratedGrader {
    when: GraderCalibrated(orc, grader, carried_passed, uncarried_failed)
    requires: grader.status = calibrating
    requires: grader_author_read_only_spec_and_protocol(grader.author_session_identity)
    requires: carried_passed
    requires: uncarried_failed
    ensures: grader.status = sealed
}

rule ReauthorUncalibratedGrader {
    when: GraderCalibrationFailed(orc, grader, failed_cases)
    requires: grader.status = calibrating
    requires: grader.attempt < 3
    requires: failed_cases_come_only_from_public_protocol(failed_cases)
    ensures: grader.status = discarded
    ensures: GraderAuthoringRequested(
        scenario_digests: grader.scenario_digests,
        attempt: grader.attempt + 1,
        failed_cases: failed_cases
    )
}

rule StopAfterThreeUncalibratedGraders {
    when: GraderCalibrationFailed(orc, grader, failed_cases)
    requires: grader.status = calibrating
    requires: grader.attempt = 3
    ensures: grader.status = discarded
    ensures: InstrumentDeclaredUnavailable(scenario_digests: grader.scenario_digests)
}

-- Only an operator approves a grader, and only its exact digest.
rule ApproveExactGrader {
    when: ApproveGrader(operator, grader, supplied_digest)
    requires: grader.status = sealed
    requires: supplied_digest = grader.digest
    requires: grader.replaces = null or grader.replacement_reason != null
    requires: grader.replacement_reason = spec_grew implies
              only_adds_items(grader.replaces, grader)
    ensures: grader.status = approved
}

-- Approving a replacement retires the grader it replaces: never to turn a failing score
-- green, only for its recorded reason.
rule RetireReplacedGrader {
    when: successor: Grader.status becomes approved
    requires: successor.replaces != null
    requires: successor.replaces.status = approved
    ensures: successor.replaces.status = replaced
}

-- Score: the one rule that files a measurement. ORC runs the approved sealed grader as a
-- bounded step of the score stage and returns its verdicts; this rule, not ORC, files them.
rule FileScore {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: cycle.status = running
    requires: cycle.stage = score
    requires: grader.status = approved
    requires: grader.digest = cycle.preparation.grader_digest
    requires: verdicts.count > 0
    requires: every_verdict_names_a_checklist_item(verdicts, checklist)
    requires: every_verdict_is_pass_or_fail(verdicts)
    let items = one_score_per_checklist_item(checklist, verdicts)
    ensures: CycleMeasurement.created(
        cycle: cycle,
        grader_digest: grader.digest,
        total: checklist.items.count,
        passed: items.count(item => item.verdict = pass),
        failed: items.count(item => item.verdict = fail),
        complete: items.all(item => item.reached),
        items: items
    )
}

-- Zero verdicts mean no score was filed.
rule RefuseEmptyScore {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count = 0
    ensures: ScoreRefused(cycle: cycle, named_items: [])
}

-- Unknown items are checked first, so a return with both faults names only the unknown items.
rule RefuseUnknownVerdicts {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count > 0
    requires: not every_verdict_names_a_checklist_item(verdicts, checklist)
    ensures: ScoreRefused(
        cycle: cycle,
        named_items: unknown_items_in_return_order(verdicts, checklist)
    )
}

rule RefuseInvalidVerdicts {
    when: ScoreReturned(orc, cycle, grader, checklist, verdicts)
    requires: verdicts.count > 0
    requires: every_verdict_names_a_checklist_item(verdicts, checklist)
    requires: not every_verdict_is_pass_or_fail(verdicts)
    ensures: ScoreRefused(
        cycle: cycle,
        named_items: items_without_pass_or_fail(verdicts)
    )
}

-- Scoreboard: reported once a cycle reaches it, to a person; never back into the loop.
rule ReportFirstScoreboard {
    when: scored: cycle/RegenerationCycle.stage becomes scoreboard
    requires: not exists previous_measurement(scored)
    ensures: Scoreboard.created(
        cycle: scored,
        previous_cycle_identity: null,
        pass_rate: pass_rate(scored),
        denominator: denominator(scored),
        shared_items: [],
        newly_passing: [],
        newly_failing: [],
        new_items: [],
        dropped_items: []
    )
}

rule ReportComparedScoreboard {
    when: scored: cycle/RegenerationCycle.stage becomes scoreboard
    requires: exists previous_measurement(scored)
    ensures: Scoreboard.created(
        cycle: scored,
        previous_cycle_identity: previous_measurement(scored),
        pass_rate: pass_rate(scored),
        denominator: denominator(scored),
        shared_items: shared_items(scored),
        newly_passing: newly_passing(scored),
        newly_failing: newly_failing(scored),
        new_items: new_items(scored),
        dropped_items: dropped_items(scored)
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- A measurement's grader was approved when it filed; a later replacement does not unfile it.
invariant ScoreUsesOnlyApprovedGraders {
    for measurement in CycleMeasurements:
        exists Graders where digest = measurement.grader_digest and
            (status = approved or status = replaced)
}

invariant UnreachedItemsFail {
    for measurement in CycleMeasurements:
        measurement.items.all(item => item.reached or item.verdict = fail)
}

invariant OneMeasurementPerCycle {
    for measurement in CycleMeasurements:
        count(CycleMeasurements where cycle = measurement.cycle) = 1
}

invariant MeasurementDenominatorNeverShrinks {
    for measurement in CycleMeasurements:
        measurement.total = measurement.cycle.preparation.selection.items.count and
        measurement.passed + measurement.failed = measurement.total
}

-- The two directions are restated on shared items only, and never overlap: an item is newly
-- passing or newly failing, never both, so nothing can be netted.
invariant ScoreboardComparesSharedItemsOnly {
    for board in Scoreboards:
        board.newly_passing.all(item => item in board.shared_items) and
        board.newly_failing.all(item => item in board.shared_items) and
        board.newly_passing.all(item => not (item in board.newly_failing))
}

-- A grader replaces another only for a recorded reason.
invariant ReplacementNamesItsReason {
    for grader in Graders:
        grader.replaces != null implies grader.replacement_reason != null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface Instrument {
    facing operator: cycle/Operator

    provides:
        DeriveSelectionChecklist(operator, selection, scenarios)
        RequestGrader(operator, checklist)
        ApproveGrader(operator, grader, supplied_digest)
        StampSlice(operator, slice_file)
        StampSliceScenario(operator, slice_file, scenario)
        RecordInstrumentGolden(operator, identity, scenario_identity, digest, replaces, replacement_reason)

    contracts:
        demands ItemStamping
        demands ChecklistDerivation
        demands ScoreboardArithmetic

    @guarantee DerivedChecklist
        -- The denominator is one item per stamped scenario of the approved selection and never
        -- drifts for any reason other than the spec moving.

    @guarantee StableCalibratedGrader
        -- A grader is calibrated against carried and uncarried behavior, sealed by digest, and
        -- used only after an operator approves that exact digest. It changes only for a recorded
        -- reason, never to turn a failing score green.

    @guarantee StableItemIdentity
        -- An item identity is stamped once, on a tag line with the scenario's indentation, and
        -- never renumbered, re-derived, or reused. Stamping a stamped slice rewrites nothing.

    @guarantee HonestScore
        -- Zero verdicts mean no score was filed; an unreached item fails and stays counted. A
        -- verdict for an item not on the checklist, or one that is neither pass nor fail,
        -- stops the score and records nothing. A repeated verdict keeps the last; evidence
        -- is optional and empty when absent.

    @guarantee HonestScoreboard
        -- Cycles are compared on shared items, newly passing and newly failing separately,
        -- with new items counted as the untuned holdout. A net is never computed. A moved item
        -- set (added or dropped items) is stated only when it moved; a previous cycle sharing
        -- no item is still compared, over zero shared items.

    @guarantee SealedGraderIsTheOnlyJudge
        -- A checklist verdict comes only from an approved sealed grader. An ORC evaluation
        -- judge score, an LLM opinion, or a composite of scores is never a verdict, never part
        -- of a measurement, and never shown to a builder.

    @guarantee GoldensFromTheSpec
        -- The instrument's exact behaviour is held by goldens written from its scenarios, never
        -- recorded from a run, replaced only for a recorded reason, and fenced from every
        -- clean room.

    @guarantee FixedArithmetic
        -- A rate exactly on a half rounds to the even digit (1 of 16 is 6.2); a zero
        -- denominator reports no percentage.
}

-- The facts ORC reports from the grader runs it bounds: an authored grader, calibration
-- outcomes, and a score's returned verdicts. Only ORC's runtime reports them; an operator
-- approves a grader but can never author one or return a score.
surface GraderRuns {
    facing orc: cycle/OrcRuntime

    provides:
        GraderAuthored(orc, grader_digest, scenario_digests, author_session_identity, attempt, replaces, replacement_reason)
        GraderCalibrated(orc, grader, carried_passed, uncarried_failed)
        GraderCalibrationFailed(orc, grader, failed_cases)
        ScoreReturned(orc, cycle, grader, checklist, verdicts)

    contracts:
        demands GraderAuthoring
        demands ScoreFiling

    @guarantee VerdictsComeOnlyFromTheSealedGrader
        -- A returned score is the approved sealed grader's output for the cycle's gated
        -- candidate; the builder and the operator cannot supply or amend it.
}
