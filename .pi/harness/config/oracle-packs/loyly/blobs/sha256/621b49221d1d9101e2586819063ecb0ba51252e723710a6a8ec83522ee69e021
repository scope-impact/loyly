#!/usr/bin/env python3
"""Independent HTTP measurements for the accepted booking-core behavior."""

import concurrent.futures
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = sys.argv[1].rstrip("/")
REQUESTED = sys.argv[2:]


def call(method, path, body=None):
    data = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(
        BASE + path, data=data, method=method,
        headers={"content-type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            raw = response.read().decode()
            return response.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        raw = error.read().decode()
        try:
            value = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            value = {"raw": raw}
        return error.code, value


def configure(room, weekdays, starts, sauna="F"):
    return call("PUT", "/api/rooms/" + urllib.parse.quote(room, safe="") + "/days",
                {"sauna": sauna, "weekdays": weekdays, "slots": starts})


def request(household, room, weekday, start):
    return call("POST", "/api/standing-slots",
                {"household": household, "dressing-room": room,
                 "weekday": weekday, "start": start})


def release(household, room, weekday, start):
    return call("POST", "/api/standing-slots/give-up",
                {"household": household, "dressing-room": room,
                 "weekday": weekday, "start": start})


def text(value):
    return json.dumps(value, separators=(",", ":"), sort_keys=True).lower()


def count_value(value, key, expected):
    if isinstance(value, dict):
        return (1 if value.get(key) == expected else 0) + sum(
            count_value(child, key, expected) for child in value.values())
    if isinstance(value, list):
        return sum(count_value(child, key, expected) for child in value)
    return 0


def values_for_key(value, key):
    found = []
    if isinstance(value, dict):
        if key in value:
            found.append(value[key])
        for child in value.values():
            found.extend(values_for_key(child, key))
    elif isinstance(value, list):
        for child in value:
            found.extend(values_for_key(child, key))
    return found


def expect(condition, evidence):
    if not condition:
        raise AssertionError(evidence)


def grade_001():
    expect(configure("pukuhuone 9", ["thursday", "friday", "saturday"], ["17:00"])[0] < 300,
           "could not configure pukuhuone 9")
    expect(configure("pukuhuone 8", ["tuesday"], ["17:00", "18:30"])[0] < 300,
           "could not configure pukuhuone 8")
    status, schedule = call("GET", "/api/schedule?sauna=F")
    shown = text(schedule)
    expect(status == 200 and "pukuhuone 8" in shown and "tuesday" in shown,
           "Tuesday did not show slots for pukuhuone 8")
    room9_tuesday = any(
        (node.get("dressing-room") == "pukuhuone 9" or
         node.get("dressingRoom") == "pukuhuone 9" or node.get("name") == "pukuhuone 9")
        and "tuesday" in text(node)
        for node in walk(schedule) if isinstance(node, dict))
    expect(not room9_tuesday, "Tuesday incorrectly showed slots for pukuhuone 9")
    return "weekly schedule kept each dressing room's sauna days separate"


def walk(value):
    yield value
    if isinstance(value, dict):
        for child in value.values():
            yield from walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from walk(child)


def grade_002():
    configure("pukuhuone 9", ["thursday", "friday", "saturday"], ["17:00"])
    status, refusal = request("12", "pukuhuone 9", "tuesday", "17:00")
    shown = text(refusal)
    expect(status >= 400, "closed-day request was accepted")
    expect("pukuhuone 9" in shown and "tuesday" in shown,
           "closed-day refusal did not name the room and refused day")
    expect(all(day in shown for day in ("thursday", "friday", "saturday")),
           "closed-day refusal did not name all open days")
    return "closed-day request was refused with the dressing room's open days"


def grade_003():
    configure("pukuhuone 8", ["tuesday"], ["17:00", "18:30"])
    status, confirmation = request("12", "pukuhuone 8", "tuesday", "17:00")
    shown = text(confirmation)
    expect(status in (200, 201), "open standing slot was not confirmed")
    expect('"household":"12"' in shown and '"end":"18:30"' in shown,
           "confirmation did not preserve household and 90-minute end")
    return "open Tuesday slot was confirmed for apartment 12 from 17:00 to 18:30"


def grade_004():
    configure("pukuhuone 8", ["tuesday"], ["17:00", "18:30"])
    first, _ = request("12", "pukuhuone 8", "tuesday", "17:00")
    expect(first in (200, 201, 409), "held-slot setup failed")
    status, refusal = request("3", "pukuhuone 8", "tuesday", "17:00")
    expect(status >= 400 and ("held" in text(refusal) or "another household" in text(refusal)),
           "second household was not refused because the slot was held")
    _, schedule = call("GET", "/api/schedule?sauna=F")
    shown = text(schedule)
    expect('"household":"12"' in shown and '"household":"3"' not in shown,
           "the original household was not the sole remaining holder")
    return "held slot refused apartment 3 and remained held by apartment 12"


def grade_005():
    configure("pukuhuone 8", ["wednesday"], ["17:00", "18:30"])
    first, _ = request("12", "pukuhuone 8", "wednesday", "17:00")
    second, _ = request("12", "pukuhuone 8", "wednesday", "18:30")
    expect(first in (200, 201) and second in (200, 201),
           "second standing slot was refused while a free slot remained")
    _, billing = call("GET", "/api/billing-signals?household=12")
    expect(count_value(billing, "household", "12") >= 2,
           "apartment 12 did not hold two independently visible standing slots")
    return "apartment 12 received a second standing slot while room remained"


def grade_006():
    configure("pukuhuone 9", ["thursday"], ["20:00"])
    first, _ = request("12", "pukuhuone 9", "thursday", "20:00")
    second, refusal = request("12", "pukuhuone 9", "thursday", "20:00")
    expect(first in (200, 201) and second >= 400,
           "a full one-slot schedule granted a second standing slot")
    _, schedule = call("GET", "/api/schedule?sauna=F")
    expect(count_value(schedule, "household", "12") >= 1 and
           '"household":"3"' not in text(schedule),
           "full-schedule refusal did not retain exactly the original holder")
    return "full schedule refused a second slot and retained the original holding"


def grade_007():
    configure("pukuhuone 8", ["friday"], ["17:00"])
    status, confirmation = request("12", "pukuhuone 8", "friday", "17:00")
    expect(status in (200, 201), "standing-slot request failed")
    _, schedule = call("GET", "/api/schedule?sauna=F")
    _, heater = call("GET", "/api/heater-schedule?sauna=F")
    _, billing = call("GET", "/api/billing-signals?household=12")
    expect('"household":"12"' in text(schedule) and '"start":"17:00"' in text(schedule),
           "posted schedule did not show apartment 12")
    expect('"start":"17:00"' in text(heater) and '"end":"18:30"' in text(heater),
           "heater schedule did not show the complete heating period")
    signal_lists = [value for value in values_for_key(billing, "signals") if isinstance(value, list)]
    expect(any(value and '"household":"12"' in text(value) for value in signal_lists),
           "billing signal did not name apartment 12")
    return "booking, posted schedule, heater schedule, and billing signal agree"


def grade_008():
    configure("pukuhuone 8", ["saturday"], ["17:00"])
    expect(request("12", "pukuhuone 8", "saturday", "17:00")[0] in (200, 201),
           "release setup request failed")
    expect(release("12", "pukuhuone 8", "saturday", "17:00")[0] < 300,
           "give-up request failed")
    _, schedule = call("GET", "/api/schedule?sauna=F")
    _, heater = call("GET", "/api/heater-schedule?sauna=F")
    _, billing = call("GET", "/api/billing-signals?household=12")
    schedule_claims = count_value(schedule, "household", "12") > 0
    heater_claims = '"weekday":"saturday"' in text(heater) and '"start":"17:00"' in text(heater)
    signal_lists = [value for value in values_for_key(billing, "signals") if isinstance(value, list)]
    billing_claims = any(value for value in signal_lists)
    expect(not schedule_claims and not heater_claims and not billing_claims,
           "a derived view still claimed the released Saturday slot")
    return "released booking disappeared from posted schedule, heater schedule, and billing signals"


def race_once():
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
        futures = [pool.submit(request, household, "pukuhuone 8", "sunday", "17:00")
                   for household in ("12", "3")]
        results = [future.result() for future in futures]
    winners = [household for household, result in zip(("12", "3"), results)
               if result[0] in (200, 201)]
    return results, winners


def clear_race_slot():
    for household in ("12", "3"):
        release(household, "pukuhuone 8", "sunday", "17:00")


def grade_009():
    configure("pukuhuone 8", ["sunday"], ["17:00"])
    clear_race_slot()
    results, winners = race_once()
    expect(len(winners) == 1 and sum(result[0] >= 400 for result in results) == 1,
           "concurrent requests did not produce exactly one confirmation and one refusal")
    _, schedule = call("GET", "/api/schedule?sauna=F")
    expect(count_value(schedule, "household", winners[0]) >= 1,
           "derived schedule did not retain the sole race winner")
    clear_race_slot()
    return "concurrent requests produced exactly one holder and one held-slot refusal"


def grade_010():
    configure("pukuhuone 8", ["sunday"], ["17:00"])
    clear_race_slot()
    for run in range(1, 101):
        results, winners = race_once()
        expect(len(winners) == 1 and sum(result[0] >= 400 for result in results) == 1,
               f"race run {run} did not produce exactly one confirmation")
        clear_race_slot()
    return "all 100 races confirmed exactly one household and never both or neither"


def grade_011():
    configure("pukuhuone 9", ["thursday", "friday", "saturday"], ["17:00"])
    status, refusal = request("12", "pukuhuone 9", "tuesday", "17:00")
    shown = text(refusal)
    expect(status >= 400, "closed-day request was accepted")
    expect(any(day in shown for day in ("thursday", "friday", "saturday")) and
           re.search(r"[0-2][0-9]:[0-5][0-9]", shown),
           "refusal did not contain enough day-and-time information to form an accepted request")
    return "closed-day refusal alone identified an actionable alternative day and time"


GRADERS = {f"01-{number:03d}": globals()[f"grade_{number:03d}"] for number in range(1, 12)}


def main():
    requested = list(GRADERS) if REQUESTED == ["all"] else REQUESTED
    verdicts = []
    any_failure = False
    for item in requested:
        try:
            evidence = GRADERS[item]()
            verdicts.append({"itemId": item, "verdict": "pass", "evidence": evidence})
        except Exception as error:
            any_failure = True
            verdicts.append({"itemId": item, "verdict": "fail", "evidence": str(error)})
    print(json.dumps(verdicts, separators=(",", ":")))
    return 1 if any_failure else 0


if __name__ == "__main__":
    raise SystemExit(main())
