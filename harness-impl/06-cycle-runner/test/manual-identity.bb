(require '[babashka.process :as p] '[cheshire.core :as json] '[clojure.java.io :as io] '[clojure.string :as str])
(def root (str (.getCanonicalPath (io/file ".")) "/target/manual-" (random-uuid)))
(defn put! [path text] (io/make-parents path) (spit path text) path)
(defn sh! [path body] (put! path (str "#!/bin/sh\nset -eu\n" body "\n")) (.setExecutable (io/file path) true false) path)
(def repo (str root "/repo"))
(.mkdirs (io/file repo))
(defn git [& args] (let [r @(p/process (into ["git" "-c" "safe.directory=*" "-C" repo] args) {:out :string :err :string})] (when-not (zero? (:exit r)) (throw (ex-info (:err r) r))) (str/trim (:out r))))
(put! (str repo "/plan/01-a/spec.feature") "Feature: Identity\n  @item-01-001\n  Scenario: First\n    Given a repository\n  @item-01-002\n  Scenario: Second\n    Given another\n")
(put! (str repo "/impl/old.txt") "old candidate")
(git "init") (git "add" ".") (git "-c" "user.name=Fixture" "-c" "user.email=fixture@localhost" "commit" "-m" "Identity cut")
(def commit (git "rev-parse" "HEAD"))
(def config (put! (str root "/config.sh") "APP_DIR=impl\nPLAN_DIR=plan\nFENCED_PATHS=impl\nAPP_SEAM=stdio\nAPP_PROBE=probe.sh\n"))
(def exit (sh! (str root "/exit.sh") "exit 0"))
(def peer (sh! (str root "/peer.sh") "while IFS= read -r line; do\n  case \"$line\" in *stamp-slice*) exit 0;; esac\n  id=$(printf '%s' \"$line\" | cut -d '\"' -f 8)\n  result=null\n  case \"$line\" in *stamped-items*) result='{\"slices\":[]}' ;; *source-cuts*) result='{\"cuts\":[]}' ;; *instrument-goldens*) result='{\"goldens\":[]}' ;; esac\n  printf '{\"jsonrpc\":\"2.0\",\"id\":\"%s\",\"result\":%s}\\n' \"$id\" \"$result\"\ndone"))
(def names ["specification" "cycle-preparation" "grader-lifecycle" "regeneration-cycle" "measurement"])
(def contexts (str root "/contexts.json"))
(put! contexts (json/generate-string (zipmap names (repeat exit))))
(def self (sh! (str root "/self.sh") (str "touch '" root "/self-launched'")))
(def builder (sh! (str root "/builder.sh") (str "touch '" root "/builder-launched'")))
(def instruction (put! (str root "/instruction.md") "Build the fixture."))
(def store (str root "/events.sqlite"))
(def proc (p/process ["./start.sh"] {:in :pipe :out :pipe :err (str root "/stderr.log")
                                    :extra-env {"LOYLY_GRAIN_STORE" store "LOYLY_PROJECT_REPO" repo "LOYLY_HARNESS_CONFIG" config
                                                "LOYLY_CONTEXTS" contexts "LOYLY_RUNS_DIR" (str root "/runs") "LOYLY_SELF_CHECK_CMD" self
                                                "LOYLY_BUILDER_CMD" builder "LOYLY_BUILDER_INSTRUCTION" instruction}}))
(def input (io/writer (:in proc)))
(def output (io/reader (:out proc)))
(def budget {:gate-attempt-limit 3 :max-outer-cycles 1 :max-continuations 0 :stage-timeouts-seconds {:fence 30 :regenerate 30 :gate 30 :score 30}})
(def params {:run-id "R-1" :cycle-id "C-1" :cut-id "K-1" :commit commit :selection-id "S" :budget budget :grader-digests ["r-1"]})
(defn rpc! [id method params]
  (let [request {:jsonrpc "2.0" :id id :method (str "cycle-runner/" method) :params params}]
    (println "REQUEST" (json/generate-string request))
    (.write input (str (json/generate-string request) "\n")) (.flush input)
    (let [line (.readLine output)] (println "RESPONSE" line) (json/parse-string line true))))
(try
  (assert (= "not-a-commit" (get-in (rpc! 1 "start-run" (assoc params :commit "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef")) [:error :data :refusal])))
  (let [r (rpc! 2 "start-run" params)] (assert (= "contexts-not-responding" (get-in r [:error :data :refusal]))) (assert (= (set names) (set (get-in r [:error :data :contexts])))))
  (put! contexts (json/generate-string (zipmap names (repeat peer))))
  (assert (nil? (:error (rpc! 3 "start-run" params))))
  (let [r (get-in (rpc! 4 "run-progress" {:run-id "R-1"}) [:result :run])]
    (assert (= "halted" (:status r)))
    (assert (= {:effect "stamp" :reason "context-did-not-respond"} (select-keys (:halt r) [:effect :reason])))
    (assert (empty? (:effect-results r))))
  (assert (not (.exists (io/file root "self-launched"))))
  (assert (not (.exists (io/file root "builder-launched"))))
  (println "CONFIRMED: stamp halted without an effect result; self-check and builder were never launched.")
  (finally (.close input) @proc))
(put! "target/manual-store-path.txt" store)
(println "STORE" store)
