{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}

        ;; Grain, one project per coordinate, at the pinned commit.
        obneyai/grain-core-v2 {:git/url "https://github.com/ObneyAI/grain.git"
                               :git/sha "dbf5b5229aad09785e40f71e96adf65c90f971d5"
                               :deps/root "projects/grain-core-v2"}
        obneyai/grain-event-store-sqlite-v3 {:git/url "https://github.com/ObneyAI/grain.git"
                                             :git/sha "dbf5b5229aad09785e40f71e96adf65c90f971d5"
                                             :deps/root "projects/grain-event-store-sqlite-v3"}
        obneyai/grain-code-agent-tools {:git/url "https://github.com/ObneyAI/grain.git"
                                        :git/sha "dbf5b5229aad09785e40f71e96adf65c90f971d5"
                                        :deps/root "projects/grain-code-agent-tools"}

        ;; ORC, the workflow engine (Layer 0: orc-service).
        obneyai/orc-service {:git/url "https://github.com/ObneyAI/orc.git"
                         :git/sha "af086675be0e8a3fae0ebda503abe9942c9437ce"
                         :deps/root "projects/orc-service"}}

 :aliases
 {:aot {:extra-paths ["target/classes"]}
  :run {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "-Dclojure.main.report=stderr"]
        :main-opts ["-m" "loyly.cycle-preparation.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                    "--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}}}
